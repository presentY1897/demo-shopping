{
  "name": "shopping",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "prepare": "husky",
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm run lint:root && pnpm -r --if-present lint",
    "lint:fix": "eslint . --fix --max-warnings 0 && pnpm -r --if-present lint:fix",
    "lint:root": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @shopping/api db:generate",
    "db:migrate": "pnpm --filter @shopping/api db:migrate",
    "db:deploy": "pnpm --filter @shopping/api db:deploy",
    "db:reset": "pnpm --filter @shopping/api db:reset",
    "db:status": "pnpm --filter @shopping/api db:status",
    "db:seed": "pnpm --filter @shopping/api db:seed",
    "db:seed:verify": "pnpm --filter @shopping/api db:seed:verify",
    "db:studio": "pnpm --filter @shopping/api db:studio",
    "storybook": "pnpm --filter @shopping/ui storybook",
    "storybook:build": "pnpm --filter @shopping/ui build-storybook",
    "ports": "node scripts/ports.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:ps": "node scripts/infra.mjs ps"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@shopping/config": "workspace:*",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
