# Template for the local `.env`. Copy it once per worktree:
#
#   cp .env.example .env
#
# Nothing needs editing afterwards. Every port bearing value is derived at boot
# from this worktree's `PORT_OFFSET` (`scripts/ports.mjs` is the single source of
# truth for ports), so the commented lines below are overrides, not blanks to
# fill in — uncomment one only to point at something that is not the local stack.
#
# `.env` is git-ignored and must never hold a real secret — this template is the
# only env file that is committed.
#
# Loading order, lowest priority first (see README "환경변수"):
#
#   1. .env         local defaults shared by every app and by docker compose
#   2. .env.local   worktree-specific overrides: PORT_OFFSET, COMPOSE_PROJECT_NAME
#   3. shell        `PORT_OFFSET=40 pnpm infra:up` beats both files

# --- Worktree identity -------------------------------------------------------
# These two belong in `.env.local`, not here, because they differ per worktree.
# PORT_OFFSET=0
# COMPOSE_PROJECT_NAME=shopping

# --- Runtime -----------------------------------------------------------------
# development | test | production. Only `development` may put a stack trace in
# an error response.
NODE_ENV=development
# error | warn | log | debug | verbose
LOG_LEVEL=log

# --- PostgreSQL --------------------------------------------------------------
# Used by docker compose to initialise the container, and by the API to build
# DATABASE_URL when that is not set explicitly.
POSTGRES_USER=shopping
POSTGRES_PASSWORD=shopping
POSTGRES_DB=shopping
# Derived as postgresql://<user>:<password>@localhost:(5432 + PORT_OFFSET)/<db>.
# Set it only to reach a database that is not the local container (Neon 등).
# The Prisma CLI derives it the same way, so `pnpm db:migrate` and the running
# API always talk to the same database. Writing it here pins it and turns the
# derivation off for both.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/shopping
#
# Connections the API process may hold open (1 ~ 100). Deployment is a free Neon
# instance, where connections are the ceiling, so lower this rather than raise it
# when several API instances share one database.
# DATABASE_POOL_SIZE=10
# How long to wait for a connection from the pool, in ms (100 ~ 60000). A Neon
# compute that has auto-suspended needs a moment to wake up.
# DATABASE_CONNECT_TIMEOUT_MS=5000
# Deadline for the /health probe query, in ms (50 ~ 10000).
# DATABASE_HEALTH_TIMEOUT_MS=1000

# --- Meilisearch -------------------------------------------------------------
# Derived as http://localhost:(7700 + PORT_OFFSET). Set it only for a remote host.
# MEILI_HOST=https://search.example.com
# Local development value only. Generate a fresh key for every deployment:
#   openssl rand -base64 32
MEILI_MASTER_KEY=local_dev_master_key_change_me
# `development` enables the bundled search preview UI; use `production` when deployed.
MEILI_ENV=development
# Deadline for the /health probe against Meilisearch, in ms (50 ~ 10000).
# MEILI_HEALTH_TIMEOUT_MS=1500

# --- API ---------------------------------------------------------------------
# Derived as 4000 + PORT_OFFSET. `PORT`, which Render and Railway inject, is used
# as a fallback when API_PORT is unset.
# API_PORT=4000
# API_HOST=0.0.0.0
# Reported by GET /api/v1/health. Defaults to apps/api/package.json's version.
# API_VERSION=

# --- CORS --------------------------------------------------------------------
# Derived as the shop / seller / admin origins on localhost and 127.0.0.1
# ((3000|3001|3002) + PORT_OFFSET). Comma separated; an empty list blocks every
# cross origin request.
# CORS_ORIGINS=https://shop.demo-shopping.com,https://seller.demo-shopping.com

# --- 오브젝트 스토리지 (Cloudflare R2) -----------------------------------------
# 상품 이미지는 브라우저가 R2 로 **직접** 올린다 (TASK-0011). API 는 presigned
# URL 만 발급하고 파일 본문은 API 를 거치지 않는다.
#
# **여섯 개를 전부 채우거나, 하나도 채우지 않는다.** 일부만 채우면 API 가 부팅을
# 거부한다. 버킷 이름만 빠진 배포는 "이미지가 안 올라간다" 가 아니라 "다른 버킷에
# 올라간다" 로 나타나고, 후자는 아무도 눈치채지 못한다.
#
# 하나도 없으면 API 는 정상 기동하고 `POST /api/v1/uploads/presign` 만 503 을
# 돌려준다. R2 계정이 준비되기 전까지가 정확히 그 상태다.
#
# 값을 어디서 얻는지는 docs/tasks/M02-deployment/TASK-0011-object-storage.md
# 부록 A 에 대시보드 클릭 단위로 적혀 있다.
#
# R2 대시보드 오른쪽 위의 Account ID. 엔드포인트를
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com 으로 만든다.
# R2_ACCOUNT_ID=
# 개발용은 shopping-dev, 운영용은 shopping-prod 로 나눈다.
# R2_BUCKET=shopping-dev
# Manage R2 API Tokens → Create API token (Object Read & Write) 에서 한 번만
# 보이는 값 2개.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# 업로드된 이미지를 읽는 공개 주소. 커스텀 도메인(https://cdn.demo-shopping.com)
# 또는 r2.dev 서브도메인. **경로가 붙으면 거부된다** — 오리진만 적는다.
# R2_PUBLIC_BASE_URL=
# R2 의 리전은 auto 하나뿐이다. 비워 두면 auto 를 쓴다.
# R2_REGION=auto
#
# S3 호환 서버(MinIO 등)를 가리킬 때만 쓴다. 설정하면 R2_ACCOUNT_ID 대신 이 값이
# 엔드포인트가 된다. 왕복 검증은 이 변수를 직접 적지 않아도 돌아간다 — 아래 명령이
# MinIO 를 띄우고 스스로 채운다:
#   pnpm --filter @shopping/api storage:roundtrip --minio
# R2_ENDPOINT=

# --- 세션 (JWT) --------------------------------------------------------------
# JWT_SECRET — access 토큰 서명 키(TASK-0022). **32자 이상.**
#
# R2 · Google 과 달리 **없으면 API 가 부팅을 거부한다.** 그 둘은 계정이 코드와
# 따로 만들어지므로 "아직 없음" 이 정상 상태이고 해당 엔드포인트만 503 이지만,
# 서명은 그렇지 않다 — 키가 없으면 인증된 요청이 전부 실패하고, 그 상태로 뜬
# 프로세스는 문제를 운영에서 발견하게 할 뿐이다.
#
# 만드는 법은 MEILI_MASTER_KEY 와 같다:
#
#   openssl rand -base64 32
#
# **로컬과 배포의 값이 달라도 된다.** 같을 이유가 없고, 오히려 로컬 키가 새면
# 운영 토큰을 위조할 수 있게 되므로 다른 값을 쓰는 편이 낫다.
#
# 이 키를 바꾸면 **발급된 access 토큰이 전부 무효**가 된다. refresh 는 DB 에
# 해시로 있으므로 살아 있고, 다음 갱신에서 새 access 를 받는다 — 즉 사용자는
# 로그아웃되지 않는다.
# JWT_SECRET=

# --- Google OAuth ------------------------------------------------------------
# 유일한 실계정 로그인 경로다(TASK-0021). 이메일/비밀번호 가입은 만들지 않는다.
#
# GOOGLE_CLIENT_ID · GOOGLE_CLIENT_SECRET (이름은 D-209 확정) — **둘을 세트로
# 채우거나, 둘 다 비운다.** R2 와 같은 패턴이다(`apps/api/src/config/
# storage-config.ts`). 하나만 채우면 API 가 부팅을 거부한다 — 반쯤 설정된
# 상태가 런타임까지 살아남지 않는다.
#
# 둘 다 없으면 API 는 정상 기동하고 `/api/v1/auth/google` 과
# `/api/v1/auth/google/callback` 만 503 을 돌려준다. 계정·클라이언트가 아직
# 없는 로컬 환경이 정확히 그 상태이므로, 두 줄을 채우지 않아도 나머지 기능은
# 그대로 돌아간다.
#
# 값을 어디서 얻는지: Google Cloud Console → API 및 서비스 → 사용자 인증 정보
# → OAuth 2.0 클라이언트 ID. 계정은 이미 만들어져 있다(`docs/OWNER-CHECKLIST.md`
# A-7).
#
# 리다이렉트 URI 는 이미 등록돼 있고 **앱별이 아니라 API 하나**다 — 등록 대상은
# 로컬(http://localhost:4000/api/v1/auth/google/callback) 과 운영
# (https://api.demo-shopping.com/api/v1/auth/google/callback) 둘뿐이다. shop /
# seller / admin 은 이 콜백 하나를 공유하고 돌아갈 앱은 state 쿠키로 구분한다
# (TASK-0021 4장 「콜백은 앱별이 아니라 API 하나다」) — 그래서 앱별 콜백
# 변수를 새로 만들지 않는다.
#
# 동의 화면이 아직 **테스트 모드**다(게시는 M15, D-209). 그동안은 Google Cloud
# Console 에 테스트 사용자로 등록해 둔 계정만 로그인할 수 있다 — 등록되지 않은
# 계정은 동의 화면 자체에서 Google 이 막는다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- 토스페이먼츠 (TASK-0055) ------------------------------------------------
# **테스트 키만 쓴다.** 실 계약이 아니고, 운영 키는 이 프로젝트에 들어올 일이 없다.
#
# 개발자센터(https://developers.tosspayments.com) → 내 개발정보 → 테스트 키.
# 두 개가 한 쌍이고 쓰이는 곳이 다르다:
#
#   TOSS_CLIENT_KEY   `test_ck_` 로 시작한다. **브라우저로 나간다** — 결제창을
#                     띄우는 것이 클라이언트라서다. 공개돼도 그 자체로는 결제가
#                     되지 않으므로 비밀이 아니고, 그래서 `NEXT_PUBLIC_` 접두어가
#                     붙는다.
#   TOSS_SECRET_KEY   `test_sk_` 로 시작한다. **서버에만 둔다.** 승인·취소 API 를
#                     부르는 열쇠라 이것이 새면 남이 결제를 확정하거나 취소할 수
#                     있다. 브라우저로 나가면 안 된다.
#
# 둘 다 비어 있으면 토스 프로바이더가 등록되지 않고, 가상 카드만으로 전체 흐름이
# 완결된다(D-031). **일부만 채우면 부팅이 거부된다** — 반쪽짜리 설정으로 뜨면
# 결제창은 열리는데 승인이 안 되고, 그 증상은 사용자에게 「결제 실패」로만 보인다.
#
# **Vercel 이 `NEXT_PUBLIC_` 변수에 띄우는 경고는 이 키에 한해 무시한다.** 클라이언트
# 키는 공개되도록 설계된 값이고 — 토스 문서와 샘플 코드도 브라우저 JS 에 그대로 넣는다 —
# 그것만으로는 결제창을 띄우는 것 말고 아무것도 할 수 없다. 「Config 로 바꾸라」는
# 제안을 받아들이면 값이 번들에 안 들어가 **결제창이 아예 안 뜬다.**
#
# 같은 경고를 `TOSS_SECRET_KEY` 에서 봤다면 그것은 이름을 잘못 쓴 것이다. 시크릿 키는
# Vercel 이 아니라 Render 의 `shopping-api` 에 넣는다.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=

# --- Tests -------------------------------------------------------------------
# `pnpm test` needs the local Postgres (`pnpm infra:up`); see README "테스트".
# Neither variable belongs in `.env` — set them on the command line when needed.
#
# Rebuilds the template and the per-worker test databases from scratch. Normally
# unnecessary: the template carries a fingerprint of prisma/migrations and is
# rebuilt on its own when that changes.
#   TEST_DB_REBUILD=1 pnpm test
#
# Number of vitest workers, and therefore of `shopping_test_w<n>` databases.
# Defaults to 4 (apps/api/vitest.config.mjs).
#   VITEST_MAX_WORKERS=2 pnpm test

# --- Web apps (shop / seller / admin) ----------------------------------------
# Each app's dev/build/start goes through `scripts/web-app.mjs`, which derives
# both of the variables below from PORT_OFFSET before handing over to Next. A
# value already exported in the shell (or set by a deployment platform) wins, so
# there is nothing to fill in here for local work.
#
# PORT: 3000 / 3001 / 3002 + PORT_OFFSET for shop / seller / admin.
#
# NEXT_PUBLIC_API_URL: http://localhost:(4000 + PORT_OFFSET). It is compiled into
# the page, so it must never contain a secret, and a change to it only reaches a
# production bundle through a rebuild (`next dev` picks it up on restart).
# NEXT_PUBLIC_API_URL=https://api.demo-shopping.com
#
# Under `pnpm test` this variable is NOT read from here. The vitest preset
# (`packages/config/vitest/next-app.js`) forces it to
#
#   NEXT_PUBLIC_API_URL=http://api.test.invalid
#
# `.invalid` is reserved by RFC 6761 and never resolves, so a front-end test
# that somehow slipped past the mock API cannot reach a running local API
# instead (TASK-0107 4.8). Do not point it at a real host to "make a test pass".

# --- 배포 환경 (Render · Neon) -----------------------------------------------
# 이 파일은 **로컬** 템플릿이다. 배포 환경의 값은 여기가 아니라 `render.yaml`
# (평문) 과 Render 대시보드 (비밀값) 에 있다. 아래는 두 곳을 잇는 대조표다.
#
# 비밀값 7개는 `render.yaml` 에 `sync: false` 로 선언돼 있어 Render 가 Blueprint
# 생성 시 물어본다. 나머지는 `render.yaml` 에 평문으로 들어 있다.
#
#   변수                         어디서 얻나                          비밀
#   ---------------------------  -----------------------------------  ----
#   DATABASE_URL                 Neon 콘솔 → Connection string        O
#                                (`?sslmode=require` 포함 확인)
#   MEILI_MASTER_KEY             openssl rand -base64 32 로 새로 생성  O
#                                (두 서비스에 **같은 값**을 넣는다)
#   MEILI_HOST                   Render 의 shopping-search 서비스 URL  X*
#                                https://<이름>.onrender.com
#   NODE_ENV=production          render.yaml                          X
#   LOG_LEVEL=log                render.yaml                          X
#   DATABASE_POOL_SIZE=5         render.yaml (Neon 커넥션 상한 대응)   X
#   DATABASE_CONNECT_TIMEOUT_MS  render.yaml = 15000 (scale-to-zero)   X
#   DATABASE_HEALTH_TIMEOUT_MS   render.yaml = 3000                    X
#   MEILI_HEALTH_TIMEOUT_MS      render.yaml = 5000                    X
#   CORS_ORIGINS                 render.yaml (세 앱의 https 오리진)    X
#   MEILI_ENV=production         render.yaml (검색 서비스 쪽)          X
#   MEILI_HTTP_ADDR=0.0.0.0:10000 render.yaml (검색 서비스 쪽)         X
#   MEILI_NO_ANALYTICS=true      render.yaml (검색 서비스 쪽)          X
#   PORT                         Render 가 주입 (기본 10000)           X
#   R2_ACCOUNT_ID                Cloudflare R2 대시보드                X*
#   R2_BUCKET                    shopping-prod                        X*
#   R2_ACCESS_KEY_ID             R2 API 토큰 생성 화면                 O
#   R2_SECRET_ACCESS_KEY         〃 (한 번만 표시된다)                 O
#   R2_PUBLIC_BASE_URL           공개 읽기 도메인 또는 r2.dev          X*
#   R2_REGION=auto               고정값                                X*
#   GOOGLE_CLIENT_ID             Google Cloud Console → OAuth 클라이언트 ID  O
#   GOOGLE_CLIENT_SECRET         〃 (클라이언트 보안 비밀번호)                    O
#   JWT_SECRET                   openssl rand -base64 32                O
#   NEXT_PUBLIC_TOSS_CLIENT_KEY  토스 개발자센터 → 테스트 키 (test_ck_)  X*
#   TOSS_SECRET_KEY              〃 (test_sk_ — 서버에만)                O
#
#   * 비밀은 아니지만 계정이 생기기 전에는 값을 알 수 없어 MEILI_HOST 와 같은
#     이유로 sync: false 다. 여섯 개는 **전부 채우거나 전부 비운다** — 일부만
#     채우면 부팅이 거부된다.
#     (GOOGLE_CLIENT_ID·GOOGLE_CLIENT_SECRET 은 이 여섯 개 세트에 포함되지
#     않는다 — 이쪽은 진짜 비밀값이고, 세트 규칙은 둘만의 것이다: 둘 다
#     채우거나 둘 다 비운다.)
#
#   * MEILI_HOST 는 비밀이 아니지만 서비스가 생기기 전에는 값을 알 수 없어
#     `sync: false` 로 뒀다. Blueprint 생성 뒤 2단계로 채운다.
#
# API_HOST · API_PORT · API_VERSION 은 배포 환경에서 설정하지 않는다.
# API_PORT 는 Render 가 주입하는 PORT 를 폴백으로 읽는다.
#
# **배포 환경에서도 파생이 동작한다.** Render 의 Node 런타임은 저장소 체크아웃
# 위에서 돌아 `pnpm-workspace.yaml` 과 `scripts/ports.mjs` 가 그대로 있다. 그래서
# DATABASE_URL·MEILI_HOST·CORS_ORIGINS 를 빠뜨리면 부팅이 거부되는 것이 아니라
# **조용히 localhost 기본값**이 된다. `render.yaml` 이 이 셋을 전부 명시하는 이유다.
