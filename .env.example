# Template for the local `.env`. Copy it once per worktree:
#
#   cp .env.example .env
#
# Nothing needs editing afterwards. Every port bearing value is derived at boot
# from this worktree's `PORT_OFFSET` (`scripts/ports.mjs` is the single source of
# truth for ports), so the commented lines below are overrides, not blanks to
# fill in — uncomment one only to point at something that is not the local stack.
#
# `.env` is git-ignored and must never hold a real secret — this template is the
# only env file that is committed.
#
# Loading order, lowest priority first (see README "환경변수"):
#
#   1. .env         local defaults shared by every app and by docker compose
#   2. .env.local   worktree-specific overrides: PORT_OFFSET, COMPOSE_PROJECT_NAME
#   3. shell        `PORT_OFFSET=40 pnpm infra:up` beats both files

# --- Worktree identity -------------------------------------------------------
# These two belong in `.env.local`, not here, because they differ per worktree.
# PORT_OFFSET=0
# COMPOSE_PROJECT_NAME=shopping

# --- Runtime -----------------------------------------------------------------
# development | test | production. Only `development` may put a stack trace in
# an error response.
NODE_ENV=development
# error | warn | log | debug | verbose
LOG_LEVEL=log

# --- PostgreSQL --------------------------------------------------------------
# Used by docker compose to initialise the container, and by the API to build
# DATABASE_URL when that is not set explicitly.
POSTGRES_USER=shopping
POSTGRES_PASSWORD=shopping
POSTGRES_DB=shopping
# Derived as postgresql://<user>:<password>@localhost:(5432 + PORT_OFFSET)/<db>.
# Set it only to reach a database that is not the local container (Neon 등).
# The Prisma CLI derives it the same way, so `pnpm db:migrate` and the running
# API always talk to the same database. Writing it here pins it and turns the
# derivation off for both.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/shopping
#
# Connections the API process may hold open (1 ~ 100). Deployment is a free Neon
# instance, where connections are the ceiling, so lower this rather than raise it
# when several API instances share one database.
# DATABASE_POOL_SIZE=10
# How long to wait for a connection from the pool, in ms (100 ~ 60000). A Neon
# compute that has auto-suspended needs a moment to wake up.
# DATABASE_CONNECT_TIMEOUT_MS=5000
# Deadline for the /health probe query, in ms (50 ~ 10000).
# DATABASE_HEALTH_TIMEOUT_MS=1000

# --- Meilisearch -------------------------------------------------------------
# Derived as http://localhost:(7700 + PORT_OFFSET). Set it only for a remote host.
# MEILI_HOST=https://search.example.com
# Local development value only. Generate a fresh key for every deployment:
#   openssl rand -base64 32
MEILI_MASTER_KEY=local_dev_master_key_change_me
# `development` enables the bundled search preview UI; use `production` when deployed.
MEILI_ENV=development
# Deadline for the /health probe against Meilisearch, in ms (50 ~ 10000).
# MEILI_HEALTH_TIMEOUT_MS=1500

# --- API ---------------------------------------------------------------------
# Derived as 4000 + PORT_OFFSET. `PORT`, which Render and Railway inject, is used
# as a fallback when API_PORT is unset.
# API_PORT=4000
# API_HOST=0.0.0.0
# Reported by GET /api/v1/health. Defaults to apps/api/package.json's version.
# API_VERSION=

# --- CORS --------------------------------------------------------------------
# Derived as the shop / seller / admin origins on localhost and 127.0.0.1
# ((3000|3001|3002) + PORT_OFFSET). Comma separated; an empty list blocks every
# cross origin request.
# CORS_ORIGINS=https://shop.demo-shopping.com,https://seller.demo-shopping.com

# --- Web apps (shop / seller / admin) ----------------------------------------
# Each app's dev/build/start goes through `scripts/web-app.mjs`, which derives
# both of the variables below from PORT_OFFSET before handing over to Next. A
# value already exported in the shell (or set by a deployment platform) wins, so
# there is nothing to fill in here for local work.
#
# PORT: 3000 / 3001 / 3002 + PORT_OFFSET for shop / seller / admin.
#
# NEXT_PUBLIC_API_URL: http://localhost:(4000 + PORT_OFFSET). It is compiled into
# the page, so it must never contain a secret, and a change to it only reaches a
# production bundle through a rebuild (`next dev` picks it up on restart).
# NEXT_PUBLIC_API_URL=https://api.demo-shopping.com
#
# Under `pnpm test` this variable is NOT read from here. The vitest preset
# (`packages/config/vitest/next-app.js`) forces it to
#
#   NEXT_PUBLIC_API_URL=http://api.test.invalid
#
# `.invalid` is reserved by RFC 6761 and never resolves, so a front-end test
# that somehow slipped past the mock API cannot reach a running local API
# instead (TASK-0107 4.8). Do not point it at a real host to "make a test pass".
