{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@shopping/config — next",
  "extends": "./base.json",
  // Next.js App Router apps and any package that ships React components.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    // Next.js emits through its own bundler; tsc is only a checker here.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "plugins": [{ "name": "next" }]
  }
}
