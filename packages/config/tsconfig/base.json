{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@shopping/config — base",
  // Shared by every package. Framework specific options live in next.json / nest.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Unused code is reported by eslint (@typescript-eslint/no-unused-vars) so that
    // a single tool owns the rule and editors can auto-fix it.
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // TypeScript 6 no longer pulls in every node_modules/@types package on its
    // own, and each app needs a different set (Next apps also want DOM). Declare
    // `types` in the consuming package's tsconfig, e.g. apps/api uses ["node"].

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Consumers must be able to jump from dist back to the original source.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
