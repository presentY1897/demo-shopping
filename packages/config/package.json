    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.69.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
