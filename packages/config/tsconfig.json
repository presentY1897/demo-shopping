{
  "extends": "./tsconfig/base.json",
  // The presets are plain JS, so they are checked with checkJs instead of compiled.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["eslint/**/*.js", "prettier/**/*.js"]
}
