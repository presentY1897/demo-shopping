{
  "extends": "@shopping/config/tsconfig/base.json",
  // Widened from `src` so the specs are part of the same program — they are
  // typechecked and linted from here. `tsconfig.build.json` narrows the set back
  // so they stay out of `dist`; `apps/api/tsconfig.json` is the same shape and
  // for the same reason.
  "compilerOptions": {
    "rootDir": "."
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
