# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
.next/
out/
storybook-static/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# test / coverage
coverage/
# `vitest --reporter=blob` writes here. CI's sharded run produces one per shard
# and the merge job consumes them; locally they appear whenever someone
# reproduces that run.
.vitest-reports/
.nyc_output/
playwright-report/
test-results/

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local data
*.sqlite
*.sqlite3
# 런타임에 파일이 떨어지는 자리만 무시한다. 경로 없는 `uploads/` 는 트리
# 어디에나 걸려서 `apps/seller/src/lib/uploads/` 같은 소스 디렉터리를 조용히
# 삼킨다 — 커밋은 성공하고, 빠진 파일은 CI 가 처음 빨개질 때까지 아무도 모른다.
/uploads/
/apps/*/uploads/

# monorepo / tooling
.turbo/
.pnpm-store/
.cache/

# other package managers (blocked by scripts/only-pnpm.mjs, but npm still
# writes a lockfile before the preinstall hook fails)
package-lock.json
yarn.lock

# 시드 이미지 자산 (TASK-0037). 사진은 사람이 넣고 저장소에는 올리지 않는다 —
# 스톡 라이선스가 재배포를 허용하지 않고, AI 생성분은 수백 MB 다. 없으면 시드가
# SVG 플레이스홀더를 대신 만든다.
/assets/seed-images/

# Lighthouse 실행 결과. 워크플로가 아티팩트로 올리므로 저장소에 둘 이유가 없다.
.lighthouseci/

# Playwright 가 실패했을 때만 남기는 것들 (TASK-0099).
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# Generated product photography is stored in R2; keep manifests/specs in Git.
/apps/shop/public/product-image-sets/*/images/
/apps/shop/public/images/products/*.png
/apps/shop/public/product-image-sets/*/index.html
# Local generation traces, DB audit snapshots and machine-specific results.
/product-images/*
!/product-images/README.md
!/product-images/*-v[0-9]*.json
!/product-images/reviewed-products-export.json
!/product-images/uploaded-assets.json
!/product-images/legacy-image-aliases.json
!/product-images/production-migration-plan.md
!/product-images/catalog-production.md
__pycache__/

# Generated from shop assets by scripts/web-app.mjs
/apps/seller/public/seed/catalog/
/apps/admin/public/seed/catalog/
