// Single source of truth for the database schema.
//
// `docs/design/erd.md` explains what the tables are for and why the model is
// split the way it is; column types and constraints live here and nowhere else.
// Every change goes through `pnpm db:migrate`, and the generated SQL is
// committed — deployments only ever run `prisma migrate deploy`.
//
// The datasource URL is not declared here on purpose: `prisma.config.ts`
// resolves it with the same code the API uses at boot, so the CLI and the
// running process can never disagree about which database they are talking to.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Small operational key/value store owned by the platform itself.
///
/// It is deliberately not a domain table: TASK-0005 needs one model to prove the
/// migration pipeline end to end, and an operational marker (seed fingerprint,
/// schema baseline) is the one thing every environment can carry without
/// pre-empting the domain schema that arrives from M04 onwards.
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Accounts · roles · sessions (TASK-0020)
//
// Three constraints below cannot be expressed in PSL and live in the migration
// as raw SQL — Prisma's drift detection ignores partial indexes and CHECK
// constraints, so they survive later `migrate dev` runs untouched:
//
//   User_googleSub_active_key    one live account per Google identity
//   Address_userId_default_key   one default shipping address per user
//   *_check                      demo/real invariants and the commission range
//
// Anything the database is asked to guarantee is stated there and repeated
// in a comment on the field it guards, so the two never drift silently.
// ---------------------------------------------------------------------------

/// Roles a single account can hold at once.
///
/// Modelled as rows in `UserRole` rather than a column on `User` because a
/// seller also buys: a single-valued role would force that person to keep two
/// accounts. The mapping from a role to its permissions is a **code constant**,
/// never a table (TASK-0105) — permissions change with a deploy, not with an
/// UPDATE, and a table would let a production row silently widen access.
enum Role {
  BUYER
  SELLER_OWNER
  ADMIN_OPERATOR
  ADMIN_SUPER
  DEMO_ADMIN
}

/// Lifecycle of a seller's store. `SUSPENDED` is the terminal state instead of
/// a delete: products, orders and settlements point at the store forever.
enum SellerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

/// The three front-ends. Sessions are independent per app (DECISIONS 2), so a
/// refresh token records which app it was issued for and is worthless in the
/// other two — that is the schema-level half of "cookies carry no `Domain`".
enum ClientApp {
  SHOP
  SELLER
  ADMIN
}

/// Product display density in `apps/shop` (`docs/design/pages.md`).
enum DisplayDensity {
  MINIMAL
  STANDARD
  MAXIMAL
}

/// One person's account, real or demo.
///
/// Identifiers are UUIDv7 rather than a serial: a user id travels in URLs and
/// tokens, where a sequential number leaks how many accounts exist and invites
/// enumeration. v7 keeps the time prefix, so inserts still land at the right
/// edge of the B-tree instead of scattering across it like v4.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Google's stable subject claim; the login identity.
  ///
  /// Nullable because a demo account never went through Google, and because a
  /// withdrawn account may have its identity scrubbed (TASK-0025) while the row
  /// stays behind as an FK anchor for its orders.
  ///
  /// Uniqueness is enforced by the partial index `User_googleSub_active_key`
  /// (`WHERE "deletedAt" IS NULL`), not by `@unique`: a plain unique index would
  /// burn the Google account forever the moment its owner withdrew.
  googleSub String?

  /// Not unique. The identity is `googleSub` — a Google account can change its
  /// email, and demo accounts get a generated one.
  email     String
  name      String
  avatarUrl String?

  /// Demo accounts are issued on the spot and expire (DECISIONS 2). The pair is
  /// held consistent by `User_demo_expiry_check`: a demo account always carries
  /// an expiry and a real one never does, so "is this a demo?" has exactly one
  /// answer no matter which of the two columns a query looks at.
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?

  lastLoginAt DateTime?

  /// Withdrawal. Orders, reviews and settlements keep pointing here, so the row
  /// is never physically removed; `deletedAt` is what takes the account out of
  /// the login path and out of the `googleSub` unique index.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  seller        Seller?
  addresses     Address[]
  preference    UserPreference?
  refreshTokens RefreshToken[]

  /// Admin console looks accounts up by email.
  @@index([email])
  /// The expiry sweep: `WHERE "isDemo" AND "demoExpiresAt" < now()`.
  @@index([isDemo, demoExpiresAt])
}

/// A role granted to an account. Many rows per user — see {@link Role}.
model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  role      Role
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Granting the same role twice is a no-op, not a second row.
  @@unique([userId, role])
  /// "who are the admins" — a scan over every user would be the alternative.
  @@index([role])
}

/// A seller's store. One per account.
model Seller {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @db.Uuid

  brandName String @unique
  /// URL identifier for the storefront; separate from `brandName` so renaming
  /// the brand does not have to break every link that points at the store.
  slug         String  @unique
  introduction String?
  logoUrl      String?

  status SellerStatus @default(PENDING)
  /// Why the store was rejected or suspended, shown back to the seller.
  statusReason    String?
  statusChangedAt DateTime?

  /// Platform commission in **basis points** (1 bp = 0.01%), e.g. 350 = 3.50%.
  /// NULL means "no individual rate" and the category default applies
  /// (`docs/design/pricing.md` 5). An integer because money is integer KRW and
  /// a float rate would reintroduce rounding drift into settlement; the range
  /// is held to 0–10000 by `Seller_commissionRateBp_check`.
  commissionRateBp Int?

  /// Optimistic lock (DECISIONS 4). Two people edit this row — the seller
  /// changes brand copy while an operator approves or suspends the store — and
  /// last-write-wins would quietly revert one of them.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`, unlike the personal tables below: a store carries products,
  /// orders and settlements, so removing its owner must fail loudly rather than
  /// cascade through the catalogue.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// The operator queue: pending applications first.
  @@index([status])
}

/// An entry in a user's address book.
///
/// Orders snapshot the recipient (`docs/design/erd.md` 4), so nothing points at
/// this row and it can be deleted for real — which is also what makes purging a
/// withdrawn account's personal data possible without breaking order history.
model Address {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// User-supplied nickname such as "집" or "회사".
  label         String?
  recipientName String
  phone         String

  /// Korean five-digit postal code.
  postalCode   String
  addressLine1 String
  addressLine2 String?

  /// At most one per user, enforced by the partial unique index
  /// `Address_userId_default_key`. Application-level checking is not enough:
  /// two concurrent "make this the default" requests both read zero defaults
  /// and both write one.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address book listing. The partial index above only covers the default
  /// row, so it cannot serve this query.
  @@index([userId])
}

/// Per-account display and notification settings.
///
/// Keyed by `userId` instead of carrying an id of its own: the relation is
/// one-to-one, and a surrogate key would allow a second row to exist.
model UserPreference {
  userId String @id @db.Uuid

  density  DisplayDensity @default(STANDARD)
  /// BCP 47 tag. Korean first, but the column exists from the start so that
  /// adding a locale later is data rather than a migration (DECISIONS 1).
  locale   String         @default("ko-KR")
  /// ISO 4217. Amounts are integer minor-unit values; this says of what.
  currency String         @default("KRW")

  /// In-app notification centre only — email and push are out of scope
  /// (DECISIONS 8), so these are the switches that actually do something.
  notifyOrder     Boolean @default(true)
  notifyClaim     Boolean @default(true)
  notifyMarketing Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One issued refresh token.
///
/// The token itself is never stored — `tokenHash` holds a digest, so a dump of
/// this table cannot be replayed as a session. Rotation and reuse detection are
/// TASK-0022; what this table has to get right now is that a session belongs to
/// exactly one app.
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// Which front-end this session belongs to. A SHOP token presented to the
  /// admin API is rejected by a lookup that filters on this column.
  app ClientApp

  /// Digest of the token, not the token.
  tokenHash String @unique

  expiresAt DateTime
  /// Set on logout and on rotation; a revoked row is kept so that a replay can
  /// still be recognised instead of merely missing.
  revokedAt DateTime?

  /// Shown in a "signed-in devices" list, and the only way to tell two sessions
  /// of the same app apart.
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "this user's sessions on this app" — issue, list and revoke all use it.
  @@index([userId, app])
  /// The sweep that deletes expired rows.
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalogue — the category tree (TASK-0028)
//
// The invariants of a tree are not something an application layer can hold on
// its own: two concurrent requests both read a consistent tree, both decide
// their change is legal, and both write. So the shape of the tree is stated to
// the database instead, in the migration:
//
//   Category_id_path_key            (id, path) — the target of the edge below
//   Category_parentId_parentPath_fkey  (parentId, parentPath) -> (id, path)
//   Category_path_shape_check       path = parentPath || id || '/'
//   Category_parent_pairing_check   parentId and parentPath are both set or neither
//   Category_depth_path_check       depth = number of ids in path
//   Category_depth_range_check      1 <= depth <= 3
//   Category_slug_active_key        one live category per slug
//
// Together the first three make a cycle **unrepresentable**: every node's path
// is its parent's path plus its own id, so a path is strictly longer than its
// parent's, and a cycle would need a node whose path is longer than itself.
// Depth then follows from the path, and the range check caps the tree at three
// levels no matter which request wrote the row.
//
// Attribute definitions (TASK-0030) hang off the same tree and add five more
// hand written rules, for the same reason:
//
//   AttributeDefinition_categoryId_key_active_key  one live definition per key
//   AttributeDefinition_key_format_check           the key is a JSONB/filter identifier
//   AttributeDefinition_options_check              options exist iff the type has them
//   AttributeDefinition_option_blank_check         no empty option label
//   AttributeDefinition_label_check                the label is not blank
//   AttributeDefinition_sortOrder_check            a position, never negative
//
// What the database deliberately does **not** enforce is uniqueness of a key
// across a whole *lineage* — that question needs a lookup in other rows, and a
// CHECK constraint may not contain a subquery. It is held by the service under
// the tree advisory lock instead (TASK-0030 4.2), which is why that rule has a
// concurrency spec and these six do not.
// ---------------------------------------------------------------------------

/// One node of the category tree.
model Category {
  /// A short integer, unlike the UUIDv7 of every account-side table.
  ///
  /// Deliberate (`docs/design/erd.md` 1): `path` concatenates ancestor ids into
  /// a string that is read on every catalogue query, so the ids have to stay
  /// short — and a category id is platform data that never travels in a token,
  /// so nothing leaks by being sequential.
  ///
  /// **Ids are never reused.** Deleting category 5 leaves 5 vacant forever; a
  /// reused id would make `categoryId: 5` in an old order snapshot, log line or
  /// search document point at a different category, and nothing would notice.
  id Int @id @default(autoincrement())

  parentId Int?

  /// Materialised path of ancestors, always ending in this node's own id:
  /// `/1/5/12/`. One `LIKE '/1/5/%'` returns an entire subtree, which is what
  /// this column exists for — the adjacency list alone needs recursion.
  ///
  /// Written by `CategoryService` and **verified by the database**: the checks
  /// listed above tie it to `parentPath`, to `id` and to `depth`, so a path that
  /// disagrees with the tree cannot be committed by any code path.
  path String

  /// `path` with the trailing `<id>/` removed; NULL for a root.
  ///
  /// It exists so that the parent edge can be a *composite* foreign key on
  /// `(parentId, parentPath)`. A plain `parentId` reference would let the path
  /// cache drift from the real parent; this way the database refuses the drift.
  parentPath String?

  /// 1 for a root, capped at 3 (`Category_depth_range_check`). Derived from
  /// `path` and kept as a column so that "roots first" is an index-ordered read
  /// rather than a computation over every row.
  depth Int

  name String
  /// URL identifier. Unique among live categories only
  /// (`Category_slug_active_key`) — a deleted category must not hold its slug
  /// hostage, exactly as a withdrawn account does not hold its Google identity.
  slug String

  /// Display order among siblings. Gaps are left alone: it is a presentation
  /// value, not an identity, and renumbering on every delete would rewrite rows
  /// nobody asked to change.
  sortOrder Int @default(0)

  /// Hidden from the storefront while staying a valid target for existing
  /// products. Deletion is `deletedAt`; neither ever frees the id.
  isActive Boolean @default(true)

  /// Optimistic lock for the fields a person edits — name, slug, activation
  /// (DECISIONS 4). Structural changes (move, reorder) do not touch it: they
  /// are serialised by an advisory lock instead, and telling an editor their
  /// rename conflicts because someone reordered siblings would be noise.
  version Int @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// `NoAction` rather than the default `Cascade` on update: moving a subtree
  /// rewrites the parent and all of its descendants in **one** statement, and
  /// `NO ACTION` is checked when that statement ends — by which time the whole
  /// subtree is consistent again. `Restrict` would refuse mid-statement, and
  /// `Cascade` would rewrite `parentPath` without `path`, breaking the shape
  /// check.
  parent   Category?  @relation("CategoryTree", fields: [parentId, parentPath], references: [id, path], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  attributes AttributeDefinition[]

  /// Target of the composite parent edge above.
  @@unique([id, path])
  /// Sibling listing and reordering.
  @@index([parentId, sortOrder])
  /// Subtree reads are `path LIKE '/1/5/%'`. The operator class is required:
  /// the database collation is `en_US.utf8`, and a default btree index cannot
  /// serve a prefix match under a non-C collation.
  @@index([path(ops: raw("text_pattern_ops"))])
}

/// What kind of value an attribute holds (TASK-0030 2장).
///
/// Five, and closed on purpose. Every one of them has to be expressible as a
/// zod schema built at runtime from a row of {@link AttributeDefinition} *and*
/// as a Meilisearch filter later (M06), so a type nobody can filter on would be
/// a definition the storefront cannot use. Adding one is a migration plus a
/// branch in `src/catalog/attribute-schema.ts`, which is exactly the visibility
/// this list is for.
enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// One attribute a category — and everything under it — may carry.
///
/// This is the table half of "카테고리·속성은 코드 수정 없이 추가·설정 가능"
/// (DECISIONS 1). The **definitions** are rows so that the product form and the
/// search filters can be generated from them; the **values** are a JSONB column
/// on `Product`, so that listing twenty products costs no joins
/// (`docs/design/erd.md` 2 — 속성을 정의/값으로 나눈 이유).
///
/// The price of that split is that the database cannot check a single value.
/// `src/catalog/attribute-schema.ts` builds a zod schema from these rows on
/// every save, and it is the only thing standing between a typo and a product
/// whose `attributes` nothing can read.
model AttributeDefinition {
  /// Sequential like `Category.id` and for the same reason: it is platform data
  /// that never travels in a token, and it is read on every catalogue write.
  id Int @id @default(autoincrement())

  /// The category this definition is attached to. It applies to that category
  /// **and to everything below it** — resolution walks the ancestors of the
  /// target through `Category.path` (TASK-0030 4.3).
  categoryId Int

  /// Identifier of the value inside `Product.attributes`, e.g. `material`.
  ///
  /// Held to `^[a-z][a-z0-9_]{0,39}$` by `AttributeDefinition_key_format_check`,
  /// because this string is simultaneously a JSON object key and a Meilisearch
  /// filter field name. A key with a dot or a space parses as a path expression
  /// on the search side and quietly matches nothing.
  ///
  /// Unique per category among live rows
  /// (`AttributeDefinition_categoryId_key_active_key`). Uniqueness across a
  /// whole lineage is a rule the database cannot state — see the header above.
  key String

  /// What a person sees. Korean by default; the message-file split
  /// (DECISIONS 1) applies to UI chrome, not to operator-entered data.
  label String

  type AttributeType

  /// Choices for `SELECT` and `MULTI_SELECT`, empty for the other three.
  ///
  /// `AttributeDefinition_options_check` states exactly that, in both
  /// directions: a `SELECT` without options can never validate any value and
  /// would make a required attribute permanently unsatisfiable, while options
  /// on a `BOOLEAN` are a definition whose author meant something else.
  ///
  /// Duplicates inside the array are refused by the service, not by the
  /// database: telling duplicates from distinct values needs an aggregate, and
  /// a CHECK may not contain one.
  options String[] @default([])

  /// Whether a product in this category must carry the attribute.
  isRequired Boolean @default(false)

  /// Whether the attribute becomes a search facet (M06). Stored from the start
  /// so that turning a facet on is data rather than a migration.
  isFilterable Boolean @default(false)

  /// Display order within the category that owns the definition. Inherited
  /// attributes always sort before the ones defined further down, so a form
  /// reads from the general to the specific.
  sortOrder Int @default(0)

  /// Optimistic lock (DECISIONS 4). An operator edits the label while another
  /// widens the options; last-write-wins would silently drop one of them.
  version Int @default(0)

  /// Soft delete, like `Category`. The row survives so that a product still
  /// carrying the key has something to explain it, and the partial unique index
  /// lets the key be defined again.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: a category is never hard deleted (its own removal is
  /// `deletedAt`), so this edge exists to refuse the delete nobody wrote —
  /// a `Cascade` here would let a stray `DELETE FROM "Category"` take the
  /// definitions with it and leave every product's `attributes` unexplainable.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The lineage conflict check filters by key first: "does any ancestor or
  /// descendant already define `material`?" (TASK-0030 4.2).
  ///
  /// The other query — `categoryId = ANY(ancestor ids) AND deletedAt IS NULL`,
  /// which resolves an inherited set in one statement — needs no index of its
  /// own: `AttributeDefinition_categoryId_key_active_key` already leads with
  /// `categoryId` and carries `WHERE "deletedAt" IS NULL` as its predicate, so
  /// it is a **better** match than a plain `(categoryId, sortOrder)` would be.
  /// A second index over the same prefix would be write amplification that no
  /// read benefits from; the display order is a sort over a handful of rows the
  /// application does in memory. Verified by the `EXPLAIN` in
  /// `test/api/attributes-performance.spec.ts` (gate S3).
  @@index([key])
}
