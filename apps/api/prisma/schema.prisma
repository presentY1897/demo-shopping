// Single source of truth for the database schema.
//
// `docs/design/erd.md` explains what the tables are for and why the model is
// split the way it is; column types and constraints live here and nowhere else.
// Every change goes through `pnpm db:migrate`, and the generated SQL is
// committed — deployments only ever run `prisma migrate deploy`.
//
// The datasource URL is not declared here on purpose: `prisma.config.ts`
// resolves it with the same code the API uses at boot, so the CLI and the
// running process can never disagree about which database they are talking to.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Small operational key/value store owned by the platform itself.
///
/// It is deliberately not a domain table: TASK-0005 needs one model to prove the
/// migration pipeline end to end, and an operational marker (seed fingerprint,
/// schema baseline) is the one thing every environment can carry without
/// pre-empting the domain schema that arrives from M04 onwards.
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Accounts · roles · sessions (TASK-0020)
//
// Three constraints below cannot be expressed in PSL and live in the migration
// as raw SQL — Prisma's drift detection ignores partial indexes and CHECK
// constraints, so they survive later `migrate dev` runs untouched:
//
//   User_googleSub_active_key    one live account per Google identity
//   Address_userId_default_key   one default shipping address per user
//   *_check                      demo/real invariants and the commission range
//
// Anything the database is asked to guarantee is stated there and repeated
// in a comment on the field it guards, so the two never drift silently.
// ---------------------------------------------------------------------------

/// Roles a single account can hold at once.
///
/// Modelled as rows in `UserRole` rather than a column on `User` because a
/// seller also buys: a single-valued role would force that person to keep two
/// accounts. The mapping from a role to its permissions is a **code constant**,
/// never a table (TASK-0105) — permissions change with a deploy, not with an
/// UPDATE, and a table would let a production row silently widen access.
enum Role {
  BUYER
  SELLER_OWNER
  ADMIN_OPERATOR
  ADMIN_SUPER
  DEMO_ADMIN
}

/// Lifecycle of a seller's store. `SUSPENDED` is the terminal state instead of
/// a delete: products, orders and settlements point at the store forever.
enum SellerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

/// The three front-ends. Sessions are independent per app (DECISIONS 2), so a
/// refresh token records which app it was issued for and is worthless in the
/// other two — that is the schema-level half of "cookies carry no `Domain`".
enum ClientApp {
  SHOP
  SELLER
  ADMIN
}

/// Product display density in `apps/shop` (`docs/design/pages.md`).
enum DisplayDensity {
  MINIMAL
  STANDARD
  MAXIMAL
}

/// One person's account, real or demo.
///
/// Identifiers are UUIDv7 rather than a serial: a user id travels in URLs and
/// tokens, where a sequential number leaks how many accounts exist and invites
/// enumeration. v7 keeps the time prefix, so inserts still land at the right
/// edge of the B-tree instead of scattering across it like v4.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Google's stable subject claim; the login identity.
  ///
  /// Nullable because a demo account never went through Google, and because a
  /// withdrawn account may have its identity scrubbed (TASK-0025) while the row
  /// stays behind as an FK anchor for its orders.
  ///
  /// Uniqueness is enforced by the partial index `User_googleSub_active_key`
  /// (`WHERE "deletedAt" IS NULL`), not by `@unique`: a plain unique index would
  /// burn the Google account forever the moment its owner withdrew.
  googleSub String?

  /// Not unique. The identity is `googleSub` — a Google account can change its
  /// email, and demo accounts get a generated one.
  email     String
  name      String
  avatarUrl String?

  /// Demo accounts are issued on the spot and expire (DECISIONS 2). The pair is
  /// held consistent by `User_demo_expiry_check`: a demo account always carries
  /// an expiry and a real one never does, so "is this a demo?" has exactly one
  /// answer no matter which of the two columns a query looks at.
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?

  /**
   * 정지된 시각 (TASK-0093 F4).
   *
   * **탈퇴(`deletedAt`)와 다르다.** 탈퇴는 되돌리지 않는 끝이고 정지는 되돌리는
   * 조치다 — 한 칸에 담으면 「해제」가 「탈퇴 취소」와 같은 일이 되고, 그 둘은 개인정보
   * 처리 관점에서 전혀 다른 결정이다.
   *
   * 로그인이 이 칸을 본다. 세션을 지우는 것만으로는 부족하다 — 다음 로그인이 그대로
   * 되면 정지는 「한 번 쫓아냄」이지 정지가 아니다.
   */
  suspendedAt     DateTime?
  /** 왜 정지됐는가. 정지에는 언제나 사유가 있다 (`User_suspended_reason_check`). */
  suspendedReason String?

  /**
   * 데모 정리가 마지막으로 실패한 시각과 이유 (TASK-0096 F4).
   *
   * **표를 따로 만들지 않는다.** 실패는 이 계정의 지금 상태이지 쌓아 둘 사건이
   * 아니다 — 다음 주기가 다시 시도하고 성공하면 이 칸들은 그냥 비워진다
   * (`demo-cleanup.service.ts` 의 「nothing has to remember it」). 표로 만들면 이미
   * 정리된 계정의 옛 실패가 영영 남아 목록을 채운다.
   */
  demoCleanupFailedAt DateTime?
  demoCleanupError    String?

  lastLoginAt DateTime?

  /// Withdrawal. Orders, reviews and settlements keep pointing here, so the row
  /// is never physically removed; `deletedAt` is what takes the account out of
  /// the login path and out of the `googleSub` unique index.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  seller        Seller?
  personalDataViewed    PersonalDataAccess[] @relation("PersonalDataActor")
  personalDataViewedBy  PersonalDataAccess[] @relation("PersonalDataSubject")
  addresses     Address[]
  preference    UserPreference?
  refreshTokens RefreshToken[]
  cart          Cart?
  reservations  StockReservation[]
  orders        Order[]
  virtualCards  VirtualCard[]

  /// 이 계정이 낸 취소·반품 신청 (TASK-0065). 탈퇴는 소프트 삭제이므로 저쪽 끝이
  /// `Restrict` 이고, 그래서 「누가 신청했나」가 사라지지 않는다.
  claimRequests ClaimRequest[]

  /// 이 계정이 낸 이의, 그리고 이 계정이 결론을 낸 이의 (TASK-0071). 둘 다 저쪽
  /// 끝이 `Restrict` 인 것은 같은 이유다 — 분쟁에서 읽히는 것이 「누가 말했나」이고,
  /// 그 이름이 탈퇴로 사라지면 이의는 아무도 내지 않은 문장이 된다.
  claimAppealsFiled    ClaimAppeal[] @relation("ClaimAppealFiledBy")
  claimAppealsReviewed ClaimAppeal[] @relation("ClaimAppealReviewedBy")

  /// Stock movements this account made (TASK-0036). Withdrawal leaves them
  /// pointing here, which is why the edge is `Restrict` on the other side.
  stockMovements StockLedger[]

  /// 적립금 계좌 (TASK-0076). 있을 수도 없을 수도 있다 — 계좌는 처음 적립되거나
  /// 처음 조회될 때 생기고, 한 번도 산 적 없는 계정에 빈 계좌를 미리 만들어 두면
  /// 그 행이 뜻하는 것이 아무것도 없다.
  pointAccount PointAccount?

  /// 이 계정이 발급받은 쿠폰 (TASK-0072). 저쪽 끝이 `Restrict` 인 것은 발급 이력이
  /// 정산이 읽는 기록이기 때문이고, 탈퇴가 소프트 삭제라 참조가 끊기지 않는다.
  userCoupons UserCoupon[]

  /// 이 계정이 **발행한** 쿠폰 (TASK-0073). 위의 것과 방향이 반대다 — 저것은 받은
  /// 것이고 이것은 낸 것이다.
  ///
  /// 플랫폼 쿠폰에 소유자를 주는 유일한 방법이다. 판매자 쿠폰은 스토어가 주인이라
  /// 스코프가 닿을 곳이 있지만, 플랫폼 쿠폰에는 소유하는 스토어가 없어서 **누가
  /// 냈는가**말고는 「데모가 낸 것인가」에 답할 값이 없다.
  issuedCoupons Coupon[] @relation("CouponIssuer")

  /// 이 계정이 바꾼 수수료율 (TASK-0079 F5).
  commissionRates CommissionRate[] @relation("CommissionRateAuthor")

  /// 이 사람이 승인·지급·보류한 정산서 (TASK-0081). 탈퇴해도 이 참조는 끊기지 않는다.
  approvedSettlements Settlement[] @relation("SettlementApprover")

  /// 이 사람이 쓴 리뷰 (TASK-0083).
  reviews Review[]
  /// 이 사람이 「도움돼요」를 누른 리뷰 (TASK-0084).
  reviewHelpfuls ReviewHelpful[]
  /// 이 사람이 쓴 리뷰 답변 (TASK-0085).
  reviewReplies  ReviewReply[]
  /// 찜 · 최근 본 상품 · 팔로우 (M13). 전부 `Cascade` 다 — 온전히 그 사람의 것이고
  /// 남길 이력이 없다.
  wishlists      Wishlist[]
  recentlyViewed RecentlyViewed[]
  follows        SellerFollow[]
  /// 이 사람이 남긴 문의와 쓴 답변 (TASK-0088).
  questions      ProductQuestion[]
  answers        ProductAnswer[]
  /// 이 사람에게 온 알림 (TASK-0090).
  notifications  Notification[]
  /// 이 사람이 낸 신고와 처리한 신고 (TASK-0091).
  reports        Report[] @relation("ReportReporter")
  handledReports Report[] @relation("ReportHandler")
  paidSettlements     Settlement[] @relation("SettlementPayer")
  heldSettlements     Settlement[] @relation("SettlementHolder")

  /// Admin console looks accounts up by email.
  @@index([email])
  /// The expiry sweep: `WHERE "isDemo" AND "demoExpiresAt" < now()`.
  @@index([isDemo, demoExpiresAt])
}

/// A role granted to an account. Many rows per user — see {@link Role}.
model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  role      Role
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Granting the same role twice is a no-op, not a second row.
  @@unique([userId, role])
  /// "who are the admins" — a scan over every user would be the alternative.
  @@index([role])
}

/// A seller's store. One per account.
model Seller {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @db.Uuid

  brandName    String  @unique
  /// URL identifier for the storefront; separate from `brandName` so renaming
  /// the brand does not have to break every link that points at the store.
  slug         String  @unique
  introduction String?
  logoUrl      String?

  /// 팔로워 수 (TASK-0089 F3).
  ///
  /// **매번 세지 않는 이유는 브랜드관이 이 값을 그리기** 때문이다 — 페이지마다
  /// `SellerFollow` 를 세면 그 비용이 팔로워 수에 비례한다. 캐시라 어긋날 수 있고,
  /// 그 마지막 방어선이 `Seller_followerCount_check` 다.
  followerCount Int @default(0)

  status          SellerStatus @default(PENDING)
  /// Why the store was rejected or suspended, shown back to the seller.
  statusReason    String?
  statusChangedAt DateTime?

  /// 이 스토어에 걸린 수수료율은 {@link CommissionRate} 가 들고 있다 (TASK-0079).
  ///
  /// 한때 여기 `commissionRateBp` 컬럼이 있었다. 읽는 코드가 한 줄도 없는 채로
  /// 남아 있었고, 남겨 두는 것이 함정이었다 — 누군가 그 칸을 채우면 아무 일도
  /// 일어나지 않는다. 요율에는 **적용 기간과 변경 이력**이 있어야 하고(F5), 그것을
  /// 컬럼 하나로는 표현할 수 없다.

  /// 이 판매자의 기본 배송비 (TASK-0049 4.1).
  ///
  /// 배송비는 `SellerOrder` 단위로 붙는다(D-023 · `pricing.md` 1장 ④). 값이 놓일
  /// 자리를 여기서 만드는 이유는 주문이 그것 없이 계산될 수 없기 때문이고, 바꾸는
  /// **화면**은 M09 다. 그때까지는 전부 플랫폼 기본값이다.
  shippingFee Int @default(3000)

  /// 이 금액 이상이면 무료. `null` 이면 무료 조건이 **없다**.
  ///
  /// `0` 과 다르다 — `0` 은 「0원 이상이면 무료」, 즉 언제나 무료다. 판정 기준은
  /// 상품금액에서 쿠폰 할인을 뺀 값이다(`pricing.md` 1장, 2026-09-05 결정).
  freeShippingThreshold Int?

  /// Optimistic lock (DECISIONS 4). Two people edit this row — the seller
  /// changes brand copy while an operator approves or suspends the store — and
  /// last-write-wins would quietly revert one of them.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`, unlike the personal tables below: a store carries products,
  /// orders and settlements, so removing its owner must fail loudly rather than
  /// cascade through the catalogue.
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  products     Product[]
  sellerOrders SellerOrder[]

  /// 이 가게가 낸 쿠폰 (TASK-0072). `Restrict` 인 이유는 정산(M12)이 「판매자 부담
  /// 쿠폰」을 이 정책으로 읽기 때문이다.
  coupons Coupon[]

  /// The operator queue: pending applications first.
  @@index([status])

  /// 이 스토어에 걸린 수수료율의 이력 (TASK-0079).
  commissionRates CommissionRate[]

  /// 이 스토어의 정산서 (TASK-0080).
  settlements Settlement[]

  /// 이 스토어가 쓴 리뷰 답변 (TASK-0085).
  reviewReplies ReviewReply[]
  /// 이 스토어를 팔로우한 사람들 (TASK-0089). 수는 `followerCount` 가 들고 있다.
  followers     SellerFollow[]
  statusHistory SellerStatusHistory[]
  /// 이 스토어가 쓴 문의 답변 (TASK-0088).
  productAnswers ProductAnswer[]
}

/// An entry in a user's address book.
///
/// Orders snapshot the recipient (`docs/design/erd.md` 4), so nothing points at
/// this row and it can be deleted for real — which is also what makes purging a
/// withdrawn account's personal data possible without breaking order history.
model Address {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// User-supplied nickname such as "집" or "회사".
  label         String?
  recipientName String
  phone         String

  /// Korean five-digit postal code.
  postalCode   String
  addressLine1 String
  addressLine2 String?

  /// At most one per user, enforced by the partial unique index
  /// `Address_userId_default_key`. Application-level checking is not enough:
  /// two concurrent "make this the default" requests both read zero defaults
  /// and both write one.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address book listing. The partial index above only covers the default
  /// row, so it cannot serve this query.
  @@index([userId])
}

/// Per-account display and notification settings.
///
/// Keyed by `userId` instead of carrying an id of its own: the relation is
/// one-to-one, and a surrogate key would allow a second row to exist.
model UserPreference {
  userId String @id @db.Uuid

  density  DisplayDensity @default(STANDARD)
  /// BCP 47 tag. Korean first, but the column exists from the start so that
  /// adding a locale later is data rather than a migration (DECISIONS 1).
  locale   String         @default("ko-KR")
  /// ISO 4217. Amounts are integer minor-unit values; this says of what.
  currency String         @default("KRW")

  /// In-app notification centre only — email and push are out of scope
  /// (DECISIONS 8), so these are the switches that actually do something.
  notifyOrder     Boolean @default(true)
  notifyClaim     Boolean @default(true)
  notifyMarketing Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One issued refresh token.
///
/// The token itself is never stored — `tokenHash` holds a digest, so a dump of
/// this table cannot be replayed as a session. Rotation and reuse detection are
/// TASK-0022; what this table has to get right now is that a session belongs to
/// exactly one app.
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// Which front-end this session belongs to. A SHOP token presented to the
  /// admin API is rejected by a lookup that filters on this column.
  app ClientApp

  /// Digest of the token, not the token.
  tokenHash String @unique

  expiresAt DateTime
  /// Set on logout and on rotation; a revoked row is kept so that a replay can
  /// still be recognised instead of merely missing.
  revokedAt DateTime?

  /// Shown in a "signed-in devices" list, and the only way to tell two sessions
  /// of the same app apart.
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "this user's sessions on this app" — issue, list and revoke all use it.
  @@index([userId, app])
  /// The sweep that deletes expired rows.
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalogue — the category tree (TASK-0028)
//
// The invariants of a tree are not something an application layer can hold on
// its own: two concurrent requests both read a consistent tree, both decide
// their change is legal, and both write. So the shape of the tree is stated to
// the database instead, in the migration:
//
//   Category_id_path_key            (id, path) — the target of the edge below
//   Category_parentId_parentPath_fkey  (parentId, parentPath) -> (id, path)
//   Category_path_shape_check       path = parentPath || id || '/'
//   Category_parent_pairing_check   parentId and parentPath are both set or neither
//   Category_depth_path_check       depth = number of ids in path
//   Category_depth_range_check      1 <= depth <= 3
//   Category_slug_active_key        one live category per slug
//
// Together the first three make a cycle **unrepresentable**: every node's path
// is its parent's path plus its own id, so a path is strictly longer than its
// parent's, and a cycle would need a node whose path is longer than itself.
// Depth then follows from the path, and the range check caps the tree at three
// levels no matter which request wrote the row.
//
// Attribute definitions (TASK-0030) hang off the same tree and add five more
// hand written rules, for the same reason:
//
//   AttributeDefinition_categoryId_key_active_key  one live definition per key
//   AttributeDefinition_key_format_check           the key is a JSONB/filter identifier
//   AttributeDefinition_options_check              options exist iff the type has them
//   AttributeDefinition_option_blank_check         no empty option label
//   AttributeDefinition_label_check                the label is not blank
//   AttributeDefinition_sortOrder_check            a position, never negative
//
// What the database deliberately does **not** enforce is uniqueness of a key
// across a whole *lineage* — that question needs a lookup in other rows, and a
// CHECK constraint may not contain a subquery. It is held by the service under
// the tree advisory lock instead (TASK-0030 4.2), which is why that rule has a
// concurrency spec and these six do not.
// ---------------------------------------------------------------------------

/// One node of the category tree.
model Category {
  /// A short integer, unlike the UUIDv7 of every account-side table.
  ///
  /// Deliberate (`docs/design/erd.md` 1): `path` concatenates ancestor ids into
  /// a string that is read on every catalogue query, so the ids have to stay
  /// short — and a category id is platform data that never travels in a token,
  /// so nothing leaks by being sequential.
  ///
  /// **Ids are never reused.** Deleting category 5 leaves 5 vacant forever; a
  /// reused id would make `categoryId: 5` in an old order snapshot, log line or
  /// search document point at a different category, and nothing would notice.
  id Int @id @default(autoincrement())

  parentId Int?

  /// Materialised path of ancestors, always ending in this node's own id:
  /// `/1/5/12/`. One `LIKE '/1/5/%'` returns an entire subtree, which is what
  /// this column exists for — the adjacency list alone needs recursion.
  ///
  /// Written by `CategoryService` and **verified by the database**: the checks
  /// listed above tie it to `parentPath`, to `id` and to `depth`, so a path that
  /// disagrees with the tree cannot be committed by any code path.
  path String

  /// `path` with the trailing `<id>/` removed; NULL for a root.
  ///
  /// It exists so that the parent edge can be a *composite* foreign key on
  /// `(parentId, parentPath)`. A plain `parentId` reference would let the path
  /// cache drift from the real parent; this way the database refuses the drift.
  parentPath String?

  /// 1 for a root, capped at 3 (`Category_depth_range_check`). Derived from
  /// `path` and kept as a column so that "roots first" is an index-ordered read
  /// rather than a computation over every row.
  depth Int

  name String
  /// URL identifier. Unique among live categories only
  /// (`Category_slug_active_key`) — a deleted category must not hold its slug
  /// hostage, exactly as a withdrawn account does not hold its Google identity.
  slug String

  /// Display order among siblings. Gaps are left alone: it is a presentation
  /// value, not an identity, and renumbering on every delete would rewrite rows
  /// nobody asked to change.
  sortOrder Int @default(0)

  /// Hidden from the storefront while staying a valid target for existing
  /// products. Deletion is `deletedAt`; neither ever frees the id.
  isActive Boolean @default(true)

  /// Optimistic lock for the fields a person edits — name, slug, activation
  /// (DECISIONS 4). Structural changes (move, reorder) do not touch it: they
  /// are serialised by an advisory lock instead, and telling an editor their
  /// rename conflicts because someone reordered siblings would be noise.
  version Int @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// `NoAction` rather than the default `Cascade` on update: moving a subtree
  /// rewrites the parent and all of its descendants in **one** statement, and
  /// `NO ACTION` is checked when that statement ends — by which time the whole
  /// subtree is consistent again. `Restrict` would refuse mid-statement, and
  /// `Cascade` would rewrite `parentPath` without `path`, breaking the shape
  /// check.
  parent   Category?  @relation("CategoryTree", fields: [parentId, parentPath], references: [id, path], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  attributes AttributeDefinition[]
  products   Product[]

  /// Target of the composite parent edge above.
  @@unique([id, path])
  /// Sibling listing and reordering.
  @@index([parentId, sortOrder])
  /// Subtree reads are `path LIKE '/1/5/%'`. The operator class is required:
  /// the database collation is `en_US.utf8`, and a default btree index cannot
  /// serve a prefix match under a non-C collation.
  @@index([path(ops: raw("text_pattern_ops"))])

  /// 이 카테고리의 수수료율 이력 (TASK-0079).
  commissionRates CommissionRate[]
}

/// What kind of value an attribute holds (TASK-0030 2장).
///
/// Five, and closed on purpose. Every one of them has to be expressible as a
/// zod schema built at runtime from a row of {@link AttributeDefinition} *and*
/// as a Meilisearch filter later (M06), so a type nobody can filter on would be
/// a definition the storefront cannot use. Adding one is a migration plus a
/// branch in `src/catalog/attribute-schema.ts`, which is exactly the visibility
/// this list is for.
enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// One attribute a category — and everything under it — may carry.
///
/// This is the table half of "카테고리·속성은 코드 수정 없이 추가·설정 가능"
/// (DECISIONS 1). The **definitions** are rows so that the product form and the
/// search filters can be generated from them; the **values** are a JSONB column
/// on `Product`, so that listing twenty products costs no joins
/// (`docs/design/erd.md` 2 — 속성을 정의/값으로 나눈 이유).
///
/// The price of that split is that the database cannot check a single value.
/// `src/catalog/attribute-schema.ts` builds a zod schema from these rows on
/// every save, and it is the only thing standing between a typo and a product
/// whose `attributes` nothing can read.
model AttributeDefinition {
  /// Sequential like `Category.id` and for the same reason: it is platform data
  /// that never travels in a token, and it is read on every catalogue write.
  id Int @id @default(autoincrement())

  /// The category this definition is attached to. It applies to that category
  /// **and to everything below it** — resolution walks the ancestors of the
  /// target through `Category.path` (TASK-0030 4.3).
  categoryId Int

  /// Identifier of the value inside `Product.attributes`, e.g. `material`.
  ///
  /// Held to `^[a-z][a-z0-9_]{0,39}$` by `AttributeDefinition_key_format_check`,
  /// because this string is simultaneously a JSON object key and a Meilisearch
  /// filter field name. A key with a dot or a space parses as a path expression
  /// on the search side and quietly matches nothing.
  ///
  /// Unique per category among live rows
  /// (`AttributeDefinition_categoryId_key_active_key`). Uniqueness across a
  /// whole lineage is a rule the database cannot state — see the header above.
  key String

  /// What a person sees. Korean by default; the message-file split
  /// (DECISIONS 1) applies to UI chrome, not to operator-entered data.
  label String

  type AttributeType

  /// Choices for `SELECT` and `MULTI_SELECT`, empty for the other three.
  ///
  /// `AttributeDefinition_options_check` states exactly that, in both
  /// directions: a `SELECT` without options can never validate any value and
  /// would make a required attribute permanently unsatisfiable, while options
  /// on a `BOOLEAN` are a definition whose author meant something else.
  ///
  /// Duplicates inside the array are refused by the service, not by the
  /// database: telling duplicates from distinct values needs an aggregate, and
  /// a CHECK may not contain one.
  options String[] @default([])

  /// Whether a product in this category must carry the attribute.
  isRequired Boolean @default(false)

  /// Whether the attribute becomes a search facet (M06). Stored from the start
  /// so that turning a facet on is data rather than a migration.
  isFilterable Boolean @default(false)

  /// Display order within the category that owns the definition. Inherited
  /// attributes always sort before the ones defined further down, so a form
  /// reads from the general to the specific.
  sortOrder Int @default(0)

  /// Optimistic lock (DECISIONS 4). An operator edits the label while another
  /// widens the options; last-write-wins would silently drop one of them.
  version Int @default(0)

  /// Soft delete, like `Category`. The row survives so that a product still
  /// carrying the key has something to explain it, and the partial unique index
  /// lets the key be defined again.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: a category is never hard deleted (its own removal is
  /// `deletedAt`), so this edge exists to refuse the delete nobody wrote —
  /// a `Cascade` here would let a stray `DELETE FROM "Category"` take the
  /// definitions with it and leave every product's `attributes` unexplainable.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The lineage conflict check filters by key first: "does any ancestor or
  /// descendant already define `material`?" (TASK-0030 4.2).
  ///
  /// The other query — `categoryId = ANY(ancestor ids) AND deletedAt IS NULL`,
  /// which resolves an inherited set in one statement — needs no index of its
  /// own: `AttributeDefinition_categoryId_key_active_key` already leads with
  /// `categoryId` and carries `WHERE "deletedAt" IS NULL` as its predicate, so
  /// it is a **better** match than a plain `(categoryId, sortOrder)` would be.
  /// A second index over the same prefix would be write amplification that no
  /// read benefits from; the display order is a sort over a handful of rows the
  /// application does in memory. Verified by the `EXPLAIN` in
  /// `test/api/attributes-performance.spec.ts` (gate S3).
  @@index([key])
}

// ---------------------------------------------------------------------------
// Catalogue — products, options and variants (TASK-0032)
//
// Three tables carry the model: what is sold (`Product`), the axes a buyer
// chooses along (`ProductOption` / `ProductOptionValue`) and the thing that has
// a price and a stock level (`ProductVariant`). The unit of both is the variant
// (D-024), never the product — which is why a product with no options still
// gets one.
//
// The invariants of a combination cannot be held by an application on its own,
// for the same reason a tree's cannot: two requests each read a consistent
// product, each decide their change is legal, and both write. So the shape is
// stated to the database, in the migration:
//
//   Product_id_sellerId_key            (id, sellerId) — target of the edge below
//   ProductVariant_seller_sku_key      one live SKU per seller
//   ProductVariant_product_signature_key  one live variant per combination
//   VariantOptionValue_variantId_optionId_key  one value per option per variant
//   VariantOptionValue_*_fkey          composite edges tying a mapping to one product
//   *_check                            money, quantity and rating invariants
//
// Together the composite edges make a *cross-product* mapping unrepresentable:
// a `VariantOptionValue` carries the product id, and both the variant it
// belongs to and the option it names have to agree with it. The signature index
// then makes a duplicate combination — and a second variant on an optionless
// product — impossible rather than merely refused.
//
// What the database deliberately does **not** enforce is that
// `ProductVariant.optionSignature` agrees with the mapping rows, and that
// `Product.minPrice` equals the real minimum: both need an aggregate over other
// rows, which a CHECK may not contain. They are held by `ProductService` inside
// the transaction that writes them, under a row lock on the product
// (TASK-0032 4.3, 4.6, 4.7) — which is why those two rules have a concurrency
// spec and the ones above do not.
// ---------------------------------------------------------------------------

/// Where a listing is in its life (TASK-0032 4.9).
///
/// `SUSPENDED` is the site operator's forced hide and is the reason this is an
/// enum rather than a boolean pair: a seller may move between the first three
/// and may not touch the fourth, and a column that cannot express "hidden by
/// somebody else" would make that rule unstateable.
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// One listing: a seller's product in one category.
///
/// Identifiers are UUIDv7, unlike `Category`'s short integers and for the
/// opposite reason (`docs/design/erd.md` 2): a product id travels in a public
/// URL, where a sequential number would publish how many products exist and how
/// fast they arrive, and invite enumeration. v7 keeps the time prefix so inserts
/// still land at the right edge of the B-tree.
model Product {
  id String @id @default(uuid(7)) @db.Uuid

  /// The store that sells it. `Restrict`, like `Seller`'s own edge to `User`:
  /// a store carries orders and settlements, so removing it must fail loudly
  /// rather than take the catalogue with it.
  sellerId String @db.Uuid

  /// Which category's attribute definitions apply (TASK-0030 4.3).
  categoryId Int

  name        String
  description String?

  /// Starts as `DRAFT`: `Product_active_price_check` requires a live price
  /// before a listing may go on sale, and the price is not known until the
  /// variants exist. `ProductService` sets the requested status in the same
  /// statement that recomputes `minPrice`.
  status ProductStatus @default(DRAFT)

  /// Attribute **values**, keyed by `AttributeDefinition.key`.
  ///
  /// JSONB rather than rows so that listing twenty products costs no joins
  /// (`docs/design/erd.md` 2). The price of that is stated in the same place:
  /// the database cannot check a single value, and
  /// `AttributeService.validateAttributes` is the only thing that can. What the
  /// database *does* hold is that this is an object at all
  /// (`Product_attributes_object_check`) — a JSONB column would otherwise
  /// accept `[]` or `"소재"` and every reader would have to guard.
  attributes Json @default("{}")

  /// Default cap on one order's quantity; `null` is no cap (TASK-0032 4.1).
  /// A variant may override it, and `resolvePurchaseLimit` is the single place
  /// that decides which of the two wins.
  maxPurchaseQuantity Int?

  /// Lowest price among the variants a buyer can actually order.
  ///
  /// Derived, never accumulated: it is recomputed from the variants in one
  /// statement on every write (TASK-0032 4.6). An incremental update is wrong
  /// the moment a price goes **up** — the cheapest variant becoming dearer has
  /// to raise this value, and a `min(old, new)` never does.
  ///
  /// `NULL` when nothing is sellable, and `Product_active_price_check` then
  /// refuses `ACTIVE`.
  minPrice Int?

  /// Average review score **times 100** (0–500), so 4.35 stars is `435`.
  ///
  /// An integer because there is no floating point column anywhere in this
  /// schema and this is not the place to introduce the first one: the guard in
  /// `schema-guards.spec.ts` exists so that money can never quietly become a
  /// `Float`, and an exception for a rating is how that guard stops meaning
  /// anything. Filled by M13; `Product_rating_check` keeps it paired with the
  /// count so that "no reviews" reads the same from either column.
  ratingAvg   Int @default(0)
  ratingCount Int @default(0)

  /**
   * 관리자가 강제로 내린 시각과 사유 (TASK-0095 F2 · F3).
   *
   * 내리는 **동작**은 신고 처리와 같다 — `status` 를 `SUSPENDED` 로 두어 판매를
   * 멈춘다(`report.service.ts`). 다른 것은 **근거가 어디 있는가**다: 신고를 통한
   * 숨김은 신고 행이 사유와 처리자를 들고 있지만, 관리자가 직접 내리는 데에는
   * 가리킬 행이 없다. 그래서 여기 적는다.
   *
   * 이력 표가 아닌 이유는 이 TASK 에 이력 기준이 없어서다 — 필요해지면 그때
   * `SellerStatusHistory` 와 같은 모양으로 따로 만든다. 지금 만들면 상품 상태가
   * 자주 바뀌는 표에 판매자의 평범한 등록·수정까지 쌓인다.
   */
  moderatedAt     DateTime?
  moderationReason String?
  moderatedById   String?  @db.Uuid

  /// Confirmed purchases, for "많이 팔린 순". Written by M09's confirmation step.
  salesCount Int @default(0)

  /// Optimistic lock (DECISIONS 4). Two people edit a listing — the seller
  /// writes copy while an operator hides it — and last-write-wins would revert
  /// one of them silently. `ProductService` takes a row lock **before** reading
  /// this, so the version it compares is the committed one (TASK-0032 4.7).
  version Int @default(0)

  /// Soft delete. An order item points at a variant of this product forever, so
  /// the row is never physically removed and the id is never reused.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images   ProductImage[]
  /// 이 상품의 리뷰 (TASK-0083). `ratingAvg`·`ratingCount` 가 이것의 요약이다.
  reviews  Review[]
  /// 이 상품을 담아 둔 사람들 · 최근에 본 사람들 (TASK-0086 · 0087).
  wishlists      Wishlist[]
  recentlyViewed RecentlyViewed[]
  /// 이 상품에 대한 문의 (TASK-0088).
  questions      ProductQuestion[]
  options  ProductOption[]
  variants ProductVariant[]

  /// Target of `ProductVariant`'s composite edge: it carries `sellerId` so that
  /// "one live SKU per seller" can be an index, and this is what stops that
  /// copy from ever disagreeing with the product it belongs to.
  ///
  /// The two read paths — the seller console's list and the category listing —
  /// are served by **partial** indexes written by hand in the migration
  /// (`WHERE "deletedAt" IS NULL`), which PSL cannot express. Declaring plain
  /// ones here as well would put two indexes on the same leading column and
  /// make every write pay for a read that never uses them (the lesson of
  /// TASK-0030's removed `(categoryId, sortOrder)`).
  @@unique([id, sellerId])
}

/// One picture of a product, in display order.
///
/// Hard deleted, unlike everything else here: nothing points at an image row —
/// an order snapshot copies the URL as a string — and an editor that replaces
/// the gallery should not leave a growing tail of retired rows behind.
model ProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid

  /// Public URL in the object store (TASK-0011). Not a key: the bucket layout
  /// is the storage module's business, and an order snapshot needs something it
  /// can render years later without asking anybody how to build a URL.
  url String
  /// Alternative text. Nullable because the seller may not have written one;
  /// the storefront falls back to the product name rather than to an empty alt.
  alt String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The gallery, in order. No unique on `(productId, sortOrder)`: reordering
  /// rewrites several rows in one statement and a non-deferrable unique index
  /// is checked per row, so the intermediate state would be refused.
  @@index([productId, sortOrder])
}

/// One axis a buyer chooses along — 색상, 사이즈.
///
/// Soft deleted like everything a variant's combination is built from: an order
/// snapshot has to stay explainable, and "이 주문의 옵션이 무엇이었나" is a
/// question about rows that may no longer be on sale.
model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid

  name      String
  sortOrder Int    @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// `Restrict`: a product with options is not hard deletable. Its removal is
  /// `deletedAt`, so this edge exists to refuse the delete nobody wrote.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  values   ProductOptionValue[]
  variants VariantOptionValue[]

  /// Target of `VariantOptionValue`'s composite edge — the half that keeps a
  /// mapping inside one product.
  ///
  /// No `(productId, sortOrder)` index: the partial unique
  /// `ProductOption_product_name_key` already leads with `productId` and
  /// carries `deletedAt IS NULL` as its predicate, so it is the better match
  /// for "this product's live options" — and ordering a handful of rows is done
  /// in memory.
  @@unique([id, productId])
}

/// One choice on an axis — 블랙, M.
model ProductOptionValue {
  id       String @id @default(uuid(7)) @db.Uuid
  optionId String @db.Uuid

  value String

  /// Presentation extras the storefront reads — a colour chip's hex, a size
  /// chart's measurements. JSONB and deliberately unmodelled: it is display
  /// data, it differs per axis, and giving each kind a column would make adding
  /// one a migration.
  meta Json?

  sortOrder Int @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  variants VariantOptionValue[]

  /// Target of `VariantOptionValue`'s composite edge: a mapping names both the
  /// value and its option, and this is what stops the two from disagreeing.
  /// `ProductOptionValue_option_value_key` covers the read, as on
  /// {@link ProductOption}.
  @@unique([id, optionId])
}

/// A sellable SKU: the unit of price and of stock (D-024).
///
/// Exists even when the product has no options — one variant with an empty
/// combination — so that nothing downstream needs a branch for "a product you
/// order directly" (DECISIONS 3).
model ProductVariant {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid

  /// Copied from the product so that "one live SKU per seller" can be a unique
  /// index. It cannot drift: `(productId, sellerId)` is a **composite foreign
  /// key** onto `Product (id, sellerId)`, exactly as `Category.parentPath` is
  /// tied to its parent.
  sellerId String @db.Uuid

  /// The seller's own stock keeping unit. Unique per seller among live rows
  /// (`ProductVariant_seller_sku_key`), not globally: two stores naming a
  /// variant `TSHIRT-BLACK-M` is a coincidence, not a conflict.
  sku String

  /// Selling price in whole KRW. An **absolute** value, never "base + delta":
  /// a discount applied to a delta has no unambiguous target, and an order
  /// snapshot of an absolute price is one integer rather than a formula whose
  /// inputs may since have changed (TASK-0032 4.4).
  price Int

  /// The struck-through price, when there is one. `NULL` means "no discount".
  /// `ProductVariant_list_price_check` keeps it at or above `price`, because a
  /// negative discount renders as a percentage with the sign lost.
  listPrice Int?

  /// On-hand quantity. The **current value**; the ledger that explains how it
  /// got there is `StockLedger` (TASK-0036) and hangs off this row's id.
  /// Available stock is this minus live reservations (`docs/design/erd.md` 3),
  /// and the conditional update that guards it needs the `>= 0` check below.
  stock Int @default(0)

  /// 지금 잡혀 있는 수량 — `HELD` 예약의 합 (TASK-0048).
  ///
  /// 캐시 컬럼이다. 매번 예약 표를 합산하면 상품 조회마다 그 합계가 따라붙는다.
  /// 대신 **예약 생성이 이 컬럼에 대한 조건부 갱신**이 되고, 그것이 오버셀을
  /// 구조적으로 막는 지점이다 —
  /// `UPDATE … SET reserved = reserved + n WHERE stock - reserved >= n` 은 한
  /// 문장이라 두 요청이 동시에 통과할 수 없다.
  ///
  /// 가용재고는 `stock - reserved` 다. `stock` 은 예약으로 줄지 않는다 — 줄여
  /// 버리면 확정 때 다시 줄여야 하는지 아닌지를 매번 따져야 하고, 원장의 합과
  /// `stock` 이 어긋난다.
  reserved Int @default(0)

  /// Overrides the product's cap; `null` inherits it (TASK-0032 4.1).
  maxPurchaseQuantity Int?

  /// Whether this combination can be ordered. A product may sell 블랙/S and not
  /// 블랙/XL; the combination still exists so that the option grid can grey the
  /// second one out instead of pretending it was never offered.
  isActive Boolean @default(true)

  /// Canonical form of the combination: the option value ids, sorted, joined by
  /// `/`. Empty for a product with no options.
  ///
  /// It exists so that "one live variant per combination" can be an index
  /// (`ProductVariant_product_signature_key`). Without it, duplicate
  /// combinations are only refusable by an application check that two
  /// concurrent writers both pass — and the symptom is a storefront showing a
  /// different price on every refresh, because two rows answer the same query.
  ///
  /// Its agreement with the `VariantOptionValue` rows is **not** something the
  /// database can state: telling them apart needs an aggregate and a CHECK may
  /// not contain one. `ProductService` writes both in one transaction.
  optionSignature String @default("")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Composite: the variant's product **and** the seller copy above.
  product Product @relation(fields: [productId, sellerId], references: [id, sellerId], onDelete: Restrict)

  optionValues VariantOptionValue[]

  /// Every movement of this variant's stock (TASK-0036). `stock` above is the
  /// current value; these rows are what explain it, and `StockService` is the
  /// only thing that writes either.
  ledger       StockLedger[]
  cartItems    CartItem[]
  /// 이 Variant 에 걸린 예약들 (TASK-0048).
  reservations StockReservation[]
  orderItems   OrderItem[]

  /// Target of `VariantOptionValue`'s composite edge. Reading a product's live
  /// variants is served by `ProductVariant_product_signature_key`, which leads
  /// with `productId` and is already restricted to live rows.
  @@unique([id, productId])
  /// Target of `CartItem`'s composite edge (TASK-0045).
  ///
  /// A cart row copies `sellerId` so that grouping by store needs no join, and
  /// this is what ties the copy to the variant's own seller — a row naming a
  /// different store cannot be written at all. The same device
  /// `VariantOptionValue` uses for its product and option copies.
  @@unique([id, sellerId])
}

/// Which option value a variant carries on one axis.
///
/// The join table of the combination, and the place three composite foreign
/// keys meet (TASK-0032 4.3). `optionId` and `productId` are copies — of the
/// value's own option and of the variant's own product — and each is tied back
/// to its source by an edge, so a mapping that names another product's option,
/// or an option the value does not belong to, cannot be written at all.
model VariantOptionValue {
  variantId     String @db.Uuid
  optionValueId String @db.Uuid
  optionId      String @db.Uuid
  productId     String @db.Uuid

  /// `NoAction` on every edge, which is what this table wants anyway.
  ///
  /// `NO ACTION` refuses a delete that would orphan a mapping, exactly as
  /// `RESTRICT` does — a variant, an option and an option value are all removed
  /// with `deletedAt`, so an edge that let one of them vanish underneath a
  /// mapping would be a path nobody wrote. The difference is *when* the check
  /// runs: `NO ACTION` is verified at the end of the statement, so a rewrite
  /// that removes a mapping and its value together is legal while `RESTRICT`
  /// would refuse it halfway — the same reason `Category`'s parent edge is
  /// `NO ACTION` on update.
  ///
  /// It is also the only thing Prisma will emit here: `productId` takes part in
  /// two of these relations and `optionId` in two, and a scalar shared by two
  /// relations may not carry a referential action.
  variant     ProductVariant     @relation(fields: [variantId, productId], references: [id, productId], onDelete: NoAction, onUpdate: NoAction)
  option      ProductOption      @relation(fields: [optionId, productId], references: [id, productId], onDelete: NoAction, onUpdate: NoAction)
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: NoAction, onUpdate: NoAction)

  @@id([variantId, optionValueId])
  /// One value per axis per variant. A variant that was 블랙 *and* 화이트 would
  /// make "which colour did I order" unanswerable.
  @@unique([variantId, optionId])
  /// The reverse read: which variants carry 블랙 — the option grid's query.
  @@index([optionValueId])
}

// ---------------------------------------------------------------------------
// Stock ledger (TASK-0036)
//
// `ProductVariant.stock` is the current value; this table is what explains it.
// CLAUDE.md 6장 — "잔액이 있는 것은 원장 테이블을 둔다. 현재값은 원장의
// 결과이며 대사가 가능해야 한다" — turns into four checkable statements
// (TASK-0036 4.1), and everything below exists to make them hold:
//
//   L1  stock = SUM(quantity)                     for every variant
//   L2  balanceAfter(n) = balanceAfter(n-1) + quantity(n)
//   L3  the last row's balanceAfter = stock
//   L4  seq runs 1..n with no gaps
//
// What the database is asked to guarantee lives in the migration:
//
//   StockLedger_pkey                 (variantId, seq) — one row per position
//   StockLedger_ref_key              one movement per (variant, type, ref)
//   StockLedger_direction_check      the type decides the sign
//   StockLedger_ref_pair_check       refType and refId arrive together
//   StockLedger_reason_check         an ADJUST states why
//   StockLedger_append_only          a trigger: rows are never edited or removed
//
// **L1 to L4 are not among them.** Each needs an aggregate over other rows and
// a CHECK may not contain one, so they are held by `StockService` inside the
// transaction that writes them, under a row lock on the variant (TASK-0036 4.6,
// 4.12) — which is why those four rules have a concurrency spec and a negative
// control, and the ones above do not.
// ---------------------------------------------------------------------------

/// What moved the stock (TASK-0036 4.3).
///
/// The type decides the **sign**, and `StockLedger_direction_check` enforces
/// that: a `SALE` that adds stock is not a mistake to be corrected later, it is
/// a row that makes every reader of the ledger wrong. `ADJUST` is the only
/// two-way type, and it is the only one obliged to carry a reason.
enum StockLedgerType {
  /// Goods received. Also the opening balance of a newly created variant, which
  /// is what keeps L1 true from the moment a product is registered (4.1).
  INBOUND
  SALE
  CANCEL
  RETURN_IN
  /// A reservation turning into a real decrement (M07).
  RESERVE_CONFIRM
  /// A human's correction. Reason required.
  ADJUST
}

/// Which table `StockLedger.refId` points at.
///
/// An enum rather than free text even though none of these tables exists yet:
/// the reference is what makes a movement **idempotent**
/// (`StockLedger_ref_key`), and a typo in a free string would slip past that
/// index silently — the retry would be recorded a second time and nothing in
/// the ledger would look wrong. The three names come from `docs/design/erd.md`
/// 3·4·5, so they are already decided rather than guessed.
enum StockRefType {
  ORDER_ITEM
  STOCK_RESERVATION
  CLAIM_ITEM
}

/// One movement of one variant's stock. Append-only.
///
/// There is no `id` and no `updatedAt`, and both absences are deliberate. The
/// identity of a row is **its position in the variant's history**, and a table
/// that is never updated has no honest use for an update timestamp.
model StockLedger {
  variantId String @db.Uuid

  /// This movement's position in the variant's history, starting at 1.
  ///
  /// Computed as `previous max + 1` **while holding the variant's row lock**,
  /// which is what makes it the order the movements really happened in — a
  /// UUIDv7 would tie randomly inside one millisecond and the balance chain
  /// would render backwards (TASK-0036 4.2).
  ///
  /// It is also the net: a row inserted without the lock either collides with
  /// the primary key or leaves a gap, and `StockService.reconcile` counts gaps
  /// (L4). A global sequence could do neither.
  seq Int

  type StockLedgerType

  /// Signed, never zero. `+5` is five in, `-3` is three out.
  ///
  /// The sign is not a caller's choice: `StockLedger_direction_check` ties it to
  /// {@link StockLedgerType}. Zero is refused because a movement of nothing is
  /// not a movement, and a row carrying one would occupy a `seq` that L4 then
  /// counts as history.
  quantity Int

  /// `ProductVariant.stock` immediately after this movement.
  ///
  /// Stored rather than derived so that "how much was on hand at this point"
  /// costs one row instead of a sum from the beginning of time, and so that
  /// reconciliation can find *where* a ledger broke rather than only that it
  /// did (TASK-0036 4.1 L2·L3).
  balanceAfter Int

  /// What caused it, when something did. Both columns are present or both are
  /// absent (`StockLedger_ref_pair_check`) — half a reference can neither be
  /// followed nor used as an idempotency key.
  refType StockRefType?
  refId   String?       @db.Uuid

  /// Why, in the operator's words. Required for `ADJUST`
  /// (`StockLedger_reason_check`): every other type is explained by its own
  /// name, while a correction is a human judgement and an unexplained one
  /// cannot be audited.
  reason String?

  /// Who did it; `null` for a movement the system made on its own.
  ///
  /// `Restrict`, like every other edge into `User`: an account is withdrawn
  /// with `deletedAt` and the row stays behind precisely so that history keeps
  /// pointing at something.
  actorId String? @db.Uuid

  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// The position, and the index every read uses.
  ///
  /// `variantId = ? ORDER BY seq DESC` is the whole read pattern — the history
  /// page and its cursor — so no second index is declared. Adding one on
  /// `(variantId, createdAt)` would put two indexes on the same leading column
  /// and make every write pay for a read that never happens: `seq` is monotonic
  /// in time within a variant, so it already orders chronologically (the lesson
  /// of TASK-0030's removed `(categoryId, sortOrder)`).
  @@id([variantId, seq])
}

/// What a search-index event asks the worker to do.
///
/// Two verbs, not five. "생성 · 수정 · 재고 변동 · 가격 변동" all end in the same
/// place — the document is rebuilt from the row as it is *now* — so recording
/// which of them happened would be recording something no consumer reads
/// (TASK-0038 4장). `REMOVE` is separate because there is no row left to read.
enum SearchOutboxKind {
  UPSERT
  REMOVE
}

/// A search-index change that has not been applied yet (TASK-0038 4장).
///
/// **Why an outbox and not a direct call.** Putting the index write inside the
/// product transaction makes a search-engine outage stop product registration;
/// putting it outside leaves a ghost document when the transaction rolls back.
/// A row written *in* the transaction and applied *after* it avoids both: the
/// event exists exactly when the product change does, and the engine is reached
/// on somebody else's time.
///
/// **The table is a queue, so a processed row is deleted.** Keeping them would
/// grow a table nobody reads to answer a question nobody asks — the ledger of
/// what was indexed is the index itself. What is kept is a row that has *not*
/// succeeded yet, which is also what "대기 건수" on `/health` counts.
model SearchOutbox {
  id BigInt @id @default(autoincrement())

  /// The listing whose document is stale. Not a foreign key — see below.
  productId String @db.Uuid

  kind SearchOutboxKind

  /// How many times the worker has tried and failed.
  ///
  /// Kept on the row rather than in the worker so that a restart does not reset
  /// everybody's backoff to zero, which is how a failing event becomes a hot
  /// loop against a search engine that is already struggling.
  attempts Int @default(0)

  /// When the worker may try again. Now, until a failure pushes it out.
  nextAttemptAt DateTime @default(now())

  /// The last failure, for somebody reading the queue at 3am.
  lastError String?

  createdAt DateTime @default(now())

  /// The queue's read: `WHERE nextAttemptAt <= now() ORDER BY nextAttemptAt`.
  ///
  /// One index, on the column the worker filters *and* orders by. `productId`
  /// gets none: the worker collapses duplicates in memory over a batch it has
  /// already read, and a second index would make every product write pay for a
  /// lookup that never happens.
  @@index([nextAttemptAt])
}

/// What people searched for (TASK-0039 「검색어 로깅」).
///
/// **No account, on purpose.** The task wants this for 인기 검색어 — an
/// aggregate — and a row that named who typed it would be a search history: a
/// far more sensitive thing to hold, for a use nobody asked for. What is kept is
/// the words, how many results they found, and when.
///
/// `resultCount` is the half that makes the data worth having. A popular term
/// that returns nothing is the most useful row in the table — it is a product
/// the catalogue is missing, or a word the synonym list should know.
/// 관리자가 개인정보를 **열어 본** 기록 (TASK-0093 F7).
///
/// ## 왜 남기는가
///
/// 목록은 가려서 보여주고(`user.read` 로도 마스킹된 값만 온다), 가리지 않은 값을
/// 보려면 상세를 열어야 한다. 그 순간이 여기 남는다. 실제 서비스의 관행이고, 그
/// 관행의 이유는 **접근을 막을 수 없기 때문**이다 — 운영에는 개인정보를 봐야 하는
/// 일이 실제로 있으므로, 남는 답은 「누가 언제 봤는지 남긴다」뿐이다.
///
/// ## 왜 사건 표인가
///
/// 열람은 상태가 아니라 **사건**이다. 마지막 열람만 남기면 「한 번 봤다」와 「백 번
/// 봤다」가 같은 행이 되고, 그 둘이 다르다는 것이 이 기록의 요점이다.
///
/// 지우지 않는다. 감사 기록이 지워질 수 있으면 감사 기록이 아니다 — 열람한 관리자가
/// 탈퇴해도(`onDelete: Restrict`) 이 행은 남는다.
model PersonalDataAccess {
  id String @id @default(uuid(7)) @db.Uuid

  /// 본 사람.
  actorId String @db.Uuid
  /// 열린 사람.
  subjectId String @db.Uuid

  /// 왜 열었는가. 비워 둘 수 없다 (`PersonalDataAccess_reason_check`).
  reason String

  createdAt DateTime @default(now())

  actor   User @relation("PersonalDataActor", fields: [actorId], references: [id], onDelete: Restrict)
  subject User @relation("PersonalDataSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  /// 「이 회원을 누가 봤나」가 이 표에 묻는 첫 질문이다.
  @@index([subjectId, createdAt(sort: Desc)])
  /// 「이 관리자가 무엇을 봤나」 — 오남용은 이 축으로 드러난다.
  @@index([actorId, createdAt(sort: Desc)])
}

/// 스토어 상태가 움직인 기록 (TASK-0094 F6).
///
/// `Seller` 는 **지금** 상태와 그 사유만 들고 있어, 정지와 해제를 반복하면 앞의 것이
/// 덮인다. 「이 스토어가 몇 번 정지됐나」에 답할 수 없다는 뜻이고, 그 답이 없으면
/// 반복 위반과 한 번의 실수를 구별할 수 없다.
///
/// `OrderStatusHistory` · `ClaimStatusHistory` 와 같은 모양이다 — 앞 행의 도착지가
/// 다음 행의 출발지이고, 그래서 표만 읽어도 경로가 나온다.
model SellerStatusHistory {
  id String @id @default(uuid(7)) @db.Uuid

  sellerId String @db.Uuid

  /// 첫 행은 출발지가 없다 (신청으로 태어난 순간).
  fromStatus SellerStatus?
  toStatus   SellerStatus

  /// 결정한 관리자. 시스템이 옮긴 것이면 `null`.
  ///
  /// **외래키를 걸지 않는다** — `OrderStatusHistory` · `ClaimStatusHistory` 와 같다.
  /// 이력은 append-only 이고 주체가 사라져도 남아야 하는데, 외래키를 걸면 그 주체가
  /// 실재해야만 **상태를 옮길 수 있게** 된다. 기록을 남기는 일이 기록되는 일을
  /// 막아서는 안 된다.
  actorId String? @db.Uuid
  /// 그때 적은 사유. 승인처럼 사유가 없는 결정도 있다.
  reason  String?

  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt(sort: Desc)])
}

/// 데모 정책 — **한 행짜리 표다** (`DemoPolicy_singleton_check`).
///
/// `DEMO_ACCOUNT_TTL_HOURS` 가 계약의 상수였는데, 그것으로는 「수명을 1시간으로
/// 바꿔 본다」(TASK-0096 F6)를 할 수 없다. 상수를 고치는 것은 배포이고, 데모를
/// 보여 주는 자리에서 필요한 것은 **지금 바꾸는 일**이다.
///
/// `AppMeta` 에 두지 않은 이유는 `PointPolicy` 가 이미 적어 두었다: 저 표의 값은
/// `String` 이라 범위를 DB 가 지킬 수 없다. 수명이 0이나 음수가 되면 발급되는 즉시
/// 만료된 계정이 나오고, 그 증상은 「데모가 안 된다」로만 보인다.
model DemoPolicy {
  /// 한 행뿐이라 열쇠가 상수다.
  id Int @id @default(1)

  /// 계정 수명. 1시간 이상 30일 이하 (`DemoPolicy_ttl_check`).
  ttlHours Int @default(24)

  /// 발급 시 심는 주문 수. 0이면 빈 계정으로 시작한다.
  seedOrders Int @default(3)

  /// 가상 카드 한도.
  virtualCardLimit Int @default(5000000)

  updatedAt DateTime @updatedAt
}

model SearchLog {
  id BigInt @id @default(autoincrement())

  /// Normalised: trimmed and lowercased, so 「코트」 and 「코트 」 are one term.
  term String

  resultCount Int

  createdAt DateTime @default(now())

  /// "무엇이 인기인가" is `GROUP BY term`, and "최근 일주일" bounds it.
  @@index([term])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 장바구니 (TASK-0045)
//
// 담는 단위는 **Variant** 다. 상품이 아니다 — 가격과 재고를 들고 있는 것이
// Variant 이고, 「검정 M」과 「검정 L」은 다른 물건이다.
//
// 예약하지 않는다 (D-026). 담고 안 사는 사람 때문에 재고가 잠기면 파는 쪽이
// 손해다. 예약은 주문서에 들어갈 때이고 그것은 TASK-0048 이다.
// ---------------------------------------------------------------------------

/// 한 사람의 장바구니. 계정당 하나다.
model Cart {
  id     String @id @default(uuid(7)) @db.Uuid
  /// `@unique` 가 「계정당 하나」를 데이터베이스가 지키게 한다. 애플리케이션의
  /// find-or-create 는 두 요청이 동시에 오면 둘 다 통과한다 — 그때 남는 것은
  /// 장바구니 두 개이고, 화면은 그중 하나만 보여 준다.
  userId String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 계정이 사라지면 장바구니도 사라진다. 남길 이력이 없다 — 주문은 별개의
  /// 테이블이고 스냅샷을 갖는다.
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

/// 장바구니에 든 것 하나 — Variant 와 수량.
///
/// **가격을 저장한다.** 지금 얼마인지는 `ProductVariant` 가 알고 있으므로 사본이
/// 필요 없어 보이지만, 필요한 것은 「지금 얼마인가」가 아니라 **「담을 때 얼마였나」**
/// 다. 그 둘을 비교하는 것이 F4(가격 변동 감지)이고, 사본이 없으면 비교할 대상이
/// 없다.
///
/// 주문의 스냅샷과는 다른 것이다. 주문은 결제된 사실을 영구히 붙잡지만 이쪽은
/// **알림을 위한 기준선**이다 — 값이 바뀌면 알려 주고, 사람이 확인하면 갱신된다.
model CartItem {
  id        String @id @default(uuid(7)) @db.Uuid
  cartId    String @db.Uuid
  variantId String @db.Uuid

  /// 판매자별 그룹핑(D-023: 배송비가 판매자 단위)을 위한 사본.
  ///
  /// `ProductVariant` 를 조인하면 알 수 있지만, 그룹핑은 장바구니를 열 때마다
  /// 하는 일이고 한 사람의 장바구니에 판매자가 열 곳이면 조회가 그만큼 넓어진다.
  /// 복합 외래키가 이 사본을 Variant 자신의 판매자에 묶으므로 어긋날 수 없다.
  sellerId String @db.Uuid

  /// 1 이상. 0은 「담지 않음」이고 그것은 행이 없는 것으로 표현한다.
  quantity Int

  /// 담을 때의 `ProductVariant.price`. 위 주석 참조.
  priceAtAdded Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  /// 복합 edge: Variant 와 그 판매자를 함께 가리킨다. `sellerId` 사본이 다른
  /// 판매자를 가리키는 행은 쓰일 수 없다 — `VariantOptionValue` 가 상품·옵션에
  /// 대해 하는 것과 같은 장치다.
  ///
  /// `Restrict`: 팔린 적 있는 Variant 는 소프트 삭제되므로 이 참조가 끊기지
  /// 않는다. 남의 장바구니에 든 것을 지우는 일은 판매자가 할 수 있는 일이
  /// 아니고, 그것을 데이터베이스가 거절한다.
  variant ProductVariant @relation(fields: [variantId, sellerId], references: [id, sellerId], onDelete: Restrict)

  /// 같은 Variant 를 두 번 담으면 행이 둘이 아니라 수량이 합산된다 (F1).
  /// 애플리케이션의 upsert 로도 되지만, 동시에 두 번 담으면 둘 다 통과한다.
  @@unique([cartId, variantId])
  /// 장바구니를 열 때의 조회는 언제나 「이 장바구니의 것 전부」다.
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// 재고 예약 (TASK-0048)
//
// 오버셀을 **구조적으로** 막는다 (D-026). 담을 때는 잡지 않고, 주문서에 들어갈 때
// 잡는다 — 담고 안 사는 사람 때문에 재고가 잠기면 파는 쪽이 손해다.
// ---------------------------------------------------------------------------

/// 예약의 상태. `docs/design/state-machines.md` 2장이 전이를 정한다.
enum ReservationStatus {
  /// 잡혀 있다. TTL 이 지나면 만료 스케줄러가 푼다 (TASK-0051).
  HELD
  /// 결제가 승인돼 실제 차감으로 바뀌었다. 끝난 상태다.
  CONFIRMED
  /// 결제 실패·이탈·만료. 끝난 상태다.
  RELEASED
}

/// 한 Variant 에 대해 한 사람이 잡아 둔 수량.
model StockReservation {
  id        String @id @default(uuid(7)) @db.Uuid
  variantId String @db.Uuid
  userId    String @db.Uuid

  /// 한 번의 주문서 시도. 부르는 쪽이 발급하는 불투명한 값이다 (TASK-0048 4.1).
  ///
  /// `orderId` 가 아닌 이유는 `Order` 표가 아직 없기 때문이다 — 주문 생성은
  /// TASK-0049 이고, 없는 표를 가리키는 컬럼은 외래키를 걸 수 없다. 이 값으로
  /// 「이 시도의 예약 전부」를 한 번에 풀 수 있다.
  checkoutId String @db.Uuid

  /// 1 이상. 0을 잡는 것은 잡지 않는 것이고, 그것은 행이 없는 것으로 표현한다.
  quantity Int

  status ReservationStatus @default(HELD)

  /// 이 시각이 지나면 만료다. **가용재고 계산은 이것을 보지 않는다** — 보는 것은
  /// `ProductVariant.reserved` 이고, 만료분을 거기서 빼 주는 것이 만료
  /// 스케줄러(TASK-0051)의 일이다. 그래서 그 스케줄러가 멈추면 재고가 잠긴다.
  expiresAt DateTime

  /// 확정되거나 풀린 시각. `HELD` 인 동안은 NULL 이다.
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 잡혀 있는 재고를 가진 Variant 는 지워지지 않는다. 소프트 삭제가
  /// 정상 경로이므로 이 참조가 끊길 일이 없다.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  /// 계정이 사라지면 그 사람의 예약도 사라진다 — 아무도 결제하지 않을 것이다.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 만료 스케줄러가 읽는 것: 「아직 잡혀 있고 시각이 지난 것」.
  @@index([status, expiresAt])
  /// 「이 시도의 예약 전부」.
  @@index([checkoutId])
  /// 정합성 점검이 읽는 것: variant 별 HELD 합계 (F7).
  @@index([variantId, status])
}

/// 한 판매자 몫의 주문이 지나는 상태 (`docs/design/state-machines.md` 1장).
///
/// 상태가 `Order` 가 아니라 여기 붙는 이유가 2단 분할의 전부다 — 판매자 A 는
/// 배송완료인데 B 는 준비중일 수 있어야 하고, B 만 취소할 수 있어야 하며, 정산도
/// 판매자별로 나간다. `Order` 에 두면 셋 다 불가능해진다 (D-023).
enum SellerOrderStatus {
  /// 주문서가 생겼고 재고는 잡혀 있다. 결제를 기다린다.
  PAYMENT_PENDING
  /// 결제가 실패했거나 TTL 이 지났다. 예약은 풀린다 (TASK-0051).
  PAYMENT_FAILED
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  /// 구매확정. 정산과 적립금 지급의 방아쇠다.
  CONFIRMED
  CANCELED
  RETURNED
}

/// 주문서. **결제 단위**다 (D-023).
///
/// 여러 판매자의 물건이 한 주문에 섞이지만 결제는 한 번이다. 그래서 금액의 합계는
/// 여기 있고, 상태는 여기 없다 — 상태는 `SellerOrder` 가 갖는다.
model Order {
  id String @id @default(uuid(7)) @db.Uuid

  /// 사람이 읽고 전달하는 번호. `YYYYMMDD-XXXXXXXX`.
  ///
  /// id 가 이미 있는데 따로 두는 이유는 UUID 를 전화로 불러 줄 수 없기 때문이다.
  /// 유니크는 DB 가 지킨다 — 난수를 쓰므로 충돌 확률은 낮지만 0이 아니고, 「낮다」는
  /// 것은 애플리케이션이 확인할 수 있는 성질이 아니다.
  orderNumber String @unique

  userId String @db.Uuid

  /// 이 주문이 잡은 예약을 가리킨다 (TASK-0049 4.3).
  ///
  /// 예약 쪽에 `orderId` 를 다는 대신 이 방향인 이유는 **순서** 때문이다. 재고
  /// 예약이 주문 저장보다 먼저이므로(4장 ③ → ④) 예약을 잡는 시점에 주문 행이
  /// 아직 없다. 이 값은 주문 서비스가 둘 중 어느 행보다 먼저 만든다.
  ///
  /// 유니크: 한 주문서 시도가 두 주문이 되는 것은 재시도의 버그이고, 그때 예약은
  /// 둘 중 하나만 가리키게 된다.
  checkoutId String @unique @db.Uuid

  /// 수령인 스냅샷 (TASK-0049 4.6). `Address` 를 가리키지 않는다 — 배송지는
  /// 지워지고 고쳐지지만 「어디로 보냈나」는 바뀌면 안 된다.
  recipientName  String
  recipientPhone String
  postalCode     String
  addressLine1   String
  addressLine2   String?

  /// `pricing.md` 1장의 ① ③ ④ ⑤ 와 실결제금액. 전부 정수 원이다.
  totalProductAmount        Int
  totalCouponDiscountAmount Int @default(0)
  totalPointDiscountAmount  Int @default(0)
  totalShippingFee          Int @default(0)
  paidAmount                Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 주문이 있는 계정은 지워지지 않는다. 탈퇴는 소프트 삭제이므로
  /// 이 참조가 끊길 일이 없고, 끊긴다면 그것은 이력을 잃는 일이다.
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerOrders SellerOrder[]
  payments     Payment[]

  /// 이 주문에 쓰인 쿠폰 (TASK-0072). 환불 복원(TASK-0078)이 여기서 되짚는다.
  usedCoupons UserCoupon[]

  /// 「내 주문」 목록. 최신순이다.
  @@index([userId, createdAt(sort: Desc)])
}

/// 판매자별 주문. **배송 · 취소 · 정산의 단위**다 (D-023).
model SellerOrder {
  id       String @id @default(uuid(7)) @db.Uuid
  orderId  String @db.Uuid
  sellerId String @db.Uuid

  status SellerOrderStatus @default(PAYMENT_PENDING)

  /// 운송장이 붙었는가 (TASK-0059 F4).
  ///
  /// 상태 머신의 `tracking` 요구 조건이 읽는 **유일한 사실**이다 — 「보냈다」는데
  /// 어디 있는지 모르는 상태를 만들지 않으려고 `PREPARING → SHIPPED` 가 이것을
  /// 요구한다.
  ///
  /// **번호의 단일 출처는 `Shipment.trackingNumber` 다** (TASK-0061). 운송사·추적
  /// 이벤트·발송 시각은 전부 그쪽에 있고, 여기 남은 이 컬럼은 그 번호의 **파생
  /// 사본**이다. 지우지 않은 이유는 전이를 판정하는 자리 때문이다 —
  /// `SellerOrderService.lock()` 은 잠근 **그 행의 컬럼만** 읽는 한 문장이어야
  /// 하는데(다른 표를 함께 읽으면 잠금을 기다린 뒤에도 문장 시작 시점의 스냅샷을
  /// 들고 와 낡은 값으로 판단한다), 사실을 `Shipment` 로 옮기면 그 문장이 조인이
  /// 된다. 그래서 **판정이 읽는 사실은 여기 남기고, 번호가 뜻하는 나머지 전부를
  /// 옮겼다.**
  ///
  /// 사본이 원본과 갈라지지 않는 것은 규율이 아니라 **제약**이 지킨다:
  /// `SellerOrder_trackingNumber_shipment_fkey` 가
  /// `(id, trackingNumber) → Shipment(sellerOrderId, trackingNumber)` 를 요구하므로,
  /// **자기 배송의 번호가 아닌 값은 이 칸에 들어올 수 없다.** 비어 있는 동안은
  /// (MATCH SIMPLE) 아무것도 요구하지 않는다 — 발송 전에는 배송 행이 없다.
  trackingNumber String?

  /// 판매자 스냅샷. 데모 판매자가 만료돼도(TASK-0025) 주문 이력에 브랜드명이 남는다.
  brandName String

  productAmount        Int
  couponDiscountAmount Int @default(0)
  pointDiscountAmount  Int @default(0)

  /// 배송비를 낸 적립금 (TASK-0047).
  ///
  /// 항목에 안분되지 **않는** 몫이다. 항목에 붙이면 항목의 할인이 상품금액을 넘고
  /// 부분 취소에서 환불액이 음수가 된다 — 무작위 검사가 실제로 잡은 결함이다.
  shippingPointAmount Int @default(0)

  shippingFee Int @default(0)
  paidAmount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  settlementItems SettlementItem[]
  /// `Restrict`: 스토어 행은 주문 이력이 가리키므로 지워지지 않는다. 데모 판매자
  /// 만료는 `SUSPENDED` 이지 삭제가 아니다.
  seller        Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  /// 발급된 운송장 (TASK-0061). **1:1** 이다 — 분할 배송은 이번 범위 밖이다.
  shipment      Shipment?
  /// 이 몫에 걸린 취소·반품 신청 (TASK-0065). **1:N 이다** — 항목 셋 중 하나를
  /// 취소하고 나중에 다른 하나를 반품하는 것이 정상 흐름이다.
  claims        ClaimRequest[]

  /// 한 주문에 한 판매자는 한 몫이다. 두 줄이면 그 판매자의 배송비가 두 번 붙는다.
  @@unique([orderId, sellerId])
  /// 판매자 콘솔의 주문 목록: 상태로 거르고 최신순.
  @@index([sellerId, status, createdAt(sort: Desc)])
}

/// 주문 항목. 상품 스냅샷과 **항목별 안분액**을 든다.
model OrderItem {
  id            String @id @default(uuid(7)) @db.Uuid
  sellerOrderId String @db.Uuid
  variantId     String @db.Uuid

  /// 상품명 · 옵션 · 대표 이미지 · 판매자명 · SKU (TASK-0049 4장).
  ///
  /// 상품이 삭제되거나 데모 판매자가 만료돼도 주문 이력이 온전해야 한다. 필요한
  /// 필드만 담는다 — 이미지는 대표 1장이다(R2).
  productSnapshot Json

  /// 주문 시점의 단가. `ProductVariant.price` 는 그 뒤에 바뀐다.
  unitPrice Int
  quantity  Int

  /// `unitPrice × quantity`. 저장하는 이유는 환불 때 다시 계산하지 않기
  /// 위해서다(`pricing.md` 원칙).
  productAmount Int

  /// 이 항목에 안분된 몫. 부분 취소에서 「이 항목에 얼마가 붙어 있었나」가 이것이다.
  couponDiscountAmount Int @default(0)

  /// 위 값 중 **판매자가 부담하는** 몫 (TASK-0080 F3 · F4).
  ///
  /// 사는 사람이 내는 돈과는 아무 상관이 없다 — 누가 부담하든 결제 금액은 같다.
  /// 따로 적는 이유는 **정산의 입력이기 때문**이다: 이 몫만 판매자의 정산액에서
  /// 빠지고, 플랫폼 부담 쿠폰과 적립금은 빠지지 않는다 (`pricing.md` 6장, D-029).
  ///
  /// 나중에 되계산할 수 없어서 주문 시점에 적어 둔다. 쿠폰의 범위는 주문 · 판매자 ·
  /// 항목 셋이라, 정산 시점에 쿠폰 정책만 보고 「이 항목에 얼마가 붙었나」를 되짚는
  /// 것은 안분을 통째로 다시 돌리는 일이고 그 규칙이 두 벌이 된다.
  ///
  /// **여기는 기본값이 있고 `commissionRateBp` 에는 없다.** 요율은 항목마다 반드시
  /// 있는 값이라 비어 있는 것이 곧 오류지만, 이 몫은 판매자 쿠폰을 안 쓴 주문에서
  /// 실제로 0이다 — 대부분의 항목이 그렇다. 그리고 빠뜨렸을 때 기우는 방향이 반대다:
  /// 요율이 0이면 플랫폼이 조용히 수수료를 못 받고, 이 값이 0이면 판매자가 자기가
  /// 부담한 쿠폰만큼 **더 받는다.** 어느 쪽도 좋지 않지만 뒤엣것은 판매자에게 손해를
  /// 끼치지 않고, 아래 제약이 「전체 쿠폰액보다 클 수 없다」로 위쪽을 막는다.
  sellerCouponDiscountAmount Int @default(0)
  pointDiscountAmount  Int @default(0)
  /// 위 둘의 합.
  discountAmount       Int @default(0)

  /// **어느 상품을 샀나** (TASK-0083).
  ///
  /// `variantId` 에서 조인으로 알 수 있는 값을 굳이 적어 두는 이유는 **리뷰가 이
  /// 사실을 증명해야 하기** 때문이다. 리뷰는 「이 상품의 리뷰」로 읽히는데, 그
  /// 상품이 정말 산 상품인지는 `Review → OrderItem → ProductVariant → Product` 를
  /// 되짚어야 알 수 있고, 되짚는 대신 **복합 외래키로 못 박으면** 조회 없이 참이
  /// 된다 (`Review_orderItem_product_fkey`).
  ///
  /// 사본이 원본과 갈라지지 않는 것은 규율이 아니라 제약이 지킨다:
  /// `OrderItem_variant_product_fkey` 가 `(variantId, productId)` 를
  /// `ProductVariant(id, productId)` 로 요구하므로 **자기 조합의 상품이 아닌 값은 이
  /// 칸에 들어올 수 없다.**
  ///
  /// 딸려 온 이득이 하나 있다 — 정산의 「많이 팔린 상품」이 스냅샷 JSON 에서
  /// 상품 id 를 꺼내 쓰고 있었는데, 이제 컬럼을 읽는다.
  productId String @db.Uuid

  /// **주문 시점의 수수료율** — basis point (TASK-0079 F4).
  ///
  /// 항목마다 있는 이유는 요율이 **카테고리에 걸리기** 때문이다. 한 판매자 몫에
  /// 패션(3%)과 가전(5%)이 섞여 있으면 몫 하나에 요율 하나를 적을 수 없고, 그
  /// 하나를 골라 적으면 둘 중 하나는 틀린 값으로 정산된다.
  ///
  /// 여기 박아 두는 것이 F4 의 전부다. 정산은 이 값을 읽고 `CommissionRate` 를 보지
  /// 않으므로, 요율을 올려도 **어제 판 것의 수수료가 바뀌지 않는다** — 정산이 나중에
  /// 계산되더라도 계약은 판매 시점에 성립한다.
  ///
  /// **비어 있을 수 없다** (R1). 「비어 있으면 전역 기본율로 읽는다」는 규칙이
  /// 함정이었다 — 주문 생성이 이 쓰기를 빠뜨리는 날 정산은 오류를 내지 않고 조용히
  /// 10% 로 계산한다. 기본값도 주지 않는다: 주면 빠뜨린 코드가 그 값을 얻는다.
  commissionRateBp Int

  /// **살아 있는 클레임이 잡고 있는 수량** (TASK-0065 R1).
  ///
  /// 「이미 신청된 수량 합계」를 `ClaimItem` 에서 매번 세지 않는 이유는 `reserved`
  /// 와 같다 — 세는 순간 그 값은 낡고, 「읽고 → 판단하고 → 쓰는」 사이에 남이
  /// 끼어들면 두 신청이 각자 「아직 남았다」를 읽는다. 이 칸이 있으면 잡는 일
  /// 전체가 **한 문장**이 된다:
  ///
  /// ```sql
  /// UPDATE "OrderItem" SET "claimedQuantity" = "claimedQuantity" + $q
  ///  WHERE "id" = $id AND "quantity" - "claimedQuantity" >= $q
  /// ```
  ///
  /// **거절된 클레임은 이 칸을 돌려준다.** 세는 것이 「신청한 적 있는 수량」이
  /// 아니라 「살아 있는 클레임이 잡고 있는 수량」이기 때문이고(`claim-rules.ts`),
  /// 검수에서 떨어진 반품이 그 항목을 영영 잠그면 사람이 할 수 있는 일이 없어진다.
  ///
  /// 캐시라 어긋날 수 있고, 그 마지막 방어선이
  /// `OrderItem_claimedQuantity_check`(`0 <= claimedQuantity <= quantity`)다 —
  /// 조건부 갱신을 안 쓰는 코드가 하나 생기는 날 조용히 넘치는 것을 DB 가 막는다.
  claimedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  /// `Restrict`: 팔린 조합은 지워지지 않는다. 스냅샷이 있어도 원장과 클레임이 이
  /// 참조를 따라간다. **복합 외래키**인 것은 `productId` 때문이다 — 그 칸이 이
  /// 조합의 상품과 갈라질 수 없게 한다.
  variant     ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)
  claimItems  ClaimItem[]
  /// 이 항목에 달린 리뷰 (TASK-0083). **0개 또는 1개** — 유니크가 그것을 만든다.
  review      Review?

  /// 「이 조합이 얼마나 팔렸나」. M13 의 판매량과 M10 의 클레임이 읽는다.
  @@index([variantId])
  /// 리뷰가 「이 상품을 샀다」를 조회 없이 증명하는 자리 (TASK-0083). 주문 항목마다
  /// 인덱스 하나를 더 쓰는 값이고, 그 값으로 사는 것은 **거짓말할 수 없는 사본**이다.
  @@unique([id, productId])
}

/// 전이를 일으킨 주체의 **종류** (TASK-0059).
///
/// 역할(`Role`)이 아니다. 역할은 「이 사람이 누구인가」이고 이것은 「이 전이를 누가
/// 일으켰는가」다 — `SYSTEM` 이 그 차이를 만든다: 배송 시뮬레이터와 D+7 자동 확정에는
/// 사람이 없다. 역할을 그대로 적으면 그 둘을 표현할 수 없어 관리자 계정을 빌려 쓰게
/// 되고, 그러면 이력에 「관리자가 확정했다」는 **거짓**이 남는다.
enum OrderActor {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

/// 상태 이력. 누가 언제 무엇에서 무엇으로 옮겼는가.
model OrderStatusHistory {
  id            String @id @default(uuid(7)) @db.Uuid
  sellerOrderId String @db.Uuid

  /// 생성 시에는 `null` 이다 — 이전 상태가 없다.
  fromStatus SellerOrderStatus?
  toStatus   SellerOrderStatus

  /// 왜 옮겼는가. 취소·실패에는 있고 정상 진행에는 없다.
  reason String?

  /// 누가 옮겼는가 — **종류**. 기본값이 없는 이유는 적는 쪽이 매번 답해야 하기
  /// 때문이다. 기본값을 두면 아무 말도 안 한 이력이 `SYSTEM` 으로 기록되고, 그것은
  /// 「모른다」가 아니라 「기계가 했다」는 거짓이 된다.
  actor OrderActor

  /// 누가 옮겼는가 — **누구**. 사람이 없는 전이(`SYSTEM`)는 `null` 이고, 주문 생성
  /// 줄도 `null` 이다 — 산 사람이 누구인지는 `Order.userId` 에 이미 있고, 같은 사실을
  /// 두 벌로 적지 않는다.
  actorId String? @db.Uuid

  createdAt DateTime @default(now())

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  /// 한 주문의 이력을 시간순으로.
  @@index([sellerOrderId, createdAt])
}

/// 누가 결제를 처리했나 (D-031).
///
/// `VIRTUAL_CARD` 는 우리가 만든 것이고 `TOSS` 는 남이 만든 것이다. 둘을 같은
/// 인터페이스 뒤에 두는 것이 M08 의 전부이고, 프로바이더가 둘이어야 추상화가
/// 장식이 아닌 실제 설계가 된다.
enum PaymentProviderName {
  VIRTUAL_CARD
  TOSS
}

/// 결제가 지나는 상태 (`docs/design/state-machines.md` 3장).
enum PaymentStatus {
  /// 요청이 만들어졌다. 아직 아무 돈도 움직이지 않았다.
  READY
  /// 카드가 받아 줬다. 아직 우리 쪽으로 오지는 않았다.
  AUTHORIZED
  /// 매입 확정. 돈이 온다.
  PAID
  /// 일부가 환불됐고 남은 금액이 있다. **끝이 아니다** — 부분 환불은 여러 번 온다.
  PARTIAL_CANCELED
  CANCELED
  /// 승인 거절 · 한도 초과.
  FAILED
  /// 결제사에 닿지 못해 **승인됐는지 모른다**. 대사만 이 상태에서 꺼낸다 (D-220).
  UNRESOLVED
}

/// 무슨 일이 있었나. 상태를 바꾼 사건도, 안 바꾼 사건도 남는다.
enum PaymentEventKind {
  REQUESTED
  AUTHORIZED
  CAPTURED
  CANCELED
  REFUNDED
  FAILED
  /// 웹훅이 도착했다. 상태를 바꿨는지와 무관하게 남는다 (TASK-0056).
  WEBHOOK
}

/// 한 주문의 결제.
///
/// **결제 단위는 `Order` 다** (D-023). 판매자가 셋이어도 사는 사람은 한 번 결제한다.
model Payment {
  /// Authorization ownership survives process restarts; aged claims enter reconciliation.
  authorizationStartedAt DateTime?
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @db.Uuid

  provider PaymentProviderName
  status   PaymentStatus       @default(READY)

  /// 승인된 금액. 주문의 실결제금액과 같아야 한다.
  authorizedAmount Int

  /// 지금까지 취소·환불된 누계.
  ///
  /// 환불 행을 매번 합산하지 않고 들고 있는 이유는, **넘지 않았는지를 판단하는
  /// 자리가 쓰는 자리와 같아야** 하기 때문이다 — 합산해서 판단하고 따로 쓰면 그
  /// 사이에 다른 환불이 들어온다 (F6). 합계와 어긋나지 않는 것은 점검이 본다.
  canceledAmount Int @default(0)

  /// 어느 수단으로 내는가 — 가상 카드에서는 카드 id 다 (TASK-0054).
  ///
  /// 뜻이 프로바이더마다 달라도 되는 자리라 이름이 구체적이지 않다. 토스는 이것을
  /// 쓰지 않는다 — 결제창이 수단을 정하고 우리는 그 결과만 받는다.
  ///
  /// 승인할 때 필요하므로 결제 행이 들고 있어야 한다. 요청마다 다시 받으면 시작할
  /// 때 고른 카드와 승인할 때 보낸 카드가 다를 수 있고, 그 둘이 다른 순간 사람은
  /// 자기가 어느 카드로 냈는지 모르게 된다.
  methodRef String?

  /// 프로바이더가 부르는 이름. 대사와 조회의 열쇠다.
  ///
  /// 승인 전에는 없다. 유니크인 이유는 **웹훅의 멱등** 때문이다(TASK-0056) — 같은
  /// 결제키로 두 행이 생기면 어느 쪽을 갱신할지가 도착 순서에 달린다.
  paymentKey String? @unique

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events       PaymentEvent[]
  refunds      Refund[]
  /// 이 결제로 나간 **클레임 환불**들 (TASK-0068). `refunds` 와 짝이지만 세는 것이
  /// 다르다 — 저쪽은 「얼마가 나갔나」이고 이쪽은 「어느 클레임의 몫이었나」다.
  claimRefunds ClaimRefund[]

  /// 「이 주문의 결제」. 한 주문에 결제 시도가 여러 번 있을 수 있다 — 실패하면
  /// 다시 하므로 유니크가 아니다.
  @@index([orderId, createdAt])
  /// 대사 배치가 읽는 것: 특정 상태로 오래 남아 있는 결제.
  @@index([status, createdAt])
}

/// 결제에 무슨 일이 있었나. **분쟁과 불일치 조사의 유일한 근거다.**
///
/// 상태 이름과 종류를 따로 둔 이유는 **상태를 안 바꾸는 사건**이 있기 때문이다 —
/// 같은 웹훅이 두 번 오면 두 번째는 아무것도 바꾸지 않지만, 그것이 왔다는 사실은
/// 남아야 한다.
model PaymentEvent {
  id        String @id @default(uuid(7)) @db.Uuid
  paymentId String @db.Uuid

  kind PaymentEventKind

  /// 이 사건이 상태를 바꿨다면 그 전후. 안 바꿨으면 둘 다 같다.
  fromStatus PaymentStatus?
  toStatus   PaymentStatus?

  /// 외부에서 온 원문 그대로 (TASK-0056). 우리가 해석하기 **전**의 것이라야
  /// 나중에 「그때 뭐라고 왔었나」에 답할 수 있다.
  payload Json?

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

/// 환불 한 건. 부분 환불이 여러 번 일어나므로 별도 표다.
model Refund {
  id        String @id @default(uuid(7)) @db.Uuid
  paymentId String @db.Uuid

  amount Int
  reason String

  refundedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, refundedAt])
}

/// 가상 카드의 상태.
enum VirtualCardStatus {
  ACTIVE
  /// 사람이 멈춰 세웠다. 되살릴 수 있다.
  SUSPENDED
  /// 지웠다. 원장이 가리키므로 행은 남는다 — 소프트 삭제다.
  DELETED
}

/// 카드 원장에 남는 사건의 종류.
enum VirtualCardEntryKind {
  /// 한도를 쓴다.
  CHARGE
  /// 매입 전 취소. 한도를 돌려준다.
  CANCEL
  /// 매입 후 환불. 한도를 돌려준다.
  REFUND
}

/// 가상 카드 (TASK-0053).
///
/// **실제 카드가 아니라는 것이 번호에서 보여야 한다** (R1). 접두어가 `9999` 인
/// 이유가 그것이고, 실제 BIN 과 겹치지 않으므로 어떤 결제망에도 닿지 않는다.
///
/// 환불이 제대로 됐는지를 **잔액으로 눈으로 확인**할 수 있게 하는 것이 이 카드의
/// 목적이다 — 그래서 잔액이 있는 것은 원장을 둔다는 원칙(재고·적립금과 같다)이
/// 여기에도 적용된다.
model VirtualCard {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  /// 전문. 마스킹은 읽는 쪽에서 한다 — 저장을 마스킹해 버리면 「뒤 네 자리가
  /// 같은 두 장」을 구분할 방법이 사라진다.
  ///
  /// 유니크다. 난수로 만들지만 충돌이 0은 아니고, 「낮다」는 것은 애플리케이션이
  /// 확인할 수 있는 성질이 아니다.
  number String @unique

  brand String

  /// 유효기간. 지난 카드는 쓸 수 없다.
  expiresAt DateTime

  /// 한도와 쓴 금액. 사용 가능액은 그 차이다.
  creditLimit Int
  /// 원장의 합과 같아야 한다. 어긋나면 점검이 찾는다 (F3).
  usedAmount  Int @default(0)

  status VirtualCardStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries VirtualCardTransaction[]

  /// 「내 카드」 목록. 지운 것은 빼고 최신순.
  @@index([userId, status, createdAt])
}

/// 카드 원장. 승인·취소·환불이 한 행씩 남는다.
///
/// `balanceAfter` 를 저장하는 이유는 재고 원장과 같다(TASK-0036) — 합계만으로는
/// 「그때 얼마였나」에 답하지 못하고, 대사가 어디서 깨졌는지도 알 수 없다.
model VirtualCardTransaction {
  id     String @id @default(uuid(7)) @db.Uuid
  cardId String @db.Uuid

  kind VirtualCardEntryKind

  /// 부호가 있다. 승인은 양수(한도를 쓴다), 취소·환불은 음수(돌려준다).
  amount Int

  /// 이 사건 직후의 `usedAmount`.
  balanceAfter Int

  /// 무엇 때문인가 — 결제 id 다. 같은 참조로 두 번 쓰이지 않게 하는 것은
  /// TASK-0054 의 일이고, 여기서는 기록만 한다.
  refId String

  createdAt DateTime @default(now())

  card VirtualCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

// ---------------------------------------------------------------------------
// 배송 (TASK-0061)
//
// 운송사에 연동하지 않는다. 도메인과 상태 전이는 실제와 같게 두되 운송장과 추적은
// **가상으로 만든다** (CLAUDE.md 5장). 그래서 이 두 표가 지켜야 하는 것은 「진짜와
// 같은가」가 아니라 **「진짜와 헷갈리지 않는가」**이고, 그것을 PSL 로 못 적는 CHECK
// 넷이 마이그레이션에 손으로 들어가 있다:
//
//   Shipment_carrierCode_format_check      코드는 대문자 두 글자다
//   Shipment_trackingNumber_format_check   번호는 `DEMO-{그 행의 운송사코드}-{12자리}`
//   Shipment_delivered_check               배송완료와 완료 시각은 함께 있거나 함께 없다
//   Shipment_deliveredAt_check             완료가 발송보다 앞설 수 없다
//
// 그리고 PSL 로 못 적는 외래키가 하나 더 있다 —
// `SellerOrder(id, trackingNumber) → Shipment(sellerOrderId, trackingNumber)`.
// 상태 머신이 읽는 사본이 원본과 갈라지지 못하게 하는 것이 그 줄이다
// (`SellerOrder.trackingNumber` 주석).
// ---------------------------------------------------------------------------

/// 배송이 지나는 상태. `@shopping/shared` 의 `shipmentStatuses` 와 같은 넷이다.
///
/// **주문 상태와 다른 축이다.** 주문은 `SHIPPED` 하나로 「보냈다」를 말하고 이쪽은
/// 그 안에서 물건이 어디쯤 왔는지를 말한다. 합치면 정산·클레임이 읽는 주문 상태가
/// 택배 진행에 따라 흔들린다.
enum ShipmentStatus {
  /// 집화됐고 아직 간선에 오르지 않았다. 발송 처리 직후의 상태다.
  READY
  /// 터미널 사이를 이동 중이다.
  IN_TRANSIT
  /// 받는 사람 쪽 영업소를 떠났다.
  OUT_FOR_DELIVERY
  /// 배송이 끝났다.
  DELIVERED
}

/// 추적 이벤트의 종류.
///
/// 상태와 값이 겹치는 것이 셋이지만 **사건과 결과는 다른 것**이라 열거형을 나눈다.
/// 상태를 바꾸지 않는 사건(배송 실패·재시도)이 생기면 늘어나는 것은 이쪽이다 —
/// `PaymentEventKind` 가 같은 이유로 `PaymentStatus` 와 따로 있다.
enum TrackingEventKind {
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

/// 판매자 몫 하나의 배송. **운송장 번호의 단일 출처다** (TASK-0061).
model Shipment {
  id String @id @default(uuid(7)) @db.Uuid

  /// 유니크: `SellerOrder` 당 한 건이다.
  ///
  /// 분할 배송을 이번에 넣지 않은 이유는 「이 주문은 배송 중인가」의 답이 여러 개가
  /// 되기 때문이다. 유니크를 푸는 것이 나중에 그것을 여는 마이그레이션이고, 그때
  /// 아래 복합 유니크는 그대로 쓸 수 있다.
  sellerOrderId String @unique @db.Uuid

  /// 가상 운송사 코드. 대문자 두 글자이고 운송장 번호 가운데 칸에 그대로 들어간다.
  carrierCode String

  /// 발급 시점의 운송사 이름 **스냅샷**. 표가 바뀌어도 과거 배송은 그때의 이름으로
  /// 남는다 (ERD 설계 원칙 2).
  carrierName String

  /// `DEMO-{운송사코드}-{12자리}`. 유니크가 마지막 방어선이다 — 생성기는 12자리
  /// 난수를 뽑고, 겹치면 서비스가 트랜잭션을 통째로 다시 한다
  /// (`Order.orderNumber` 와 같은 모양).
  trackingNumber String @unique

  status ShipmentStatus @default(READY)

  /// 발송된 시각. 이 행은 발송으로만 생기므로 비어 있을 수 없다.
  shippedAt DateTime

  /// 배송이 끝난 시각. `status = DELIVERED` 와 함께 있거나 함께 없다(CHECK).
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 몫이 사라지면 배송도 사라진다. 배송만 남으면 아무 주문도 가리키지 않는 운송장이다.
  sellerOrder SellerOrder             @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  events      ShipmentTrackingEvent[]

  /// `SellerOrder` 의 사본이 가리키는 자리다 (그쪽 `trackingNumber` 주석).
  ///
  /// `sellerOrderId` 만으로도 유니크지만, 복합 외래키는 **가리키는 두 열이 함께
  /// 유니크할 것**을 요구한다. 이 줄이 없으면 「자기 배송의 번호여야 한다」를 DB 에
  /// 걸 수 없다.
  @@unique([sellerOrderId, trackingNumber])
}

/// 추적 이력 한 줄. 시간 · 장소 · 무슨 일이 있었나.
model ShipmentTrackingEvent {
  id         String @id @default(uuid(7)) @db.Uuid
  shipmentId String @db.Uuid

  kind TrackingEventKind

  /// **가상 지명**이다. 실제 터미널 이름을 쓰지 않는다 (CLAUDE.md 6장).
  location String

  /// 화면에 그대로 나가는 한 줄. UI 문구가 아니라 **기록**이라 서버가 만든다 —
  /// 앱의 메시지 파일로 옮기면 지난 이벤트의 문장이 앱을 고칠 때마다 바뀐다.
  description String

  /// 이 일이 일어난 시각. 정렬의 첫 열쇠이고, 같은 밀리초는 `id`(UUIDv7)가 깬다.
  occurredAt DateTime

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// 한 배송의 이력을 시간순으로.
  @@index([shipmentId, occurredAt])
}

// ---------------------------------------------------------------------------
// 클레임 — 취소 · 반품 (TASK-0065)
//
// 순수 규칙은 `apps/api/src/claims/claim-rules.ts` 가 갖는다. 여기 있는 것은 그
// 규칙이 앉을 자리이고, PSL 로 적을 수 없는 것(CHECK)은 마이그레이션에 손으로 쓴
// SQL 로 들어간다 — 지키는 것은 각각의 컬럼 주석에 함께 적혀 있다.
//
// **항목·수량 단위가 이 도메인의 전부다** (D-027). 주문 항목 셋 중 하나만, 그 중 두
// 개 중 하나만 취소하는 것이 정상 흐름이고, 주문 단위로만 만들면 실제 서비스로 쓸
// 수 없다.
// ---------------------------------------------------------------------------

/// 취소인가 반품인가 (`docs/design/state-machines.md` 4장).
///
/// **사람이 고르지 않는다.** 「취소할까 반품할까」는 물건이 어디 있는가의 문제이지
/// 취향이 아니고, 고르게 두면 배송된 물건을 취소로 신청해 재고가 두 번 늘어난다.
/// 주문 상태가 정한다 — `claimRouteFor()`.
enum ClaimType {
  /// 배송 전. `PAID` · `PREPARING`.
  CANCEL
  /// 배송 후. `DELIVERED`, 그리고 반품 기간 안.
  RETURN
}

/// 클레임이 지나는 상태 (설계서 4장).
///
/// **두 경로가 한 열거형에 있다.** 나누면 「지금 이 클레임이 어디까지 왔나」를 묻는
/// 화면과 목록이 유형별로 다른 코드를 갖게 되고, 실제로 둘은 같은 표에 나란히 있다.
/// 대신 `ClaimRequest_type_status_check` 가 경로를 섞지 못하게 막는다.
enum ClaimStatus {
  CANCEL_REQUESTED
  CANCEL_APPROVED
  CANCEL_REJECTED
  RETURN_REQUESTED
  RETURN_APPROVED
  /// 회수 중. 실제 운송이 아니라 가상이다 (TASK-0067).
  PICKING_UP
  INSPECTING
  RETURN_COMPLETED
  RETURN_REJECTED
  /// 환불까지 끝났다. **두 경로가 만나는 유일한 자리**다 — 환불은 끝에서 같은
  /// 일이고, 그 앞까지 오는 길이 다를 뿐이다.
  REFUNDED
}

/// 누구 탓인가 (ERD 5장 · `pricing.md` 3장).
///
/// 값이 아니라 **돈**이다. 판매자 귀책이면 배송비·반품비를 판매자가 물고 구매자는
/// 전액을 돌려받으며, 단순 변심이면 반품 배송비가 환불액에서 빠진다. 그래서
/// 「모름」이 없다 — 정하지 않은 채로는 환불액을 계산할 수 없고, 계산하지 못하는
/// 클레임은 영원히 열려 있는 클레임이 된다.
enum ClaimFault {
  /// 단순 변심 · 주문 실수. 반품 배송비는 구매자 부담이다.
  CUSTOMER
  /// 상품 하자 · 오배송 · 품절 취소. 비용은 판매자 부담이다.
  SELLER
}

/// 취소 · 반품 신청 하나.
///
/// **`SellerOrder` 에 붙는다** — 배송·취소·정산의 단위가 거기이기 때문이다(D-023).
/// 한 주문에 판매자가 셋이면 취소도 셋으로 갈린다.
model ClaimRequest {
  id            String @id @default(uuid(7)) @db.Uuid
  sellerOrderId String @db.Uuid

  type   ClaimType
  status ClaimStatus

  /// 왜 신청했는가. 비어 있을 수 없다 — `ClaimRequest_reason_check` 가 막는다.
  /// 「왜 돌려주나」에 답하지 못하는 클레임은 판매자가 판단할 근거가 없다.
  reason String

  /// 누구 탓인가. 신청할 때 말하고, 검수 결과에 따라 바뀔 수 있다 (TASK-0067).
  fault ClaimFault

  /// 신청한 사람. **기본값이 없다.**
  ///
  /// 사람이 없는 신청은 없다 — `SYSTEM` 이 클레임을 내는 길은 이 TASK 에 없고,
  /// 생긴다면 그때 이 컬럼이 아니라 이력의 `actor` 가 그것을 말해야 한다.
  /// `Restrict`: 신청 이력이 가리키는 계정은 지워지지 않는다(탈퇴는 소프트 삭제다).
  requestedById String @db.Uuid

  /// **이 신청이 뒤집은 거절** (TASK-0071).
  ///
  /// 관리자가 판매자의 거절을 뒤집는 방법은 「거절된 클레임을 되살리는 것」이 아니라
  /// **새 신청을 관리자가 대신 내는 것**이다. 거절은 잡고 있던 수량을 이미 돌려주었고
  /// (`RELEASES_QUANTITY`), 저장소는 「거절된 것은 다시 신청할 수 있다」를 이미
  /// 규칙으로 갖고 있다 — 뒤집기는 그 재신청의 주체가 관리자인 경우다.
  ///
  /// 그래서 남는 것이 이 선 하나다. 없으면 **원본 쪽에서 「이 거절이 뒤집혔다」를
  /// 읽을 방법이 없고**, 판매자는 자기 거절이 살아 있는 줄 안다. 「누가·왜」는
  /// 이 신청의 첫 이력 줄이 이미 담는다 (`ClaimStatusHistory.actor` · `reason`).
  ///
  /// `SetNull`: 원본이 사라져도 개입 자체는 남아야 한다 — 이 신청의 환불은 이미
  /// 나갔을 수 있고, 그 사실이 원본과 함께 지워질 이유가 없다.
  overturnsClaimId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 주문이 사라지면 그 주문의 클레임도 사라진다. 클레임만 남으면 아무 주문도
  /// 가리키지 않는 신청서다.
  sellerOrder   SellerOrder          @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  requestedBy   User                 @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  items         ClaimItem[]
  statusHistory ClaimStatusHistory[]

  /// 이 신청이 뒤집은 거절, 그리고 이 거절을 뒤집은 신청들.
  ///
  /// 목록이 `overturnedBy` 인 것은 스키마가 「하나뿐」을 강제하지 않기 때문이다 —
  /// 부분 취소를 나눠 뒤집으면 한 거절에서 여러 개입이 나올 수 있고, 그때 하나로
  /// 못 박아 두면 정상 흐름이 유니크 위반으로 끝난다.
  overturns    ClaimRequest?  @relation("ClaimOverturn", fields: [overturnsClaimId], references: [id], onDelete: SetNull)
  overturnedBy ClaimRequest[] @relation("ClaimOverturn")

  /// 이 거절에 걸린 이의 (TASK-0071). 거절되지 않은 클레임에는 없다.
  appeal ClaimAppeal?

  /// 반품 경로에만 있는 부속 (TASK-0067). `type = CANCEL` 인 신청에는 없다.
  returnDetail ReturnDetail?

  /// 이 클레임의 환불 (TASK-0068). **1:1** 이다 — 열쇠가 클레임의 id 그 자체이고,
  /// 그것이 「같은 클레임에 두 번 불려도 한 번만 환불된다」의 마지막 방어선이다.
  refund ClaimRefund?

  /// 「이 주문의 클레임 전부」를 시간순으로. 잔여 수량 화면과 상세가 읽는다.
  @@index([sellerOrderId, createdAt])
  /// 판매자 콘솔의 「처리할 클레임」 목록: 상태로 거르고 최신순 (M10 의 화면).
  @@index([status, createdAt(sort: Desc)])
  /// 환불 재시도 배치가 읽는 것: **환불을 기다리는 자리에 오래 앉아 있는** 클레임
  /// (TASK-0068). 위 인덱스로는 안 된다 — 신청 시각이 아니라 **승인·검수가 상태를
  /// 옮긴 시각**을 기준으로 유예를 재야 하고, 그 둘은 사람이 며칠 뒤에 승인하는
  /// 정상 흐름에서 곧바로 갈린다.
  @@index([status, updatedAt])
  /// 「내가 낸 신청」 목록.
  @@index([requestedById, createdAt(sort: Desc)])
  /// 「이 거절이 뒤집혔는가」를 원본 쪽에서 되짚는다 (TASK-0071). 판매자 화면과
  /// 관리자 개입 이력이 같은 선을 반대 방향으로 읽는다.
  @@index([overturnsClaimId])
}

/// 신청에 걸린 주문 항목 하나와, 그중 **몇 개**인가.
///
/// 이 표가 있는 것이 「부분 취소·부분 반품」의 전부다. 없으면 신청의 단위가 주문이
/// 되고, 항목 셋 중 하나만 취소하는 정상 흐름을 표현할 수 없다.
model ClaimItem {
  id          String @id @default(uuid(7)) @db.Uuid
  claimId     String @db.Uuid
  orderItemId String @db.Uuid

  /// 신청 수량. 1 이상이고 `OrderItem.quantity` 의 남은 몫을 넘지 못한다 —
  /// 앞은 `ClaimItem_quantity_check`, 뒤는 `OrderItem_claimedQuantity_check` 가
  /// 지킨다.
  quantity Int

  /// 이 줄로 돌려줄 금액.
  ///
  /// **이 TASK 는 계산하지 않는다** (TASK-0068). 컬럼이 지금 있는 이유는 환불이
  /// 계산될 때 그 결과가 앉을 자리가 신청의 줄이어야 하기 때문이고 — 부분 환불은
  /// 항목별로 갈린다(`pricing.md` 3장) — 나중에 표를 하나 더 만들면 같은 사실이
  /// 두 곳에 살게 된다. 그때까지 값은 `0` 이고, 그 `0` 은 「0원을 돌려준다」가
  /// 아니라 **「아직 계산하지 않았다」**다.
  refundAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim     ClaimRequest @relation(fields: [claimId], references: [id], onDelete: Cascade)
  /// `Restrict`: 클레임이 가리키는 주문 항목은 지워지지 않는다.
  orderItem OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  /// 한 신청에서 같은 항목을 두 줄로 적을 수 없다. 두 줄이면 「이 신청이 이 항목의
  /// 몇 개를 잡고 있나」에 답이 둘이 되고, 거절이 돌려줄 수량도 갈린다.
  @@unique([claimId, orderItemId])
  /// 「이 항목에 걸린 클레임 전부」 — 잔여 수량의 대사(캐시가 맞는지)가 읽는다.
  @@index([orderItemId])
}

/// 클레임의 상태 이력. 누가 언제 무엇에서 무엇으로 옮겼는가.
///
/// `OrderStatusHistory` 가 선례이고 **`OrderActor` 를 그대로 쓴다** — 주체는 클레임과
/// 주문에서 같은 것을 뜻하고(사람이 아니라 종류다), 열거형을 한 벌 더 만들면 콘솔이
/// 같은 값을 두 이름으로 다루게 된다.
model ClaimStatusHistory {
  id      String @id @default(uuid(7)) @db.Uuid
  claimId String @db.Uuid

  /// 신청이 생긴 줄에는 이전 상태가 없다. **신청은 전이가 아니라 생성**이다.
  fromStatus ClaimStatus?
  toStatus   ClaimStatus

  /// 왜 옮겼는가. 거절에는 있고 정상 진행에는 없다.
  reason String?

  /// 누가 옮겼는가 — **종류. 기본값을 두지 않았다** (TASK-0059 4.2).
  ///
  /// 기본값을 두면 주체를 말하지 않은 이력이 `SYSTEM` 으로 기록되고, 그것은
  /// 「모른다」가 아니라 **「기계가 했다」는 거짓**이다. 클레임에서는 그 거짓의 값이
  /// 더 크다 — 「누가 이 반품을 거절했나」가 분쟁에서 다투는 바로 그 사실이다.
  actor OrderActor

  /// 누가 옮겼는가 — **누구**. 사람이 없는 전이(`SYSTEM`)는 `null` 이다.
  actorId String? @db.Uuid

  createdAt DateTime @default(now())

  claim ClaimRequest @relation(fields: [claimId], references: [id], onDelete: Cascade)

  /// 한 클레임의 이력을 시간순으로.
  @@index([claimId, createdAt])
}

/// 이의가 어떻게 끝났나 (TASK-0071).
///
/// **「검토 중」이 값으로 없다.** 그것은 `reviewedAt IS NULL` 이고, 상태를 하나 더
/// 두면 「검토 중인데 결론이 적힌 행」이 표현 가능해진다 — `ClaimRefund.refundedAt`
/// 이 같은 이유로 상태 열거형을 두지 않았다.
enum ClaimAppealOutcome {
  /// 인용. 관리자가 거절을 뒤집었고, 그 개입은 새 `ClaimRequest` 로 서 있다.
  UPHELD
  /// 기각. 판매자의 거절이 유지된다. 사유가 필수다.
  DISMISSED
}

/// 거절에 대한 **구매자의 이의** (TASK-0071).
///
/// ## 왜 표가 하나 더 필요한가 — 이력으로는 표현되지 않는다
///
/// 이의는 **상태 전이가 아니다.** 이의를 냈다고 클레임이 움직이지 않는다 — 관리자가
/// 볼 때까지 그 클레임은 거절된 채다. `ClaimStatusHistory` 에 적으려면 `toStatus` 가
/// 있어야 하고, 같은 상태로 적는 것은 `ClaimStatusHistory_transition_check`
/// (`fromStatus <> toStatus`)이 막는다. 즉 **적을 자리가 없다.**
///
/// 그리고 이의는 자기 수명을 갖는다 — 접수되고, 검토되고, 인용되거나 기각된다.
/// 이력 한 줄은 그중 첫 줄만 담고, 나머지 둘을 담을 칸이 없다.
///
/// ## 기본키가 `claimId` 인 것이 「한 클레임에 이의는 하나」의 전부다
///
/// `ClaimRefund` · `ReturnDetail` 과 같은 모양이고 같은 이유다 — 유니크 인덱스를
/// 따로 두는 것보다 짧고, 「한 거절에 이의가 둘」이라는 상태를 **애초에 만들 수
/// 없다.** 기각된 뒤 다시 내는 길은 열지 않는다: 같은 거절에 같은 사람이 두 번째
/// 이의를 내는 것은 절차가 아니라 반복이고, 그때 필요한 것은 새 이의가 아니라 답이다.
model ClaimAppeal {
  claimId String @id @db.Uuid

  /// 이의를 낸 사람. 이 클레임을 신청한 그 사람이다 — 남의 거절에 이의를 낼 수는
  /// 없고, 그 판정은 라우트가 한다. 열을 두는 것은 **판정을 믿지 않기 위해서**가
  /// 아니라 「누가 말했나」가 분쟁의 사실이기 때문이다.
  /// `Restrict`: 이의가 가리키는 계정은 지워지지 않는다(탈퇴는 소프트 삭제다).
  filedById String @db.Uuid

  /// 왜 이의를 내는가. 비어 있을 수 없다 — `ClaimAppeal_reason_check` 가 막는다.
  /// 근거 없는 이의는 관리자가 판단할 것이 없다.
  reason String

  /// 관리자가 결론을 낸 순간. `null` 이면 **검토 대기**이고, 그것이 관리자 대기열의
  /// 조회 조건이다.
  reviewedAt DateTime?

  /// 결론을 낸 관리자. 결론이 없으면 `null` 이다.
  reviewedById String? @db.Uuid

  /// 결론. 없으면 아직 검토 중이다 — `ClaimAppeal_review_check` 가 세 열이 함께
  /// 채워지거나 함께 비게 한다.
  outcome ClaimAppealOutcome?

  /// 기각의 사유. **인용에는 없다** — 인용의 근거는 개입 클레임의 이력에 적히고,
  /// 두 곳에 적으면 둘이 다른 말을 하는 날이 온다.
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim      ClaimRequest @relation(fields: [claimId], references: [id], onDelete: Cascade)
  filedBy    User         @relation("ClaimAppealFiledBy", fields: [filedById], references: [id], onDelete: Restrict)
  reviewedBy User?        @relation("ClaimAppealReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  /// **관리자의 대기열이 읽는 유일한 조회 조건이다** — 아직 결론이 없는 이의를
  /// 오래된 것부터. 부분 인덱스가 아닌 것은 「검토가 끝난 이의」도 목록에서
  /// 필터로 읽히기 때문이다.
  @@index([reviewedAt, createdAt])
}

/// 클레임 하나에 대한 **환불 한 번** (TASK-0068).
///
/// ## 왜 표가 하나 더 필요한가
///
/// `Refund` 는 「이 결제에서 얼마가 나갔나」를 말하고, 이 표는 **「이 클레임의
/// 환불이 끝났나」**를 말한다. 둘은 같은 사실이 아니다 — 한 주문에 판매자가 셋이면
/// 클레임도 셋으로 갈리지만 결제는 하나이고, `Refund` 행만으로는 그중 어느 것이
/// 어느 클레임의 몫인지 되짚을 수 없다.
///
/// ## 기본키가 `claimId` 인 것이 멱등의 전부다
///
/// 열쇠는 **클레임의 id 그 자체**다 (`cancel-events.ts` · `return-events.ts` 의
/// `idempotencyKey`). 전이표에 `CANCEL_APPROVED` 로도 `RETURN_COMPLETED` 로도
/// **돌아오는 화살표가 없어** 한 클레임은 평생 한 번만 그 자리에 서고, 그래서 그
/// id 가 곧 「이 환불」의 이름이다. 시각이나 난수를 섞으면 재발행이 다른 열쇠를
/// 갖게 되는데, 열쇠가 막아야 하는 것이 정확히 그 경우다.
///
/// `ReturnDetail` 이 같은 이유로 같은 모양이다 — 유니크 인덱스를 따로 두는 것보다
/// 짧고, 「한 클레임에 환불 기록이 둘」이라는 상태를 애초에 만들 수 없다.
///
/// ## 실패한 시도도 여기 남는다
///
/// `refundedAt` 이 `null` 인 행은 **「아직 못 돌려줬다」**이고, 그 옆의
/// `attempts` · `lastError` 가 왜인지를 말한다. 그것이 없으면 실패한 환불은
/// 「승인됐는데 `REFUNDED` 로 안 간 클레임」으로만 보이고, 그 상태에서 사람이 할 수
/// 있는 일은 로그를 뒤지는 것뿐이다 (TASK-0068 R3).
model ClaimRefund {
  claimId String @id @db.Uuid

  /// 어느 결제로 나갔는가. 성공한 행에는 반드시 있다
  /// (`ClaimRefund_settled_check`).
  ///
  /// 실패 기록에는 없을 수 있다 — 결제를 찾지 못한 것 자체가 실패의 이유일 수 있고,
  /// 그때 값을 지어내면 대사가 없는 결제를 가리키게 된다.
  paymentId String? @db.Uuid

  /// 항목 몫의 합 (`refundBreakdown` 의 `itemsAmount`).
  itemsAmount Int @default(0)

  /// 배송비 조정. **부호가 있다** — 양수는 돌려준 것, 음수는 재부과·반품비 차감이다.
  ///
  /// 합쳐서 한 숫자로 적지 않는 이유는 `RefundQuote.shippingAdjustment` 와 같다:
  /// 「배송비 3,000원 환불」과 「반품비 3,000원 차감」은 사람이 확인해야 할 서로 다른
  /// 줄이고, 합치면 0원이 되어 **아무 일도 없었던 것처럼 보인다.**
  shippingAmount Int @default(0)

  /// 실제로 프로바이더에 요청한 금액. **`max(0, itemsAmount + shippingAmount)`** 이고
  /// 그 식을 `ClaimRefund_total_check` 이 강제한다.
  amount Int @default(0)

  /// **회수하지 못한 적립금** (TASK-0078 F6).
  ///
  /// 구매확정 후 반품이면 지급했던 적립금을 되가져오는데, 이미 써 버렸으면 되가져올
  /// 수 없다. 음수 잔액을 만들지 않기로 했으므로(`PointAccount_balance_check`) 못
  /// 가져온 몫이 남고, **그 사실이 갈 곳이 여기다.**
  ///
  /// 원장에는 남지 못한다. 원장은 「돈이 움직인 기록」인데 하나도 못 가져간 경우에는
  /// 움직인 돈이 0원이고, 0원짜리 행은 `PointTransaction_amount_check` 가 막는다 —
  /// 0원짜리 사건은 사건이 아니라는 그 규칙이 옳고, 그래서 이 칸이 필요하다.
  ///
  /// 일부라도 가져간 경우에는 그 `ADJUST` 의 이유에도 적히지만, 이유는 문장이라
  /// 「회수 실패 목록」을 만들 수 없다. 숫자로 서 있어야 세고 거를 수 있다.
  pointClawbackShortfall Int @default(0)

  /// 돈이 실제로 나간 순간. **`null` 이면 아직 안 나갔다.**
  ///
  /// 이 열이 곧 「환불이 끝났는가」이고, 재시도 배치가 읽는 것도 이것이다. 상태
  /// 열거형을 따로 두지 않는 이유는 값이 둘뿐이라서다 — 셋째 값이 필요해지는 날
  /// 그것은 상태가 아니라 새 사실이다.
  refundedAt DateTime?

  /// 몇 번 시도했나. 성공한 시도까지 센다.
  attempts Int @default(0)

  /// 마지막 시도가 왜 실패했나. 성공하면 지운다 — 남겨 두면 「성공했는데 오류가
  /// 적힌 행」이 되고, 그것을 읽는 사람은 무엇을 믿어야 할지 모른다.
  lastError String?

  lastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim   ClaimRequest @relation(fields: [claimId], references: [id], onDelete: Cascade)
  /// `Restrict`: 환불이 가리키는 결제는 지워지지 않는다. 지워지면 「돈이 어디로
  /// 나갔나」에 답할 수 없다.
  payment Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// **아직 못 돌려준 것부터.** 재시도 배치와 운영자의 실패 목록이 읽는 유일한
  /// 조회 조건이다 (R3).
  @@index([refundedAt, lastAttemptAt])
}

// ---------------------------------------------------------------------------
// 반품 — 신청의 부속 · 수거 · 검수 (TASK-0067)
//
// **클레임 표를 늘리지 않고 옆에 붙인다.** 상태·항목·수량·이력은 전부 위쪽
// `ClaimRequest` 무리가 갖고, 여기 있는 것은 **반품 경로에만 있는 사실들**이다.
// 컬럼으로 밀어 넣으면 취소 신청의 절반이 영원히 `NULL` 인 열이 되고, 「이 열이
// 비어 있는 것이 정상인가」에 답하려면 매번 `type` 을 함께 봐야 한다.
//
// 순수 규칙은 `apps/api/src/claims/return-rules.ts` 가 갖는다.
// ---------------------------------------------------------------------------

/// 왜 돌려보내는가 (TASK-0067 4장의 표).
///
/// **`ClaimFault` 를 대체하지 않는다.** 저쪽은 둘(`CUSTOMER` · `SELLER`)이고 그것이
/// 돈을 가르는 축이며, 이쪽은 셋이고 **그 둘을 파생시키는 입력**이다. 하자와
/// 오배송은 돈에서만 같다 — 하나는 물건의 문제이고 하나는 이행의 실수다.
enum ReturnReason {
  /// 단순 변심 · 주문 실수. 반품 배송비는 구매자가 문다.
  CHANGE_OF_MIND
  /// 상품 하자. 판매자가 문다.
  DEFECTIVE
  /// 오배송. 판매자가 문다.
  WRONG_ITEM
}

/// 반품 배송비를 **누가 내는가** (`pricing.md` 3장).
///
/// `ClaimFault` 와 값이 닮았지만 다른 축이다. 귀책은 「누구 탓인가」이고 이것은
/// 「누가 내는가」다. 지금은 함께 움직이지만 부분 부담·플랫폼 부담이 생기는 날
/// 갈라지는 것은 이쪽이고, 한 열거형이면 그날 두 뜻이 한 값에 얹힌다.
enum ReturnFeeBearer {
  BUYER
  SELLER
}

/// 회수인가 반송인가.
///
/// **방향이 이 표에만 있는 열**이다. 배송(`Shipment`)은 언제나 판매자 → 구매자라
/// 적을 필요가 없었고, 반품은 그 반대가 정상이며 검수 불합격에서 다시 뒤집힌다.
enum ReturnShipmentDirection {
  /// 구매자 → 판매자. 승인된 반품을 걷어 온다.
  PICKUP
  /// 판매자 → 구매자. 검수에서 떨어진 물건을 돌려보낸다.
  SEND_BACK
}

/// 반품 한 건의 부속. `ClaimRequest` 와 **1:1**이다.
///
/// 기본키가 `claimId` 인 것이 그 1:1 을 DB 가 강제하는 방법이다 — 유니크 인덱스를
/// 따로 두는 것보다 짧고, 「한 반품에 부속이 둘」이라는 상태를 애초에 만들 수 없다.
model ReturnDetail {
  claimId String @id @db.Uuid

  reason ReturnReason

  /// 누가 반품 배송비를 무는가. `reason` 에서 파생되고 신청 시점에 굳는다.
  feeBearer ReturnFeeBearer

  /// 반품 배송비 — **신청 시점의 `Seller.shippingFee` 스냅샷**.
  ///
  /// `SellerOrder.shippingFee` 가 아니다. 그쪽은 무료배송 조건을 넘겨 0 일 수 있고,
  /// 그러면 「무료배송 주문은 변심 반품도 공짜」가 된다 — 회수 운송은 무료배송
  /// 조건과 아무 상관이 없다. 판매자가 정책을 바꿔도 이미 신청된 반품의 부담액은
  /// 그대로여야 하므로 값을 복사해 둔다 (CLAUDE.md 6장).
  returnShippingFee Int

  /// 돌려줄 원 배송비. 판매자 귀책에서만 0보다 크다 (`pricing.md` 3장).
  originalShippingRefund Int @default(0)

  /// 환불액에서 뺄 반품 배송비. 구매자 부담에서만 0보다 크다.
  returnShippingDeduction Int @default(0)

  /// 검수한 순간. `inspectionPassed` 와 **함께 있거나 함께 없다**(CHECK).
  inspectedAt DateTime?

  /// 검수 결과. **`true` 일 때만 환불이 시작된다** (TASK-0068).
  inspectionPassed Boolean?

  /// 불합격 사유. 합격에는 없어도 된다.
  inspectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim     ClaimRequest     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  photos    ReturnPhoto[]
  shipments ReturnShipment[]
}

/// 하자 반품에 붙은 사진 한 장.
///
/// **열쇠만 담는다.** 바이트는 R2 에 있고 API 를 지나지 않는다(TASK-0011) — 이 행이
/// 갖는 것은 「어느 객체가 이 반품의 증거인가」 하나다.
model ReturnPhoto {
  id      String @id @default(uuid(7)) @db.Uuid
  claimId String @db.Uuid

  /// `returns/{userId}/{objectId}.{ext}`. 형식은
  /// `ReturnPhoto_key_format_check` 가 지킨다 — 열쇠 하나로 소유자를 말할 수
  /// 있어야 「남의 사진을 자기 신청서에 붙이는」 요청을 두 번째 조회 없이 막는다.
  key String

  /// 화면에 보일 순서. 사람이 고른 순서가 증거의 순서다.
  position Int

  createdAt DateTime @default(now())

  detail ReturnDetail @relation(fields: [claimId], references: [claimId], onDelete: Cascade)

  /// 같은 사진을 두 줄로 붙일 수 없다.
  @@unique([claimId, key])
  /// 한 반품의 사진을 고른 순서대로.
  @@unique([claimId, position])
}

/// 회수·반송 운송장 한 건. **가상이다** (TASK-0061 과 같은 성질).
///
/// ## 왜 `Shipment` 를 다시 쓰지 않는가
///
/// 두 가지가 막는다. 첫째, `Shipment.sellerOrderId` 는 **유니크**다 — 그 유니크를
/// 푸는 것은 분할 배송을 여는 일이고, 그러면 「이 주문은 배송 중인가」의 답이 여러
/// 개가 된다(그 컬럼의 주석이 이미 그렇게 말한다). 둘째, `SellerOrder.trackingNumber`
/// 사본과 `SellerOrder_trackingNumber_shipment_fkey` 가 **몫당 배송 하나**를 전제로
/// 걸려 있다.
///
/// 그래서 표는 나누되 **번호는 같은 발급기에서 나온다** (`shipment-rules.ts` 의
/// `trackingNumberFrom`). 발급한 번호가 진짜 운송장과 구분되어야 한다는 성질은
/// 방향과 아무 상관이 없기 때문이다.
model ReturnShipment {
  id      String @id @default(uuid(7)) @db.Uuid
  claimId String @db.Uuid

  direction ReturnShipmentDirection

  /// 가상 운송사 코드와 그 시점의 이름 **스냅샷** (`Shipment` 와 같은 이유).
  carrierCode String
  carrierName String

  /// `DEMO-{운송사코드}-{12자리}`. 배송의 번호와 **한 공간을 나눠 쓰지 않는다** —
  /// 표가 다르므로 유니크도 표마다다. 두 표에 같은 번호가 있어도 가리키는 것이
  /// 다르지 않다: 하나는 나가는 길, 하나는 돌아오는 길이다.
  trackingNumber String @unique

  issuedAt DateTime

  createdAt DateTime @default(now())

  detail ReturnDetail @relation(fields: [claimId], references: [claimId], onDelete: Cascade)

  /// 방향마다 한 건. 회수는 한 번이고 반송도 한 번이다 — 둘째 줄이 생기면
  /// 「이 반품의 운송장」에 답이 둘이 된다.
  @@unique([claimId, direction])
}

// ---------------------------------------------------------------------------
// 쿠폰 (TASK-0072 · `docs/design/erd.md` 7장)
//
// PSL 로 표현할 수 없는 것이 여섯이고 전부 마이그레이션의 손으로 쓴 CHECK 에 있다
// (`20260909000000_coupon/migration.sql`). 그중 셋이 이 표의 존재 이유를 지킨다:
//
//   Coupon_issuer_check        부담 주체와 판매자 참조가 어긋난 행
//   Coupon_seller_scope_check  판매자 쿠폰이 남의 매출까지 덮는 것
//   Coupon_issued_count_check  발급 수량을 넘긴 발급
//
// 마지막 것이 동시 발급의 최종 방어선이다 — 애플리케이션은 조건부 갱신으로
// 판단하지만, 돈이 걸린 자리에서 방어선이 하나뿐이면 안 된다
// (`Payment_canceledAmount_check` 와 같은 판단).
// ---------------------------------------------------------------------------

/// 누가 이 쿠폰을 부담하는가. **정산의 근거다** (D-029 · `pricing.md` 5장).
///
/// 플랫폼 쿠폰은 플랫폼이 물고 판매자는 정가 기준으로 정산받는다. 판매자 쿠폰만
/// 그 판매자의 정산액에서 안분액이 빠진다. 이 구분이 없으면 정산이 「판매액 ×
/// 수수료율」이라는 단순 곱셈이 되어 도메인으로서 의미를 잃는다.
enum CouponIssuerType {
  PLATFORM
  SELLER
}

/// 정액이냐 정률이냐. `discountValue` 의 **단위가 여기에 달렸다** — 정액이면
/// 원이고 정률이면 퍼센트다. 상한(`maxDiscountAmount`)이 정률에만 뜻이 있는 것도
/// 여기서 나오고, 그 관계는 `Coupon_discount_check` 가 강제한다.
enum CouponDiscountType {
  FIXED
  PERCENT
}

/// 어디에 붙는 쿠폰인가.
///
/// **판매자 쿠폰이 가질 수 있는 것은 `SELLER` 와 `PRODUCT` 뿐이다.** `ALL` 은
/// 남의 매출에까지 자기 부담을 넣는 일이고, `CATEGORY` 는 카테고리가 플랫폼
/// 공용이라 이름만 좁을 뿐 결과가 같다.
enum CouponScopeType {
  ALL
  CATEGORY
  PRODUCT
  SELLER
}

/// 이 쿠폰이 닿을 수 있는 그룹 (TASK-0073).
///
/// **소유권을 스칼라 한 칸으로 답하기 위해 있다.** 「데모가 낸 쿠폰인가」를 발행자나
/// 스토어를 조인해서 물으면 코드 발급 한 번이 질의 세 개를 더 끌고 오고, 그 경로는
/// 캠페인이 두드리는 자리다 (`coupon-performance.spec.ts` A5).
///
/// 값은 발행 시점에 정해진다 — 만든 사람이 체험 계정이거나, 대상 스토어가 체험
/// 계정의 것이면 `DEMO`. 그 뒤로는 이 칸 자체가 사실이고 아무것도 조인하지 않는다.
enum CouponAudience {
  /// 누구나. 실계정이 받고 쓸 수 있다.
  ALL
  /// **체험 계정만.** 방문자의 관리자가 낸 쿠폰이 실제 주문에 붙지 않게 한다.
  DEMO
}

/// 발급된 한 장의 상태. `EXPIRED` 로 옮기는 것은 배치다 (TASK-0072 4장).
enum UserCouponStatus {
  ISSUED
  USED
  EXPIRED
}

/// 쿠폰 정책. 발급된 장(`UserCoupon`)이 아니라 그 원본이다.
model Coupon {
  id String @id @default(uuid(7)) @db.Uuid

  /// 부담 주체. `sellerId` 와 짝이 맞아야 한다 — `Coupon_issuer_check`.
  issuerType CouponIssuerType
  /// 판매자 쿠폰일 때만 채워진다. 플랫폼 쿠폰에서는 언제나 `NULL` 이다.
  sellerId   String?          @db.Uuid

  name String

  /// 코드 발급 쿠폰의 코드. Crockford base32 열 글자이고, **서버가 만든다**.
  ///
  /// 유니크는 DB 가 지킨다 — 50비트 난수라 충돌 확률은 낮지만 0이 아니고,
  /// 「낮다」는 것은 애플리케이션이 확인할 수 있는 성질이 아니다
  /// (`Order.orderNumber` 와 같은 판단). 서비스가 한 번 다시 뽑는다.
  code String? @unique

  discountType  CouponDiscountType
  /// 정액이면 원, 정률이면 퍼센트(1~100). 범위는 `Coupon_discount_check`.
  discountValue Int

  /// 정률의 상한. **정액에서는 언제나 `NULL`** 이다 — 정액에 상한을 두는 것은
  /// 뜻이 없는 값이고, 뜻이 없는 값이 저장되면 읽는 쪽이 그것을 해석하려 든다.
  maxDiscountAmount Int?

  /// 이 금액 이상일 때만 쓸 수 있다. `0` 은 조건이 없다는 뜻이다.
  minOrderAmount Int @default(0)

  scopeType CouponScopeType
  /// 범위 대상. `ALL` 이면 비어 있고 그 밖이면 하나 이상이다
  /// (`Coupon_scope_ids_check`).
  ///
  /// 텍스트 배열인 이유는 세 종류가 한 칸에 들어가기 때문이다 — 판매자와 상품은
  /// uuid, 카테고리는 정수다. 타입별 컬럼 셋을 두면 늘 둘이 비어 있고, 「어느
  /// 칸이 채워졌나」와 `scopeType` 이 어긋날 수 있는 자리가 하나 더 생긴다.
  /// 대상이 실재하는지는 발행 시점에 서비스가 확인한다.
  scopeIds  String[]

  validFrom  DateTime
  validUntil DateTime

  /// 발급할 수 있는 장수. `NULL` 은 무제한이다.
  issueLimit  Int?
  /// 지금까지 발급된 장수. **`UserCoupon` 을 세지 않고 들고 있는 이유는
  /// 예약의 `reserved` 와 같다** — 넘지 않았는지 판단하는 자리가 쓰는 자리와
  /// 같아야 하고, 세어서 판단한 뒤 따로 쓰면 그 사이에 다른 발급이 들어온다.
  issuedCount Int  @default(0)

  /// **누가 이 쿠폰을 냈나** (TASK-0073).
  ///
  /// 퍼미션의 스코프가 닿을 자리다. 판매자 쿠폰의 주인은 스토어지만(`sellerId`)
  /// 플랫폼 쿠폰에는 소유하는 스토어가 없어서, 이 값이 없으면 「데모 관리자가 낸
  /// 쿠폰」과 「진짜 관리자가 낸 쿠폰」을 권한 층이 구분할 방법이 없다.
  ///
  /// `NULL` 은 **이 컬럼이 생기기 전에 발행된 행**이라는 뜻이고, 주인 없는 플랫폼
  /// 데이터로 읽힌다(`couponOwnership`) — 그때까지의 동작 그대로다.
  issuedByUserId String? @db.Uuid

  /// 이 쿠폰이 닿을 수 있는 그룹. 기본값은 「누구나」다.
  ///
  /// 발행 시점에 정해지고 그 뒤로 바뀌지 않는다. 조인 없이 스코프 검사에 답하는
  /// 것이 이 칸의 존재 이유다 — {@link CouponAudience} 의 주석이 그 값을 잰다.
  audience CouponAudience @default(ALL)

  /// 발행이 중단된 시각. `NULL` 이면 발행 중이다 (TASK-0073 F5).
  ///
  /// **이미 발급된 장에는 아무 일도 일어나지 않는다.** 중단은 「더 나가지 않게」이지
  /// 「나간 것을 무르게」가 아니다 — 무르는 것은 사람이 받은 것을 빼앗는 일이라
  /// 다른 결정이고, 그 문은 아직 없다.
  ///
  /// 판정하는 자리는 발급의 조건부 갱신 한 문장이다(`takeIssueSlot`). 따로 읽어
  /// 판단하면 그 사이에 중단된 쿠폰이 한 장 더 나간다.
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 쿠폰을 낸 가게는 이 정책이 남아 있는 한 지워지지 않는다.
  /// 정산(M12)이 「판매자 부담 쿠폰」을 이 행으로 읽는다.
  seller      Seller?      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  /// 이 쿠폰을 발행한 계정 (TASK-0073). `Restrict` — 발행자는 이 정책이 남아 있는
  /// 한 지워지지 않고, 탈퇴가 소프트 삭제라 끊길 일도 없다.
  issuedBy    User?        @relation("CouponIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  userCoupons UserCoupon[]

  /// 판매자 콘솔의 「내 쿠폰」 목록. 최신순이다.
  @@index([sellerId, createdAt(sort: Desc)])
  /// 관리자 콘솔의 플랫폼 쿠폰 목록, 그리고 기간이 지난 정책 찾기.
  @@index([issuerType, validUntil])
  /// 「내가 낸 쿠폰」. 데모 관리자의 목록이 자기가 낸 것으로 좁혀지는 자리다.
  @@index([issuedByUserId, createdAt(sort: Desc)])
  /// 발급이 읽는 조건 그대로. 목록도 이 칸으로 거른다.
  @@index([suspendedAt])
}

/// 발급된 쿠폰 한 장.
/// 수수료율 한 벌 (TASK-0079).
///
/// **행이 곧 이력이다.** 요율을 바꾸는 것은 이 표의 행을 고치는 일이 아니라 지금
/// 열린 행을 닫고(`validUntil`) 새 행을 여는 일이다 — 그래서 F5 의 「변경 이력」이
/// 따로 만들어야 할 표가 아니라 이 표를 시간순으로 읽은 결과가 된다.
///
/// **정산이 이 표를 읽지 않는다.** 주문 시점의 요율은 `OrderItem.commissionRateBp`
/// 에 박혀 있고(F4), 여기 있는 것은 「지금 새 주문에 무엇을 적용할까」다. 요율을
/// 올려도 과거 주문의 정산액이 변하지 않는 것은 그 나눔 덕분이다 — 정산이 여기를
/// 읽으면 어제 판 것의 수수료가 오늘 바뀐다.
model CommissionRate {
  id String @id @default(uuid(7)) @db.Uuid

  /// 이 요율이 걸린 스토어. 셋 중 가장 좁은 범위다.
  sellerId String? @db.Uuid
  /// 이 요율이 걸린 카테고리. 스토어와 **동시에 채워질 수 없다**.
  categoryId Int?

  /// basis point (1bp = 0.01%). 금액이 정수라 비율도 정수여야 한다 — 부동소수를
  /// 쓰면 정산에서 `0.1 + 0.2` 류의 오차가 다시 들어온다 (`erd.md` 1장).
  rateBp Int

  /// 이 요율이 적용되기 시작한 시각.
  validFrom DateTime
  /// 닫힌 시각. `NULL` 이면 **지금 유효한 행**이고, 범위마다 하나뿐이다.
  validUntil DateTime?

  /// 누가 바꿨나 (F5). `Restrict` — 요율을 바꾼 사람은 그 이력이 남아 있는 한
  /// 지워지지 않고, 탈퇴가 소프트 삭제라 끊길 일도 없다.
  createdById String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller    Seller?   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User      @relation("CommissionRateAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  /// 요율 결정이 읽는 자리 — 범위별로 열린 행을 찾는다.
  @@index([sellerId, validUntil])
  @@index([categoryId, validUntil])
  /// 「이 범위의 이력」. 관리자 화면이 시간순으로 읽는다.
  @@index([sellerId, categoryId, validFrom(sort: Desc)])
}

model UserCoupon {
  id       String @id @default(uuid(7)) @db.Uuid
  couponId String @db.Uuid
  userId   String @db.Uuid

  status UserCouponStatus @default(ISSUED)

  /// 발급 시점의 `Coupon.validUntil` 을 **베껴 둔 값**.
  ///
  /// 이유가 둘이다. 하나는 스냅샷 — 발행자가 나중에 기간을 줄여도 이미 받은
  /// 사람의 쿠폰이 소급해서 짧아지면 안 된다. 다른 하나는 배치 — 만료 전환이
  /// 조인 없이 이 표만 훑으면 되고, 아래 인덱스가 그것을 받는다.
  expiresAt DateTime

  issuedAt DateTime @default(now())

  /// 언제 어느 주문에 썼나. 상태와 **함께 움직인다** — `UserCoupon_used_check`.
  usedAt  DateTime?
  orderId String?   @db.Uuid

  /// 이 장이 **실제로 깎은 금액** (TASK-0075).
  ///
  /// 정책의 `discountValue` 로 다시 계산할 수 없다. 정률이면 그때의 상품금액이
  /// 필요하고, 겹쳐 덮인 장은 남은 금액까지만 깎였기 때문이다 — 그리고 그 「그때」는
  /// 주문이 지난 뒤에는 아무 데도 없다.
  ///
  /// **정산이 읽는 값이다** (`pricing.md` 5장). 판매자 부담 쿠폰의 안분액만 그
  /// 판매자의 정산액에서 빠지는데, `SellerOrder.couponDiscountAmount` 는 플랫폼
  /// 쿠폰과 판매자 쿠폰이 섞인 합계라 그 나눔에 답하지 못한다. 발행 화면의 사용
  /// 통계(TASK-0073 F6 · TASK-0074 F5)도 이 칸을 센다.
  ///
  /// 「썼다」의 넷째 값이라 나머지 셋과 함께 움직인다 — `UserCoupon_used_check`.
  discountAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 셋 다 `Restrict`. 발급 이력은 정산이 읽는 기록이고, 계정 탈퇴는 소프트
  /// 삭제라 이 참조가 끊길 일이 없다.
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// **중복 발급의 열쇠다.** 같은 쿠폰은 한 사람에게 한 장뿐이고, 그것을 지키는
  /// 것은 애플리케이션의 조회가 아니라 이 인덱스다 — 동시에 들어온 두 요청은
  /// 서로의 조회 결과에 보이지 않는다.
  @@unique([couponId, userId])
  /// 내 쿠폰함: 쓸 수 있는 것부터, 곧 만료되는 순서로.
  @@index([userId, status, expiresAt])
  /// 만료 배치가 고르는 조건 그대로.
  @@index([status, expiresAt])
  /// 「이 주문에 어떤 쿠폰이 쓰였나」 — 환불 복원(TASK-0078)이 읽는다.
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// 적립금 원장 (TASK-0076)
//
// `PointAccount.balance` 가 현재값이고 `PointTransaction` 이 그것을 설명한다.
// CLAUDE.md 6장 — 「잔액이 있는 것은 원장 테이블을 둔다. 현재값은 원장의 결과이며
// 대사가 가능해야 한다」 — 을 재고 원장이 네 진술로 옮겨 놓았고(TASK-0036 4.1),
// 적립금에는 다섯째가 붙는다:
//
//   P1  balance = SUM(amount)                        계정마다
//   P2  balanceAfter(n) = balanceAfter(n-1) + amount(n)
//   P3  마지막 행의 balanceAfter = balance
//   P4  seq 가 1..n 이고 빈칸이 없다
//   P5  남은 통들의 합(SUM(remainingAmount)) = balance
//
// DB 에 내려간 것은 마이그레이션에 있다:
//
//   PointAccount_userId_key            사람당 계좌 하나
//   PointAccount_balance_check         **잔액은 음수가 될 수 없다** — 마지막 방어선
//   PointTransaction_seq_key           (accountId, seq) 는 한 자리에 한 행
//   PointTransaction_ref_key           한 참조에 한 사건 (멱등)
//   PointTransaction_direction_check   종류가 부호를 정한다
//   PointTransaction_amount_check      0원짜리 사건은 사건이 아니다
//   PointTransaction_balance_check     balanceAfter >= 0
//   PointTransaction_ref_pair_check    refType 과 refId 는 함께 온다
//   PointTransaction_reason_check      ADJUST 는 이유를 말한다
//   PointTransaction_lot_check         통의 두 칸은 EARN·RESTORE 에만, 그 둘에는 반드시
//                                      (`earnRateBp` 은 EARN 에만 — TASK-0078)
//   PointTransaction_remaining_check   0 <= remainingAmount <= amount
//   PointTransaction_append_only       트리거: 지울 수 없고, 줄어드는 remainingAmount
//                                      말고는 고칠 수도 없다
//
// **P1~P5 는 그중에 없다.** 다섯 다 다른 행들에 대한 집계를 요구하고 CHECK 에는
// 집계를 쓸 수 없다(재고 원장이 같은 이유로 같은 자리에 멈췄다). 그래서 그 다섯은
// `PointsService` 가 계정 행의 잠금 안에서 지키고, `reconcile()` 이 깨진 것을 센다.
// 제약이 지키는 것은 **데이터**이고 서비스가 지키는 것은 **답**이라는 구분이
// TASK-0065 4.1 의 음성 대조에서 나왔다.
// ---------------------------------------------------------------------------

/// 적립금 원장에 남는 사건의 종류.
///
/// 종류가 부호를 정하고 `PointTransaction_direction_check` 가 그것을 지킨다.
/// `ADJUST` 만 양방향이고, 그래서 이유를 말해야 하는 유일한 종류다 —
/// `StockLedgerType` 과 같은 모양이고 같은 이유다.
enum PointTransactionType {
  /// 구매확정으로 지급. **유효기간을 갖는 유일한 종류**이고, 그래서 이 행은
  /// 사건이면서 동시에 잔고를 담은 통이다.
  EARN
  USE
  /// 환불이 되돌린 몫 (TASK-0078).
  RESTORE
  EXPIRE
  /// 사람의 판단. 이유가 필수다.
  ADJUST
}

/// `PointTransaction.refId` 가 가리키는 표.
///
/// 참조가 멱등의 열쇠(`PointTransaction_ref_key`)라서 자유 문자열이 아니다.
/// `POINT_TRANSACTION` 은 만료가 **어느 통을 닫았는지**를 가리킨다 — 자기 표를
/// 가리키는 유일한 값이고, 그 덕분에 만료 배치가 다른 사건들과 같은 인덱스로
/// 멱등해진다.
enum PointRefType {
  ORDER
  SELLER_ORDER
  CLAIM_REQUEST
  POINT_TRANSACTION
}

/// 적립 정책. **한 행짜리 표다** (`PointPolicy_singleton_check`).
///
/// **`AppMeta` 에 두지 않은 이유.** 저 표는 배치가 자기 실행 시각을 적는 운영용
/// 문자열 저장소이고, 실제로 그렇게만 쓰이고 있다(대사·스위퍼·시뮬레이터). 여기
/// 두 값은 성격이 다르다 — `earnRateBp` 는 실결제금액에 **곱해지고**,
/// `validityDays` 는 지급 시각에 **더해진다.** 곱해지는 값의 범위를 DB 가 지켜야
/// 하는 이유는 `Seller_commissionRateBp_check` 가 이미 적어 두었다: 음수나 100%
/// 초과가 들어가면 산 금액보다 많은 적립금이 지급되고 아무도 눈치채지 못한다.
/// `AppMeta.value` 는 `String` 이라 그 CHECK 을 쓸 수 없다.
///
/// 한 행인 것은 정책이 플랫폼 단위이기 때문이다. 판매자별 적립률은 정산에서
/// 누가 부담하는지를 다시 정해야 하는 문제이고(적립금은 플랫폼 부담 —
/// `pricing.md` 5장), 그 결정은 아직 없다.
model PointPolicy {
  /// 언제나 1. `PointPolicy_singleton_check` 가 둘째 행을 표현 불가능하게 만든다 —
  /// 「행이 하나뿐인가」를 애플리케이션이 확인하면 동시에 들어온 두 요청이 각자
  /// 「없다」를 읽고 각자 만든다.
  id Int @id @default(1)

  /// 적립률 (bp). 1bp = 0.01%, 10000 = 100%.
  earnRateBp Int @default(100)

  /// 지급된 적립금이 사는 날 수.
  validityDays Int @default(365)

  updatedAt DateTime @updatedAt
}

/// 사람당 하나인 적립금 계좌.
///
/// 잔액을 여기 두고 원장을 따로 두는 이유는 재고·가상카드와 같다 — 매번 원장을
/// 합산하면 주문서 화면마다 집계가 붙는다. 어긋날 수 있다는 것이 이 설계의
/// 대가이고, 그래서 `PointsService.reconcile()` 이 있다.
model PointAccount {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @db.Uuid

  /// 원장의 결과. **더하는 것이 아니라 대입한다** — 서비스가 잠금 안에서 계산한
  /// `balanceAfter` 를 그대로 쓰므로 원장의 합과 산술로는 갈라질 수 없다.
  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 적립금을 한 번이라도 만진 계정은 물리 삭제되지 않는다.
  /// `StockLedger.actorId` 와 같은 판단이고, 탈퇴가 소프트 삭제라 실제로 끊길 일도
  /// 없다. 데모 만료도 이 계좌를 지우지 않는다 (`demo-cleanup-plan.ts`).
  user    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries PointTransaction[]
}

/// 적립금 원장 한 줄. 사실상 append-only 다.
///
/// **`id` 가 있는 것이 `StockLedger` 와 다른 점**이고, 이유는 이 표의 행이 다른
/// 행에게 **가리켜지기 때문**이다: 만료 한 줄은 자기가 닫은 통(`EARN` 한 줄)을
/// `refId` 로 가리킨다. 그렇다고 `(accountId, seq)` 가 덜 중요해진 것은 아니라서,
/// 그쪽은 유니크 제약으로 남는다 — 그 자리가 곧 사건의 순서이고, 잠금 없이 쓰인
/// 행은 그 유니크에 부딪히거나 빈칸을 남긴다(P4).
model PointTransaction {
  id        String @id @default(uuid(7)) @db.Uuid
  accountId String @db.Uuid

  /// 이 계정의 원장에서 몇 번째인가. 1부터, 빈칸 없이.
  ///
  /// 계정 행의 잠금 아래에서 `직전 max + 1` 로 정해진다. UUIDv7 의 시간 접두어는
  /// 같은 밀리초 안에서 무작위로 갈리므로 잔액 사슬을 그리는 순서가 될 수 없다.
  seq Int

  type PointTransactionType

  /// 부호가 있고 0이 아니다. 적립·복구는 양수, 사용·만료는 음수, 조정은 양쪽.
  amount Int

  /// 이 사건 직후의 `PointAccount.balance`.
  ///
  /// 저장하는 이유는 재고 원장과 같다 — 「그때 얼마였나」가 처음부터의 합이 아니라
  /// 한 행이 되고, 대사가 **어디서** 깨졌는지를 말할 수 있게 된다(P2·P3).
  balanceAfter Int

  /// 무엇 때문인가. 둘 다 있거나 둘 다 없다(`PointTransaction_ref_pair_check`).
  /// 반쪽 참조는 따라갈 수도, 멱등의 열쇠로 쓸 수도 없다.
  ///
  /// 외래키를 걸지 않는다 — 가리키는 표가 넷이고, 다형 참조를 외래키로 표현하려면
  /// 열을 넷 두어야 한다. `StockLedger.refId` 가 같은 이유로 같다.
  refType PointRefType?
  refId   String?       @db.Uuid

  /// 왜, 사람의 말로. `ADJUST` 에만 필수다 — 나머지는 이름이 스스로를 설명하지만
  /// 조정은 사람의 판단이고, 설명 없는 조정은 감사할 수 없다.
  reason String?

  // -- 통(lot) 의 세 칸. `EARN` 에만 있고 `EARN` 에는 반드시 있다 --------------
  //
  // `PointTransaction_lot_check` 가 그 「정확히 EARN 에만」을 지킨다. 셋을 따로 둔
  // 표로 빼지 않은 이유는 **적립 사건과 통이 같은 것**이기 때문이다 — 나누면 두
  // 표가 1:1 로 붙어 다니고, 그 둘이 어긋난 상태가 표현 가능해진다.

  /// 이 통이 사라지는 시각. 지급 시점의 정책으로 계산된다.
  expiresAt DateTime?

  /// 아직 남은 금액. 사용은 **먼저 사라질 통부터** 이 값을 깎는다.
  ///
  /// 이 칸이 없으면 만료를 계산할 수 없다: 1,000원을 받아 전부 쓴 뒤 유효기간이
  /// 지났을 때 적립액을 그대로 만료시키면 잔액이 음수가 된다. 남은 통들의 합이
  /// 잔액과 같아야 한다는 것이 P5 이고, `reconcile()` 이 그것을 센다.
  remainingAmount Int?

  /// 지급 시점의 적립률 (bp) — TASK-0076 R2.
  ///
  /// 정책 행을 나중에 읽어 되짚으면 **적립률을 바꾼 날 과거가 전부 바뀐다.**
  /// 「왜 이만큼 받았나」의 답은 지급 시점에만 참이다.
  earnRateBp Int?

  createdAt DateTime @default(now())

  account PointAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // 만료 배치가 훑는 자리 — **아직 남아 있는 통만** 담은 부분 인덱스
  // (`PointTransaction_lot_expiry_idx`). PSL 로는 `WHERE` 를 적을 수 없어
  // 마이그레이션에 손으로 있고, 그래서 여기 `@@index` 를 쓰면 안 된다: 같은 열에
  // 인덱스가 둘 생겨 모든 쓰기가 아무도 안 읽는 인덱스 값을 치른다.

  /// 원장 읽기의 전부: `accountId = ? ORDER BY seq DESC`. 유니크인 이유는 위에.
  @@unique([accountId, seq])
}

// ---------------------------------------------------------------------------
// 정산 (TASK-0080)
//
// **이 프로젝트 도메인 설계의 최종 수렴점**이다 (D-032). 쿠폰의 부담 주체, 적립금,
// 반품 차감, 구매확정이 여기 한 줄로 모인다:
//
//   지급액 = 판매액 − 플랫폼 수수료 − 판매자 부담 쿠폰 − 반품 차감
//
// PSL 로 쓸 수 없어 마이그레이션에 raw SQL 로 사는 제약들:
//
//   SettlementItem_sale_key         한 판매자 몫은 **한 번만** 정산된다 (F6)
//   SettlementItem_adjustment_key   한 반품은 **한 번만** 차감된다
//   SettlementItem_payout_check     줄의 지급액은 세 항의 결과다 (F8)
//   Settlement_total_check          정산서의 합계는 그 줄들의 합이다 (F8)
// ---------------------------------------------------------------------------

/// 정산서가 지나는 상태 (`state-machines.md` 5장). 되돌아가지 않는다.
enum SettlementStatus {
  /// 배치가 만들었고 아직 아무도 보지 않았다. **이 상태에서만 다시 만들 수 있다.**
  PENDING
  /// 분쟁·이상 건으로 **보류**했다 (TASK-0081 F4). 사유 없이는 들어올 수 없다.
  ///
  /// 승인의 반대가 아니라 **판단을 미룬 상태**다. 그래서 여기서 갈 수 있는 곳은
  /// 승인뿐이고, 「거절」은 없다 — 정산은 거절할 수 있는 것이 아니라 금액을 고쳐
  /// 다음 회차에서 조정하는 것이다.
  HOLD
  /// 관리자가 승인했다. 금액이 굳는다 — 배치도 더는 이 정산서를 건드리지 않는다.
  APPROVED
  /// 지급 완료(가상). 실제 이체는 없다 — 상태만 바뀐다.
  PAID
}

/// 정산서의 한 줄이 무엇인가.
enum SettlementItemType {
  /// 이 회차에 정산되는 판매자 몫 하나.
  SALE
  /// **지난 회차에 이미 정산된 몫**에서 나중에 확정된 반품. 금액이 음수다.
  ///
  /// 승인 전(`PENDING`)이면 이 줄이 생기지 않는다 — 그때는 그 몫의 판매 줄을 고쳐
  /// 쓰면 되고, 고쳐 쓴 줄에는 반품이 이미 반영돼 있다. 이 줄은 **되돌릴 수 없는
  /// 회차** 뒤에 온 반품만을 위한 것이다 (F7).
  ///
  /// 「어느 반품 때문인가」를 가리키지 않는다. 차감은 **이미 정산된 것과 지금
  /// 정산돼야 하는 것의 차이**이지 반품 하나의 결과가 아니다 — 한 몫이 나눠서 여러
  /// 번 반품되면 「어느 반품」은 정의되지 않고, 차이만이 언제나 옳다. 무엇이
  /// 반품됐는지는 그 판매자 몫의 클레임 이력이 답한다.
  RETURN_ADJUSTMENT
}

/// 한 판매자의 한 주 정산서.
model Settlement {
  id       String @id @default(uuid(7)) @db.Uuid
  sellerId String @db.Uuid

  /// 정산 기간. **끝은 열려 있다** (`periodEnd` 는 포함하지 않는다).
  ///
  /// 경계를 닫힌 구간으로 두면 밀리초 하나가 두 회차에 들어가거나 어느 회차에도 안
  /// 들어간다. 열린 끝은 다음 회차의 시작과 정확히 맞물린다 (R2).
  periodStart DateTime
  periodEnd   DateTime

  status SettlementStatus @default(PENDING)

  /// 판매액 — 구매확정된 몫의 상품금액 합. **정가 기준이다.**
  ///
  /// 플랫폼 쿠폰과 적립금을 빼지 않은 값이다. 그 둘은 플랫폼이 부담하므로 판매자는
  /// 정가 기준으로 정산받는다 (`pricing.md` 6장, D-029) — **이 구분이 없으면 정산이
  /// 단순 곱셈이 되어 도메인으로서 의미가 없어진다.**
  salesAmount Int @default(0)

  /// 플랫폼 수수료. 주문 시점에 항목에 박힌 요율로 계산한다 (TASK-0079 F4).
  commissionAmount Int @default(0)

  /// 판매자가 부담한 쿠폰의 안분액. **이것만 빠진다.**
  sellerCouponAmount Int @default(0)

  /// 지난 회차 뒤에 확정된 반품의 차감. **음수이거나 0이다.**
  returnAdjustmentAmount Int @default(0)

  /// 실제로 줄 돈. `salesAmount − commissionAmount − sellerCouponAmount + returnAdjustmentAmount`.
  ///
  /// **음수일 수 있다.** 지난 회차의 반품이 이번 주 판매보다 크면 그렇게 된다 —
  /// 0으로 자르면 그 차액이 사라지고, 사라진 돈은 아무 데도 나타나지 않는다.
  payoutAmount Int @default(0)

  approvedAt   DateTime?
  approvedById String?   @db.Uuid
  paidAt       DateTime?
  paidById     String?   @db.Uuid

  /// 왜 보류했나 (F4). **보류에는 반드시 있고**, 해소된 뒤에도 남는다.
  ///
  /// 남기는 이유는 「이 회차가 왜 늦었나」가 승인 뒤에 사라지면 안 되기 때문이다 —
  /// 판매자가 묻는 것은 대개 지급이 끝난 뒤다.
  holdReason String?
  heldAt     DateTime?
  heldById   String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 정산 이력이 가리키는 스토어는 지워지지 않는다.
  seller     Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  /// `Restrict`: 승인자 계정은 탈퇴해도 툼스톤으로 남는다 — 누가 승인했나는 지워지지 않는다.
  approvedBy User?            @relation("SettlementApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy     User?            @relation("SettlementPayer", fields: [paidById], references: [id], onDelete: Restrict)
  heldBy     User?            @relation("SettlementHolder", fields: [heldById], references: [id], onDelete: Restrict)
  items      SettlementItem[]

  /// 한 판매자에 한 기간은 한 장이다. 두 장이면 같은 주가 두 번 지급된다.
  @@unique([sellerId, periodStart])
  /// 관리자 콘솔: 승인 대기 목록을 회차순으로.
  @@index([status, periodStart])
  /// 판매자 콘솔: 내 정산 내역을 최신순으로 (TASK-0082).
  @@index([sellerId, periodStart(sort: Desc)])
}

/// 정산서의 한 줄. **정산서의 합계는 이 줄들의 합이다** (F8).
model SettlementItem {
  id           String @id @default(uuid(7)) @db.Uuid
  settlementId String @db.Uuid

  type SettlementItemType

  /// 어느 판매자 몫에 대한 줄인가. 차감 줄도 원래 몫을 가리킨다.
  sellerOrderId String @db.Uuid

  /// 세 항. 차감 줄에서는 **셋 다 음수**다 — 부호를 여기서 정해 두면 합계가 그냥
  /// 합이 되고, 읽는 쪽마다 「이건 빼는 값인가」를 판단하지 않아도 된다.
  salesAmount        Int
  commissionAmount   Int
  sellerCouponAmount Int
  /// `salesAmount − commissionAmount − sellerCouponAmount`. DB 가 강제한다 (F8).
  payoutAmount       Int

  createdAt DateTime @default(now())

  settlement  Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  /// `Restrict`: 정산된 주문 몫은 지워지지 않는다.
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  /// 정산서 상세: 한 장의 줄들.
  @@index([settlementId])
  /// 「이 몫이 정산됐나」 — 배치가 매 회차 묻는 질문이다.
  @@index([sellerOrderId])
}

// ---------------------------------------------------------------------------
// 회원 부가 기능 — 리뷰 (TASK-0083)
//
// **구매 검증을 애플리케이션이 아니라 스키마가 강제한다** (`erd.md` 9장). 코드 검사는
// 우회 경로가 생기면 뚫리지만, `orderItemId` 를 필수 유니크로 두면 **구매하지 않은
// 사람은 참조할 행이 없어 애초에 만들 수 없다.** 중복도 같은 제약이 막는다.
//
// PSL 로 쓸 수 없어 마이그레이션에 raw SQL 로 사는 제약들:
//
//   Review_orderItem_product_fkey   리뷰의 상품 = 그 주문 항목의 상품
//   Review_rating_check             1~5 별
//   Review_content_check            빈 리뷰가 아니다
//   ReviewImage_key_format_check    남의 접두어로 만든 열쇠가 들어오지 못한다
// ---------------------------------------------------------------------------

/// 리뷰가 보이는가.
enum ReviewStatus {
  PUBLISHED
  /// 신고 처리로 관리자가 가렸다 (TASK-0091). 쓴 사람에게는 여전히 보인다.
  HIDDEN
  /// 쓴 사람이 지웠다. **되돌릴 수 없고, 다시 쓸 수도 없다.**
  ///
  /// 행을 지우지 않는 이유는 둘이다. 신고가 이 행을 가리키고 있을 수 있고
  /// (TASK-0091), 지웠다 다시 쓰는 길을 열면 「좋은 리뷰를 쓰고 혜택을 받은 뒤
  /// 지우고 나쁜 리뷰를 쓴다」가 가능해진다 — 수정 기한이 막으려는 것과 같은
  /// 조작이다. 마음이 바뀌었으면 기한 안에 **고쳐 쓴다.**
  DELETED
}

/// 구매한 주문 항목 하나에 대한 리뷰.
model Review {
  id String @id @default(uuid(7)) @db.Uuid

  /// **이 한 칸이 구매 검증이다** (F1 · F2).
  ///
  /// 유니크라 같은 항목에 두 번 쓸 수 없고, 필수 외래키라 사지 않은 사람은 가리킬
  /// 행이 없다. 애플리케이션이 「주문했는가」를 묻지 않는 이유가 이것이다 — 묻는
  /// 코드는 우회 경로가 생기면 뚫리지만, 없는 행은 어떤 경로로도 만들 수 없다.
  orderItemId String @unique @db.Uuid

  /// 어느 상품의 리뷰인가.
  ///
  /// 주문 항목에서 조인으로 알 수 있지만 적어 둔다 — 상품 상세가 읽는 축이 이것이고,
  /// 조인으로 두면 「이 상품의 리뷰」가 매번 세 표를 지난다. 거짓이 될 수 없는 것은
  /// `Review_orderItem_product_fkey` 가 `(orderItemId, productId)` 를
  /// `OrderItem(id, productId)` 로 요구하기 때문이다.
  productId String @db.Uuid

  /// 쓴 사람. `orderItemId` 로도 되짚을 수 있지만 「내가 쓴 리뷰」가 읽는 축이다.
  userId String @db.Uuid

  /// 1~5. 정수인 것은 이 스키마에 부동소수 컬럼이 없기 때문이고, 평균이 소수인
  /// 것은 `Product.ratingAvg` 가 **100배 정수**로 받는다 (TASK-0084).
  rating Int

  content String

  status ReviewStatus @default(PUBLISHED)

  /// **도움이 됐다고 누른 사람의 수** (TASK-0084).
  ///
  /// `ReviewHelpful` 을 매번 세지 않는 이유는 「도움순」 정렬이 이 값을 축으로
  /// 쓰기 때문이다 — 세는 정렬은 목록 한 장에 상관 부질의를 리뷰 수만큼 만든다.
  /// 캐시라 어긋날 수 있고, 그 마지막 방어선이 `Review_helpfulCount_check` 다.
  helpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 주문 항목은 지워지지 않는다. 데모 정리는 리뷰를 **함께** 지운다 (R1).
  orderItem OrderItem @relation(fields: [orderItemId, productId], references: [id, productId], onDelete: Restrict)
  /// `Restrict`: 리뷰가 가리키는 상품은 지워지지 않는다 — 상품 삭제는 소프트 삭제다.
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// `Restrict`: 탈퇴해도 계정 행은 툼스톤으로 남으므로 끊기지 않는다.
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  images    ReviewImage[]
  helpfuls  ReviewHelpful[]
  /// 판매자의 답변 (TASK-0085). **리뷰당 하나** — 열쇠가 리뷰의 id 그 자체다.
  reply     ReviewReply?

  /// 1:1 을 정의하는 쪽이 유니크여야 한다는 Prisma 의 요구. `orderItemId` 만으로도
  /// 이미 유니크이므로 이 줄이 더 막는 것은 없다 — **복합 외래키를 쓰기 위한 형식**이다.
  @@unique([orderItemId, productId])
  /// 상품 상세의 리뷰 목록: 이 상품의 보이는 리뷰를 최신순으로.
  @@index([productId, status, id(sort: Desc)])
  /// 「내가 쓴 리뷰」.
  @@index([userId, id(sort: Desc)])
  /// 「도움순」 정렬의 축 (TASK-0084). 커서가 `(도움 수, id)` 두 칸을 굳힌다.
  @@index([productId, status, helpfulCount(sort: Desc), id(sort: Desc)])
  /// 「평점순」 정렬의 축.
  @@index([productId, status, rating(sort: Desc), id(sort: Desc)])
}

/// 리뷰에 붙은 사진.
model ReviewImage {
  id       String @id @default(uuid(7)) @db.Uuid
  reviewId String @db.Uuid

  /// `reviews/{userId}/{objectId}.{ext}`.
  ///
  /// 접두어가 **쓴 사람**인 것은 반품 사진과 같은 이유다 (`uploads.ts`) — 사진은
  /// 리뷰를 만들기 전에 올라가므로 열쇠가 리뷰를 가리킬 수 없고, 열쇠 하나만 보고
  /// 누구 것인지 말할 수 있어야 남의 사진을 자기 리뷰에 붙이는 요청이 조용히
  /// 통과하지 않는다.
  key String

  /// 화면에 그려지는 순서. 사람이 고른 순서이지 업로드된 순서가 아니다.
  position Int

  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// 같은 사진을 두 번 붙일 수 없다.
  @@unique([reviewId, key])
  /// 같은 자리에 두 장이 올 수 없다 — 순서가 정해지지 않으면 화면마다 달라진다.
  @@unique([reviewId, position])
}

/// 리뷰가 도움이 됐다고 누른 기록 (TASK-0084).
///
/// **한 사람이 한 리뷰에 한 번**이고, 그것을 복합 기본키가 만든다. 따로 id 를 두지
/// 않는 이유는 이 행이 가리키는 것이 곧 그 두 값이기 때문이다 — 「누가 무엇에
/// 눌렀나」 말고 이 표에 다른 사실이 없다.
model ReviewHelpful {
  reviewId String @db.Uuid
  userId   String @db.Uuid

  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /// `Restrict`: 탈퇴해도 계정 행은 툼스톤으로 남으므로 끊기지 않는다.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([reviewId, userId])
  /// 「내가 누른 것들」 — 화면이 이미 누른 버튼을 눌린 상태로 그린다.
  @@index([userId])
}

/// 리뷰에 대한 판매자의 답변 (TASK-0085).
///
/// **리뷰당 하나**이고, 그것을 기본키가 만든다 — `reviewId` 자체가 열쇠라 두 번째
/// 답변은 저장될 자리가 없다. 「두 번 쓰면 400」과 「두 번 쓰면 수정」 중 무엇을
/// 고르든 그 판단이 애플리케이션에 있으면 우회 경로가 생기는 날 뚫린다.
///
/// **수정 이력을 남기지 않는다** (4장). 판매자 응대는 개선이 목적이지 기록 보존이
/// 목적이 아니다 — 리뷰 쪽에 수정 기한이 있는 것과 반대인데, 저쪽은 남의 판단을
/// 바꾸는 일이고 이쪽은 자기 말을 고치는 일이기 때문이다.
model ReviewReply {
  reviewId String @id @db.Uuid

  /// 어느 스토어가 답했나. **소유권 검사가 읽는 값**이고, 리뷰에서 상품을 거쳐
  /// 되짚을 수 있지만 그러면 답변 목록이 매번 세 표를 지난다.
  sellerId String @db.Uuid

  /// 누가 썼나. 스토어에 직원이 생기는 날(TASK-0105 2) 이 값이 필요해진다.
  authorId String @db.Uuid

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /// `Restrict`: 답변이 가리키는 스토어는 지워지지 않는다.
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  /// `Restrict`: 탈퇴해도 계정 행은 툼스톤으로 남으므로 끊기지 않는다.
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// 「이 스토어의 답변들」 — 관리 화면이 읽는다.
  @@index([sellerId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// 회원 부가 기능 — 찜 · 최근 본 상품 · 팔로우 (TASK-0086 · 0087 · 0089)
//
// 셋 다 「사람이 무엇을 가리킨다」 하나뿐인 표이고, 그래서 **복합 기본키**를 쓴다.
// 따로 id 를 두면 같은 짝이 두 번 들어올 수 있고, 그것을 막는 유니크가 다시
// 필요해진다 — 열쇠가 곧 그 사실이면 막을 것이 없다.
// ---------------------------------------------------------------------------

/// 찜 (TASK-0086).
model Wishlist {
  userId    String @db.Uuid
  productId String @db.Uuid

  /// 담을 때의 최저가.
  ///
  /// **가격 변동을 보여 주려면 그때의 값이 있어야 한다** (F5). 지금 값만 알면
  /// 「내렸다」를 말할 수 없고, 상품의 가격 이력을 뒤지는 것은 찜 목록 한 장에
  /// 상품마다 조회를 더하는 일이다.
  ///
  /// `NULL` 은 담을 때 팔 수 있는 조합이 하나도 없었다는 뜻이다 — `Product.minPrice`
  /// 가 그때 비어 있었다.
  addedPrice Int?

  /**
   * 재입고되면 알려 달라고 신청했는가 (TASK-0086 F4).
   *
   * 찜과 나누는 이유는 **두 개의 다른 마음**이기 때문이다 — 담아 두는 것은 「나중에
   * 살까」이고 알림 신청은 「지금 사고 싶은데 없다」다. 담은 것 전부에 재입고 알림을
   * 보내면 그것은 신청하지 않은 알림이 된다.
   *
   * 보낸 뒤에는 **꺼진다.** 한 번 알린 재입고를 다시 알릴 이유가 없고, 또 품절이
   * 되면 사람이 다시 신청한다.
   */
  notifyRestock Boolean @default(false)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `Restrict`: 찜이 가리키는 상품은 지워지지 않는다 — 상품 삭제는 소프트 삭제다.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([userId, productId])
  /// 「내 찜 목록」 — 최근에 담은 것부터.
  @@index([userId, createdAt(sort: Desc)])
  /// 재입고 알림을 기다리는 줄들 — 그 배치가 읽는 유일한 축이다.
  @@index([notifyRestock, productId])
}

/// 최근 본 상품 (TASK-0087).
model RecentlyViewed {
  userId    String @db.Uuid
  productId String @db.Uuid

  /// 마지막으로 본 시각. **같은 상품을 열 번 봐도 행은 하나**다.
  viewedAt DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([userId, productId])
  /// 「최근 본 상품」과 **정리 대상 찾기**가 같은 인덱스를 쓴다.
  @@index([userId, viewedAt(sort: Desc)])
}

/// 브랜드 팔로우 (TASK-0089).
model SellerFollow {
  userId   String @db.Uuid
  sellerId String @db.Uuid

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `Restrict`: 팔로우가 가리키는 스토어는 지워지지 않는다 — 만료는 정지이지 삭제가 아니다.
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@id([userId, sellerId])
  /// 「내가 팔로우한 브랜드」.
  @@index([userId, createdAt(sort: Desc)])
  /// 「이 브랜드의 팔로워」 — 신상품 알림이 읽는다 (TASK-0090).
  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// 상품 문의 (TASK-0088)
//
// **비공개 문의의 접근 제어는 API 가 한다** (4장). 목록은 조건으로 거르고 상세는
// 다시 확인한다 — 화면에서 숨기는 방식은 응답에 이미 실려 나간 것을 가리는 일이라
// 개발자 도구 하나로 뚫린다.
// ---------------------------------------------------------------------------

/// 상품에 대한 문의.
model ProductQuestion {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid
  userId    String @db.Uuid

  content String

  /// 공개 문의인가.
  ///
  /// 기본값이 **공개**인 이유는 문의가 상품 정보의 일부이기 때문이다 — 같은 것을
  /// 궁금해하는 다음 사람이 읽는다. 비공개는 고르는 것이지 기본이 아니다.
  isPublic Boolean @default(true)

  /// 신고로 가려진 시각 (TASK-0091). `NULL` 이면 보인다.
  ///
  /// 상태 열거형이 아니라 시각인 이유는 **언제 가려졌나가 답이어야 하는 질문**이기
  /// 때문이다 — 「가려짐」이라는 상태만 있으면 자동 임시 숨김과 관리자 확정 숨김을
  /// 구분할 수 없고, 그 구분은 신고 쪽의 상태가 들고 있다.
  hiddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 문의가 가리키는 상품은 지워지지 않는다 — 상품 삭제는 소프트 삭제다.
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// `Restrict`: 탈퇴해도 계정 행은 툼스톤으로 남으므로 끊기지 않는다.
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  answer  ProductAnswer?

  /// 상품 상세의 문의 목록: 이 상품의 것을 최신순으로.
  @@index([productId, id(sort: Desc)])
  /// 「내 문의」.
  @@index([userId, id(sort: Desc)])
}

/// 문의에 대한 판매자의 답변.
///
/// **문의당 하나**이고, 그것을 기본키가 만든다 — 리뷰 답변과 같은 판단이다
/// (`ReviewReply`).
model ProductAnswer {
  questionId String @id @db.Uuid

  /// 어느 스토어가 답했나. 소유권 검사가 읽는 값이다.
  sellerId String @db.Uuid
  authorId String @db.Uuid

  content String

  /// 신고로 가려진 시각 (TASK-0091). `NULL` 이면 보인다.
  hiddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// 알림 (TASK-0090)
//
// **알림 생성이 원래 작업을 지연시키지 않는다** (F6). 주문 상태 변경 트랜잭션에 알림
// 생성이 끼면 실패 지점이 늘어나고, 그 실패는 「배송 처리가 안 됐다」로 나타난다 —
// 알림을 못 받는 것과 물건이 안 가는 것은 다른 일이다.
//
// 실시간 푸시는 없다. 30초 폴링으로 충분하다는 것이 4장의 판단이고, 그래서 이 표에
// 「전달됨」 같은 칸이 없다 — 읽었는가만 있다.
// ---------------------------------------------------------------------------

/// 무엇에 대한 알림인가.
///
/// **받는 사람의 역할이 유형에 묻어 있다.** `SELLER_` 로 시작하는 것은 판매자가,
/// `ADMIN_` 은 관리자가 받는다 — 한 표에 담기지만 읽는 화면이 다르고, 그 구분을
/// 유형에 두면 목록 질의가 역할을 몰라도 된다.
enum NotificationType {
  /// 주문의 상태가 바뀌었다 (발송 · 배송완료 · 취소).
  ORDER_STATUS
  /// 취소·반품 신청이 처리됐다.
  CLAIM_STATUS
  /// 내 리뷰에 판매자가 답했다.
  REVIEW_REPLY
  /// 내 문의에 판매자가 답했다.
  QUESTION_ANSWER
  /// 찜한 상품이 다시 들어왔다.
  RESTOCK
  /// 팔로우한 브랜드가 새 상품을 냈다.
  NEW_PRODUCT
  /// 정산서가 승인·지급됐다 (판매자).
  SELLER_SETTLEMENT
  /// 새 주문이 들어왔다 (판매자).
  SELLER_ORDER
  /// 새 클레임이 들어왔다 (판매자).
  SELLER_CLAIM
  /// 입점 신청이 들어왔다 (관리자).
  ADMIN_SELLER_APPLICATION
  /// 내가 낸 신고가 처리됐다 (TASK-0091).
  REPORT_HANDLED
}

/// 앱 안에서 읽는 알림 하나.
model Notification {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid

  type NotificationType

  title String
  body  String

  /// 눌렀을 때 갈 곳 — **앱 안의 경로**다 (`/mypage/orders/…`).
  ///
  /// 전체 주소가 아닌 이유는 알림을 읽는 앱이 셋이고 각자 자기 도메인에서 열기
  /// 때문이다. 도메인을 여기 적으면 배포마다 달라지는 값이 데이터에 굳는다.
  link String?

  /// 읽은 시각. `NULL` 이면 안 읽었다 — 배지가 세는 것이 이것이다.
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 알림함과 **미읽음 배지**가 같은 인덱스를 쓴다. `readAt` 이 가운데인 것은
  /// 배지가 「안 읽은 것」만 세기 때문이다.
  @@index([userId, readAt, id(sort: Desc)])
  /// 오래된 알림 정리 배치가 읽는다.
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 신고 (TASK-0091)
//
// **자동 임시 숨김이 이 표의 존재 이유다.** 관리자가 즉시 대응할 수 없는 시간대에
// 악성 콘텐츠가 노출된 채 남는 것을 막는다 — 임계치를 넘으면 일단 가리고, 반려하면
// 복구된다. 그래서 「가려진 이유」가 신고 수에 있고, 그것을 세려면 신고가 행이어야
// 한다.
// ---------------------------------------------------------------------------

/// 무엇을 신고했나.
///
/// 대상마다 표가 달라서 **외래키를 걸 수 없다.** 그 대가로 `targetId` 가 가리키는
/// 행이 사라져도 신고가 남을 수 있는데, 대상들이 전부 소프트 삭제라 실제로는
/// 사라지지 않는다 — 리뷰는 `DELETED` 로 남고 상품도 소프트 삭제다.
enum ReportTargetType {
  REVIEW
  QUESTION
  ANSWER
  PRODUCT
}

/// 왜 신고했나. 목록을 고정하는 이유는 자유 입력이 분류를 불가능하게 만들기 때문이다.
enum ReportReason {
  /// 욕설 · 혐오 · 성적 표현.
  ABUSE
  /// 광고 · 도배.
  SPAM
  /// 사실과 다른 내용.
  FALSE_INFO
  /// 개인정보가 드러남.
  PRIVACY
  /// 위 어디에도 없음. `detail` 이 필수가 된다.
  OTHER
}

/// 신고가 지나는 상태.
enum ReportStatus {
  /// 접수됐고 아직 아무도 보지 않았다.
  PENDING
  /// 관리자가 가렸다. 대상이 안 보인다.
  HIDDEN
  /// 관리자가 지웠다. 되돌릴 수 없다.
  REMOVED
  /// 관리자가 반려했다. **임시 숨김이 풀린다.**
  REJECTED
}

/// 신고 하나.
model Report {
  id String @id @default(uuid(7)) @db.Uuid

  targetType ReportTargetType
  /// 대상의 id. 표가 달라 외래키를 걸 수 없다 — 위 열거형의 주석에 그 대가가 있다.
  targetId   String           @db.Uuid

  reporterId String       @db.Uuid
  reason     ReportReason
  /// `OTHER` 일 때 필수. `Report_detail_check` 가 강제한다.
  detail     String?

  status ReportStatus @default(PENDING)

  /// 누가 언제 어떻게 처리했나 (F6). 반려도 처리다 — 「아무 일도 없었다」가 아니라
  /// 「보고 아니라고 판단했다」이고, 그 판단에도 사람과 시각이 있다.
  handledById String?   @db.Uuid
  handledAt   DateTime?
  /// 처리 사유. 신고자에게 가는 알림이 이 문장을 싣는다.
  handledNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Restrict`: 탈퇴해도 계정 행은 툼스톤으로 남으므로 끊기지 않는다.
  reporter  User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: Restrict)

  /// **같은 사람이 같은 대상을 두 번 신고할 수 없다** (F2). 막지 않으면 한 사람이
  /// 임계치를 혼자 채운다.
  @@unique([targetType, targetId, reporterId])
  /// 관리자 목록: 처리 대기부터.
  @@index([status, id(sort: Desc)])
  /// **이 대상이 몇 번 신고됐나** — 임시 숨김의 임계치가 세는 값이다.
  @@index([targetType, targetId, status])
}
